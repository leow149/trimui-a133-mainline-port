@@ -805,6 +836,7 @@ bool pco_nir_pfo(nir_shader *shader, pco_fs_data *fs)
 
    struct pfo_state state = {
       .fs = fs,
+      .may_discard = shader_may_discard(shader),
    };
 
    state.loads = UTIL_DYNARRAY_INIT;
@@ -815,7 +847,7 @@ bool pco_nir_pfo(nir_shader *shader, pco_fs_data *fs)
    /* TODO: instead of doing multiple passes, probably better to just cache all
