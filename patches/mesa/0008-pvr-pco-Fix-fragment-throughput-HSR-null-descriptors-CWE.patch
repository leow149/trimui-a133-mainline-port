    return progress;
 }
 
-static inline bool only_uncollated_elems(pco_instr *vec)
-{
-   pco_foreach_instr_src (psrc, vec) {
-      if (pco_ref_get_chans(*psrc) > 1)
-         return false;
-   }
-
-   return true;
-}
-
 /**
  * \brief Shrinks vectors with unused components.
  *
@@ -704,10 +694,6 @@ bool pco_shrink_vecs(pco_shader *shader)
          if (vec->op != PCO_OP_VEC)
             continue;
 
-         /* Can't shrink if has collated elems. */
-         if (!only_uncollated_elems(vec))
-            continue;
-
          pco_ref *pdest = &vec->dest[0];
          unsigned chans_used = 0;
          unsigned chans = pco_ref_get_chans(*pdest);
@@ -736,13 +722,28 @@ bool pco_shrink_vecs(pco_shader *shader)
          ++chans_used;
          assert(chans_used <= chans);
 
+         /* Keep whole sources up to the last used channel; collated (multi-
+          * channel) sources are kept or dropped as a whole, so the offsets
+          * of the remaining channels don't change. This drops e.g. the
+          * padding of sample instruction data.
+          */
+         unsigned kept_chans = 0;
+         unsigned kept_srcs = 0;
+         pco_foreach_instr_src (psrc, vec) {
+            if (kept_chans >= chans_used)
+               break;
+
+            kept_chans += pco_ref_get_chans(*psrc);
+            ++kept_srcs;
+         }
+
          /* Whole vec used, skip. */
-         if (chans_used == chans)
+         if (kept_chans == chans)
             continue;
 
          /* Update the vec. */
-         vec->num_srcs = chans_used;
-         *pdest = pco_ref_chans(*pdest, chans_used);
+         vec->num_srcs = kept_srcs;
+         *pdest = pco_ref_chans(*pdest, kept_chans);
 
          progress = true;
       }
