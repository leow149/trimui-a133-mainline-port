     */
-   if (!shader->info.internal) {
+   if (!shader->info.internal && !fs->uses.alpha_to_one_skip) {
       progress |= nir_shader_intrinsics_pass(shader,
                                              lower_alpha_to_one,
                                              nir_metadata_control_flow,
diff --git a/src/imagination/pco/pco_opt.c b/src/imagination/pco/pco_opt.c
