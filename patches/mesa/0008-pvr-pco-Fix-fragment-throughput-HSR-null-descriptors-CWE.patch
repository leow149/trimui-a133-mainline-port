diff --git a/src/imagination/pco/pco_nir_lower_null_descriptors.c b/src/imagination/pco/pco_nir_lower_null_descriptors.c
index 0b0a3d1..157ce28 100644
--- a/src/imagination/pco/pco_nir_lower_null_descriptors.c
+++ b/src/imagination/pco/pco_nir_lower_null_descriptors.c
@@ -10,6 +10,40 @@
 #include "compiler/nir/nir_builder.h"
 #include "pco_internal.h"
 
+/* Sampling through a null combined image sampler reads the device's 1x1
+ * zero texture with clamp-to-edge addressing, which already returns zero.
+ * Queries, fetches, shadow compares and separate images keep the check.
+ */
+static bool tex_reads_null_texel(nir_tex_instr *tex, nir_def *tex_deref_def)
+{
+   switch (tex->op) {
+   case nir_texop_tex:
+   case nir_texop_txb:
+   case nir_texop_txl:
+   case nir_texop_txd:
+   case nir_texop_tg4:
+      break;
+   default:
+      return false;
+   }
+
+   if (nir_tex_instr_src_index(tex, nir_tex_src_comparator) >= 0)
+      return false;
+
+   nir_deref_instr *tex_deref = nir_instr_as_deref(nir_def_instr(tex_deref_def));
+   nir_def *smp_deref_def = nir_get_tex_src(tex, nir_tex_src_sampler_deref);
+   if (!smp_deref_def)
+      return false;
+
+   nir_deref_instr *smp_deref = nir_instr_as_deref(nir_def_instr(smp_deref_def));
+   nir_variable *tex_var = nir_deref_instr_get_variable(tex_deref);
+   nir_variable *smp_var = nir_deref_instr_get_variable(smp_deref);
+
+   /* Combined image sampler: both derefs name the same sampler variable. */
+   return tex_var && tex_var == smp_var &&
+          glsl_type_is_sampler(glsl_without_array(tex_var->type));
+}
+
 static nir_def *get_is_null(nir_builder *b,
                             nir_instr *instr,
                             nir_def **def,
@@ -36,10 +70,8 @@ static nir_def *get_is_null(nir_builder *b,
 
       case nir_intrinsic_get_ubo_size:
       case nir_intrinsic_load_ubo:
-         if (!(options & pco_nir_lower_null_descriptor_ubo))
-            return NULL;
-
-         break;
+         /* Null UBO descriptors point at the zero page with size 0. */
+         return NULL;
 
       case nir_intrinsic_get_ssbo_size:
       case nir_intrinsic_load_ssbo:
@@ -74,6 +106,9 @@ static nir_def *get_is_null(nir_builder *b,
       if (!deref_def)
          return NULL;
 
+      if (tex_reads_null_texel(tex, deref_def))
+         return NULL;
+
       *def = &tex->def;
       return nir_is_null_descriptor(b, deref_def);
    }
diff --git a/src/imagination/pco/pco_nir_pvfio.c b/src/imagination/pco/pco_nir_pvfio.c
index e28d2b0..540e4cd 100644
--- a/src/imagination/pco/pco_nir_pvfio.c
+++ b/src/imagination/pco/pco_nir_pvfio.c
@@ -36,8 +36,35 @@ struct pfo_state {
    nir_def *depth_feedback_src;
 
    pco_fs_data *fs; /** Fragment-specific data. */
+
+   bool may_discard; /** Whether the shader contains a demote/terminate. */
 };
 
+static bool shader_may_discard(nir_shader *shader)
+{
+   nir_foreach_function_impl (impl, shader) {
+      nir_foreach_block (block, impl) {
+         nir_foreach_instr (instr, block) {
+            if (instr->type != nir_instr_type_intrinsic)
+               continue;
+
+            switch (nir_instr_as_intrinsic(instr)->intrinsic) {
+            case nir_intrinsic_demote:
+            case nir_intrinsic_demote_if:
+            case nir_intrinsic_demote_samples:
+            case nir_intrinsic_terminate:
+            case nir_intrinsic_terminate_if:
+               return true;
+            default:
+               break;
+            }
+         }
+      }
+   }
+
+   return false;
+}
+
 /** Per-vertex input pass state. */
 struct pvi_state {
    nir_def *attribs[MAX_VERTEX_GENERIC_ATTRIBS]; /** Loaded vertex attribs. */
@@ -500,11 +527,11 @@ static bool lower_sample_mask_out(nir_builder *b, nir_intrinsic_instr *intr, UNU
    return true;
 }
 
-bool pco_nir_lower_sample_mask_out(nir_shader *shader)
+bool pco_nir_lower_sample_mask_out(nir_shader *shader, bool insert_check)
 {
    bool progress = nir_shader_intrinsics_pass(shader, lower_sample_mask_out, nir_metadata_control_flow, NULL);
-   if (progress)
-      return true;
+   if (progress || !insert_check)
