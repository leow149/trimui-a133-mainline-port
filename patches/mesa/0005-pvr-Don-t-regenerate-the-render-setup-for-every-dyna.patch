+/* Bounds the memory held by each table of the cache. When a table is full,
+ * the least recently used entry that nothing holds a reference to is evicted.
+ */
+#define PVR_PROG_CACHE_MAX_ENTRIES 256U
+
+struct pvr_prog_cache_key {
+   uint32_t size;
+   const void *data;
+};
+
+/* Header of each cached payload; the payload follows it. */
+struct pvr_prog_cache_entry {
+   struct pvr_prog_cache_key *key;
+   uint32_t refs;
+   uint64_t last_use;
+   uint64_t pad;
+};
+
+static struct pvr_prog_cache_entry *pvr_prog_cache_entry(const void *payload)
+{
+   return (struct pvr_prog_cache_entry *)payload - 1;
+}
+
+static uint32_t pvr_prog_cache_key_hash(const void *key)
+{
+   const struct pvr_prog_cache_key *k = key;
+
+   return _mesa_hash_data(k->data, k->size);
+}
+
+static bool pvr_prog_cache_key_equal(const void *a, const void *b)
+{
+   const struct pvr_prog_cache_key *ka = a;
+   const struct pvr_prog_cache_key *kb = b;
+
+   return ka->size == kb->size && !memcmp(ka->data, kb->data, ka->size);
+}
+
+uint32_t pvr_eot_cache_key(const struct pvr_eot_props *props,
+                           uint32_t kind,
+                           uint32_t key[static PVR_EOT_CACHE_KEY_MAX_DWORDS])
+{
+   uint32_t n = 0;
+
+   assert(!props->shared_words);
+   assert(props->emit_count <= PVR_MAX_COLOR_ATTACHMENTS);
+
+   key[n++] = kind;
+   key[n++] = props->emit_count;
+   key[n++] = props->num_output_regs;
+   key[n++] = props->msaa_samples;
+   for (unsigned u = 0; u < props->emit_count * ROGUE_NUM_PBESTATE_STATE_WORDS;
+        ++u) {
+      key[n++] = props->state_words[u];
+   }
+   for (unsigned u = 0; u < props->emit_count; ++u) {
+      key[n++] = props->tile_buffer_addrs[u];
+      key[n++] = props->tile_buffer_addrs[u] >> 32;
+   }
+
+   return n * sizeof(*key);
+}
+
+void pvr_device_prog_cache_init(struct pvr_device *device)
+{
+   simple_mtx_init(&device->prog_cache.mtx, mtx_plain);
+   device->prog_cache.load_ops = NULL;
+   device->prog_cache.eots = NULL;
+   device->prog_cache.render_targets = NULL;
+}
+
+static void pvr_prog_cache_free_payload(struct pvr_device *device,
+                                        const struct hash_table *table,
+                                        void *payload)
+{
+   if (table == device->prog_cache.load_ops) {
+      struct pvr_load_op_progs *progs = payload;
+
+      pvr_bo_suballoc_free(progs->pds_tex_state_prog.pvr_bo);
+      pvr_bo_suballoc_free(progs->pds_frag_prog.pvr_bo);
+      pvr_bo_suballoc_free(progs->usc_frag_prog_bo);
+   } else if (table == device->prog_cache.eots) {
+      struct pvr_eot_prog *prog = payload;
+
+      pvr_bo_suballoc_free(prog->usc_bo);
+   } else {
+      struct pvr_cached_render_targets *rts = payload;
+
+      assert(table == device->prog_cache.render_targets);
+      pvr_render_targets_fini(rts->render_targets, rts->count);
+      vk_free(&device->vk.alloc, rts->render_targets);
+   }
+}
+
+static void pvr_prog_cache_table_destroy(struct pvr_device *device,
+                                         struct hash_table *table)
+{
+   if (!table)
+      return;
+
+   hash_table_foreach (table, entry) {
+      struct pvr_prog_cache_entry *e = entry->data;
+
+      assert(!e->refs);
+      pvr_prog_cache_free_payload(device, table, e + 1);
+      vk_free(&device->vk.alloc, e->key);
+      vk_free(&device->vk.alloc, e);
+   }
+   _mesa_hash_table_destroy(table, NULL);
+}
+
+void pvr_device_prog_cache_finish(struct pvr_device *device)
+{
+   simple_mtx_destroy(&device->prog_cache.mtx);
+
+   pvr_prog_cache_table_destroy(device, device->prog_cache.load_ops);
+   pvr_prog_cache_table_destroy(device, device->prog_cache.eots);
+   pvr_prog_cache_table_destroy(device, device->prog_cache.render_targets);
+}
+
+/* Evicts the least recently used unreferenced entry; false if there is none. */
+static bool pvr_prog_cache_evict(struct pvr_device *device,
+                                 struct hash_table *table)
+{
+   struct hash_entry *victim = NULL;
+
+   hash_table_foreach (table, entry) {
+      const struct pvr_prog_cache_entry *e = entry->data;
+
+      if (e->refs)
+         continue;
+      if (!victim ||
+          e->last_use <
+             ((const struct pvr_prog_cache_entry *)victim->data)->last_use) {
+         victim = entry;
+      }
+   }
+
+   if (!victim)
+      return false;
+
+   struct pvr_prog_cache_entry *e = victim->data;
+
+   _mesa_hash_table_remove(table, victim);
+   pvr_prog_cache_free_payload(device, table, e + 1);
+   vk_free(&device->vk.alloc, e->key);
+   vk_free(&device->vk.alloc, e);
+
+   return true;
+}
+
+void pvr_device_prog_cache_put(const struct pvr_device *device,
+                               const void *payload)
+{
+   simple_mtx_t *mtx = (simple_mtx_t *)&device->prog_cache.mtx;
+
+   simple_mtx_lock(mtx);
+   assert(pvr_prog_cache_entry(payload)->refs);
+   pvr_prog_cache_entry(payload)->refs--;
+   simple_mtx_unlock(mtx);
+}
+
+const void *pvr_device_prog_cache_lookup(struct pvr_device *device,
+                                         struct hash_table *table,
+                                         const void *key,
+                                         uint32_t key_size)
+{
+   const struct pvr_prog_cache_key k = { .size = key_size, .data = key };
+   struct pvr_prog_cache_entry *e;
+   struct hash_entry *entry;
+
+   if (!table)
+      return NULL;
+
+   entry = _mesa_hash_table_search(table, &k);
+   if (!entry)
+      return NULL;
+
+   e = entry->data;
+   e->refs++;
+   e->last_use = ++device->prog_cache.clock;
+
+   return e + 1;
+}
+
+const void *pvr_device_prog_cache_insert(struct pvr_device *device,
+                                         struct hash_table **table,
+                                         const void *key,
+                                         uint32_t key_size,
+                                         const void *progs,
+                                         size_t progs_size)
+{
+   struct pvr_prog_cache_entry *e;
+   struct pvr_prog_cache_key *k;
+
+   if (!*table) {
+      *table = _mesa_hash_table_create(NULL,
+                                       pvr_prog_cache_key_hash,
+                                       pvr_prog_cache_key_equal);
+      if (!*table)
+         return NULL;
+   }
+
+   if ((*table)->entries >= PVR_PROG_CACHE_MAX_ENTRIES &&
+       !pvr_prog_cache_evict(device, *table)) {
+      return NULL;
+   }
+
+   k = vk_alloc(&device->vk.alloc,
+                sizeof(*k) + key_size,
+                8,
+                VK_SYSTEM_ALLOCATION_SCOPE_DEVICE);
+   e = vk_alloc(&device->vk.alloc,
+                sizeof(*e) + progs_size,
+                8,
+                VK_SYSTEM_ALLOCATION_SCOPE_DEVICE);
+   if (!k || !e) {
+      vk_free(&device->vk.alloc, k);
+      vk_free(&device->vk.alloc, e);
+      return NULL;
+   }
+
+   /* The key data is stored right after the key. */
+   k->size = key_size;
+   k->data = memcpy(k + 1, key, key_size);
+   e->key = k;
+   e->refs = 1;
+   e->last_use = ++device->prog_cache.clock;
+   memcpy(e + 1, progs, progs_size);
+
+   if (!_mesa_hash_table_insert(*table, k, e)) {
+      vk_free(&device->vk.alloc, k);
+      vk_free(&device->vk.alloc, e);
+      return NULL;
+   }
+
+   return e + 1;
+}
