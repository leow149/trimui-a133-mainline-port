diff --git a/arch/arm/dts/sun50i-a133-trimui-smartpro.dts b/arch/arm/dts/sun50i-a133-trimui-smartpro.dts
new file mode 100644
index 00000000..eff82374
--- /dev/null
+++ b/arch/arm/dts/sun50i-a133-trimui-smartpro.dts
@@ -0,0 +1,216 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * TrimUI Smart Pro (Allwinner A133).
+ *
+ * The U-Boot copy of the board DT: only what the boot loader needs (UARTs,
+ * MMC, PMIC, USB). The full board description, including the buttons, Wi-Fi,
+ * Bluetooth, display and GPU, is the Linux DT
+ * (arch/arm64/boot/dts/allwinner/sun50i-a133-trimui-smartpro.dts in the
+ * kernel series). This file is a local, reduced copy and is to be dropped
+ * in favour of the upstream one once that is merged in Linux and synced
+ * into dts/upstream.
+ */
+
+/dts-v1/;
+
+#include "sun50i-a100.dtsi"
+#include "sun50i-a100-cpu-opp.dtsi"
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/linux-event-codes.h>
+#include <dt-bindings/leds/common.h>
+
+/ {
+	model = "TrimUI Smart Pro";
+	chassis-type = "handset";
+	/* The "trimui" vendor prefix is registered by the Linux DT series. */
+	compatible = "trimui,smart-pro", "allwinner,sun50i-a100";
+
+	aliases {
+		/*
+		 * The WiFi (only described in the kernel DT): makes U-Boot
+		 * derive ethaddr from the SID and set it as the kernel DT's
+		 * local-mac-address, so the MAC stays the same across boots.
+		 * Only needed while this reduced DT is used: the upstream DT
+		 * carries the alias as a label reference.
+		 */
+		ethernet0 = "/soc/mmc@4021000/wifi@1";
+		serial0 = &uart0;
+	};
+
+	chosen {
+		/* Same console as the vendor boot.img kernel command line. */
+		stdout-path = "serial0:115200n8";
+	};
+
+	battery: battery {
+		compatible = "simple-battery";
+		/* Vendor DTB: pmu_battery_rdc = 0x93, pmu_battery_cap = 0x1388 (5000 mAh). */
+		voltage-max-design-microvolt = <4200000>;
+	};
+
+	reg_vcc5v: regulator-vcc5v {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc-5v";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		regulator-always-on;
+	};
+};
+
+&cpu0 {
+	cpu-supply = <&reg_dcdc1>;
+};
+
+&mmc0 {
+	/*
+	 * SD card slot. No cd-gpios are described, so card insertion is not
+	 * detected after boot. vmmc-supply is the general 3.3 V IO rail, as
+	 * for mmc2; no source ties it to this slot specifically.
+	 */
+	bus-width = <4>;
+	vmmc-supply = <&reg_cldo3>;
+	status = "okay";
+};
+
+&mmc2 {
+	/*
+	 * eMMC. The vendor kernel strips the HS200/HS400 capabilities at
+	 * runtime and the boot log shows DDR52, so only DDR is described.
+	 * vmmc-supply is the general 3.3 V IO rail, as for mmc0; no source
+	 * ties it to this slot specifically.
+	 */
+	bus-width = <8>;
+	non-removable;
+	cap-mmc-hw-reset;
+	mmc-ddr-1_8v;
+	vmmc-supply = <&reg_cldo3>;
+	status = "okay";
+};
+
+&r_i2c0 {
+	status = "okay";
+
+	axp717: pmic@34 {
+		compatible = "x-powers,axp717";
+		reg = <0x34>;
+		interrupt-controller;
+		#interrupt-cells = <1>;
+		interrupt-parent = <&r_intc>;
+		interrupts = <0 IRQ_TYPE_LEVEL_LOW>;
+
+		vin1-supply = <&reg_vcc5v>;
+		vin2-supply = <&reg_vcc5v>;
+		vin3-supply = <&reg_vcc5v>;
+		vin4-supply = <&reg_vcc5v>;
+
+		axp_adc: adc {
+			compatible = "x-powers,axp717-adc";
+			#io-channel-cells = <1>;
+		};
+
+		battery_power: battery-power {
+			compatible = "x-powers,axp717-battery-power-supply";
+			monitored-battery = <&battery>;
+			x-powers,no-thermistor;
+		};
+
+		usb_power: usb-power {
+			compatible = "x-powers,axp717-usb-power-supply";
+		};
+
+		/*
+		 * Regulator names come from the vendor DTB's "axp2202-*" node
+		 * names (the AXP2202 is the AXP717). Voltages are those printed
+		 * by the vendor U-Boot's PMIC init on the running device
+		 * ("<rail>_vol = <mV>, onoff=<0|1>"). dcdc2 is not in that log
+		 * and has no voltage here. dcdc1 (vdd-cpu) is DVFS-scaled, so
+		 * it has no fixed voltage.
+		 */
+		regulators {
+			reg_dcdc1: dcdc1 {
+				regulator-name = "vdd-cpu";
+				/* 940 mV at boot, scaled by cpufreq */
+			};
+			reg_dcdc2: dcdc2 {
+				regulator-name = "vdd-gpu-sys";
+			};
+			reg_dcdc3: dcdc3 {
+				/* Matches the boot0 log: "DRAM_VCC set to 1100 mv". */
+				regulator-always-on;
+				regulator-min-microvolt = <1100000>;
+				regulator-max-microvolt = <1100000>;
+				regulator-name = "vdd-dram";
+			};
+			reg_aldo1: aldo1 {
+				/* 1800mV, onoff=1 at boot, but kernel disables it later (unused) at boot */
+			};
+			reg_aldo2: aldo2 {
+				/* 3300mV, onoff=1 at boot */
+			};
+			reg_aldo3: aldo3 {
+				/* WiFi/BT IO rail (wlan_io_regulator), 3300 mV at boot */
+				regulator-always-on;
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-name = "vcc-wifi-io";
+			};
+			reg_aldo4: aldo4 {
+				/* 1800mV, onoff=1 at boot */
+			};
+			reg_bldo1: bldo1 {
+				/*
+				 * WiFi/BT power rail (wlan_power1), 3300 mV. Off at
+				 * boot; switched on at runtime by the WiFi/BT driver.
+				 */
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-name = "vcc-wifi";
+			};
+			reg_bldo2: bldo2 {
+				/* 1800mV, onoff=1 at boot */
+			};
+			reg_bldo3: bldo3 {
+				/* 3300mV, onoff=1 at boot */
+			};
+			reg_bldo4: bldo4 {
+				/* 1800mV at boot, kernel disables it later (unused) at boot */
+			};
+			reg_cldo1: cldo1 {
+				/* LCD panel power0 (lcd_power0 = "cldo1"), 1800 mV at boot */
+				regulator-always-on;
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-name = "vcc-lcd-1";
+			};
+			reg_cldo2: cldo2 { };
+			reg_cldo3: cldo3 {
+				/* 3300mV at boot */
+				regulator-always-on;
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-name = "vcc-io";
+			};
+			reg_cldo4: cldo4 {
+				/* LCD panel power1 (lcd_power1 = "cldo4"), 3300 mV at boot */
+				regulator-always-on;
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-name = "vcc-lcd-2";
+			};
+			reg_cpusldo: cpusldo {
+				/* 900mV, onoff=1 at boot */
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <900000>;
+				regulator-max-microvolt = <900000>;
+			};
+		};
+	};
+};
+
+&uart0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart0_pb_pins>; /* only pin group this SoC's dtsi defines; matches vendor cmdline's ttyS0 */
+	status = "okay";
+};
