From 944514d51b13a900feb3869cff8a1f0d43b89f1c Mon Sep 17 00:00:00 2001
From: leow149 <leow149@lucidmail.xyz>
Date: Sun, 22 Nov 2026 18:54:21 +0100
Subject: [PATCH 1/3] sunxi: Fix the BL31 load address on the A133

The A133 selects SUN50I_GEN_H6, so SUNXI_BL31_BASE fell through to the
H6 SRAM address 0x00104000. The TF-A platform for the A133 links BL31
into DRAM (SUNXI_BL31_IN_DRAM), so U-Boot loaded it to the wrong place
and it crashed as soon as it was entered. Use the H616 DRAM address.

This affects every A133 board, not just one: the Liontron H-A133L
defconfig does not override SUNXI_BL31_BASE either. That board was not
tested.

Assisted-by: Claude Opus 5.5
Signed-off-by: leow149 <leow149@lucidmail.xyz>
---
 arch/arm/mach-sunxi/Kconfig | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm/mach-sunxi/Kconfig b/arch/arm/mach-sunxi/Kconfig
index b0c5d3cd..b7ee14c6 100644
--- a/arch/arm/mach-sunxi/Kconfig
+++ b/arch/arm/mach-sunxi/Kconfig
@@ -267,7 +267,7 @@ config SUNXI_RVBAR_ALTERNATIVE
 config SUNXI_BL31_BASE
 	hex
 	default 0x00044000 if MACH_SUN50I || MACH_SUN50I_H5
-	default 0x40000000 if MACH_SUN50I_H616
+	default 0x40000000 if MACH_SUN50I_H616 || MACH_SUN50I_A133
 	default 0x00104000 if SUN50I_GEN_H6
 	default 0x00054000 if MACH_SUN55I_A523
 	default 0x0
