From cc6c287b3fc80c60ff60923b24ec10c5347337cf Mon Sep 17 00:00:00 2001
From: leow149 <leow149@lucidmail.xyz>
Date: Mon, 2 Nov 2026 09:12:26 +0100
Subject: [PATCH 60/60] arm64: dts: allwinner: trimui-smart-pro: Put the mixer
 behind the IOMMU

The display engine is IOMMU master 0. Behind it, scanout buffers no
longer need to be physically contiguous, and it can scan out the video
engine's buffers, which now are not either.

Signed-off-by: leow149 <leow149@lucidmail.xyz>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/allwinner/sun50i-a133-trimui-smartpro.dts | 1 +
 1 file changed, 1 insertion(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun50i-a133-trimui-smartpro.dts b/arch/arm64/boot/dts/allwinner/sun50i-a133-trimui-smartpro.dts
index 4fdb5b3a3..47ef62729 100644
--- a/arch/arm64/boot/dts/allwinner/sun50i-a133-trimui-smartpro.dts
+++ b/arch/arm64/boot/dts/allwinner/sun50i-a133-trimui-smartpro.dts
@@ -667,6 +667,7 @@ mixer0: mixer@100000 {
 				 <&display_clocks CLK_MIXER0>;
 			clock-names = "bus", "mod";
 			resets = <&display_clocks RST_MIXER0>;
+			iommus = <&iommu 0>;
 
 			ports {
 				#address-cells = <1>;
-- 
2.56.0

