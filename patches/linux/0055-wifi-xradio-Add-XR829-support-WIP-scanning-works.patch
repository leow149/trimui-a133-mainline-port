+/*
+ * XR829: the WLAN and BT cores share the DPLL; take the arbitration and
+ * make its control register match the reference clock from the SDD file.
+ */
+static int xradio_update_dpllctrl(struct xradio_common *hw_priv, u32 dpll_update)
+{
+	u32 val32 = 0, dpll_read = 0;
+	bool warned = false;
+	int ret, ret2, i;
+
+	ret = xradio_ahb_read_32(hw_priv, PWRCTRL_WLAN_START_CFG, &val32);
+	if (ret)
+		return ret;
+	for (i = 0; ; i++) {
+		ret = xradio_ahb_read_32(hw_priv, PWRCTRL_WLAN_COMMON_CFG, &val32);
+		if (ret)
+			break;
+		if (val32 & PWRCTRL_COMMON_REG_DONE) {
+			ret = xradio_ahb_read_32(hw_priv, PWRCTRL_WLAN_DPLL_CTRL,
+						 &dpll_read);
+			if (ret || dpll_read == dpll_update)
+				break;
+			if (!warned) {
+				dev_warn(hw_priv->pdev, "DPLL 0x%08x, want 0x%08x\n",
+					 dpll_read, dpll_update);
+				warned = true;
+			}
+		}
+		/* Arbitration over and BT not holding it: WLAN may write. */
+		if ((val32 & PWRCTRL_COMMON_REG_ARBT) &&
+		    !(val32 & PWRCTRL_COMMON_REG_BT)) {
+			ret = xradio_ahb_read_32(hw_priv, PWRCTRL_WLAN_DPLL_CTRL,
+						 &dpll_read);
+			if (ret)
+				break;
+			if (dpll_read != dpll_update) {
+				ret = xradio_ahb_write_32(hw_priv,
+							  PWRCTRL_WLAN_DPLL_CTRL,
+							  dpll_update | 0x1);
+				if (ret)
+					break;
+				msleep(5);
+			}
+			ret = xradio_ahb_write_32(hw_priv, PWRCTRL_WLAN_COMMON_CFG,
+						  PWRCTRL_COMMON_REG_DONE);
+			break;
+		}
+		if (i >= 100) {
+			dev_err(hw_priv->pdev, "DPLL access timeout, 0x%08x\n", val32);
+			ret = -ETIMEDOUT;
+			break;
+		}
+		msleep(i);
+	}
+	if (ret)
+		dev_err(hw_priv->pdev, "DPLL update failed: %d\n", ret);
+	ret2 = xradio_ahb_write_32(hw_priv, PWRCTRL_WLAN_START_CFG, 0);
+	return ret ? ret : ret2;
+}
