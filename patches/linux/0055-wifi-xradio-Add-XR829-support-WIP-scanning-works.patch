 {
-	const char *bl_path = XR819_BOOTLOADER;
+	const char *bl_path = hw_priv->hw_revision == XR829_HW_REV0 ?
+			      XR829_BOOTLOADER : XR819_BOOTLOADER;
 	u32  addr = AHB_MEMORY_ADDRESS;
 	int ret;
 	u32 i;
@@ -392,7 +461,9 @@ int xradio_load_firmware(struct xradio_common *hw_priv)
 		return -ENOTSUPP;
 	}
 	if (major_revision == 4) {
-		hw_priv->hw_revision = XR819_HW_REV0;
+		/* Both report revision 4; the SDIO device ID tells them apart. */
+		hw_priv->hw_revision = hw_priv->sdio_func->device == 0x2282 ?
+				       XR829_HW_REV0 : XR819_HW_REV0;
 		dev_dbg(hw_priv->pdev, "XRADIO_HW_REV 1.0 detected.\n");
 	} else {
 		dev_dbg(hw_priv->pdev, "Unsupported major revision %d.\n",
@@ -468,6 +539,12 @@ int xradio_load_firmware(struct xradio_common *hw_priv)
 		goto out;
 	}
 	if (val32 & HIF_CONFIG_ACCESS_MODE_BIT) {
+		if (hw_priv->hw_revision == XR829_HW_REV0) {
+			ret = xradio_update_dpllctrl(hw_priv,
+						     xradio_dllctrl_convert(dpll));
+			if (ret < 0)
+				goto out;
+		}
 		/* Down bootloader. */
 		ret = xradio_bootloader(hw_priv);
 		if (ret < 0) {
