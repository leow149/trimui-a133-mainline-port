+	if (xradio_ht40_api(hw_priv)) {
+		/* up to 6 rate entries, each with its own retry count */
+		__le16 *entry = (__le16 *)policy->raw;
+
+		for (i = 0; i < count && i < 6; ++i) {
+			u16 e;
+
+			if (rates[i].idx < 0)
+				break;
+			tmp_rate = (struct ieee80211_rate *)
+				   xradio_get_tx_rate(hw_priv, &rates[i]);
+			if (!tmp_rate)
+				break;
+			if (rates[i].flags & IEEE80211_TX_RC_MCS)
+				e = (WSM_RATE_ENTRY_MODEM_HT << WSM_RATE_ENTRY_MODEM_SHIFT) |
+				    ((tmp_rate->hw_value - WSM_TRANSMIT_RATE_HT_6)
+				     << WSM_RATE_ENTRY_INDEX_SHIFT);
+			else
+				e = tmp_rate->hw_value << WSM_RATE_ENTRY_INDEX_SHIFT;
+			if (rates[i].flags & IEEE80211_TX_RC_40_MHZ_WIDTH)
+				e |= WSM_RATE_ENTRY_BW_40M << WSM_RATE_ENTRY_BW_SHIFT;
+			if (rates[i].flags & IEEE80211_TX_RC_USE_SHORT_PREAMBLE)
+				e |= WSM_RATE_ENTRY_F_SHORT_PRE;
+			if (rates[i].flags & IEEE80211_TX_RC_SHORT_GI)
+				e |= WSM_RATE_ENTRY_F_SGI;
+			if (rates[i].count > 0x0F)
+				rates[i].count = 0x0F;
+			e |= rates[i].count;
+			entry[i] = __cpu_to_le16(e);
+			policy->retry_count += rates[i].count;
+		}
+		return;
+	}
+
 	/* TODO: minstrel/mac80211 can set IEEE80211_TX_RC_USE_RTS_CTS for individual frames
 	 * this is not possible with the current firmware API, because it takes the retry counts
 	 * as 4 bit uints with the rate implicit through the position in the bitfield.
@@ -819,6 +853,35 @@ xradio_tx_h_ba_stat(struct xradio_vif *priv,
 	spin_unlock_bh(&hw_priv->ba_lock);
 }
 
+/* Rewrite the TX request in the XR829 (HT40 API) layout. */
+static void
+xradio_tx_h_ht40(struct xradio_common *hw_priv, struct xradio_txinfo *t,
+		 struct wsm_tx *wsm)
+{
+	struct wsm_tx old = *wsm;
+	struct wsm_tx_ht40 *ht = (struct wsm_tx_ht40 *)wsm;
+	u8 policy = (old.flags >> 4) & 0x7;
+	const __le16 *entries =
+		(const __le16 *)hw_priv->tx_policy_cache.cache[policy].policy.raw;
+
+	BUILD_BUG_ON(sizeof(struct wsm_tx_ht40) != sizeof(struct wsm_tx));
+
+	memset(ht, 0, sizeof(*ht));
+	ht->hdr = old.hdr;
+	ht->packetID = old.packetID;
+	ht->queueId = old.queueId;
+	ht->DataOffset = t->txpriv.offset;
+	ht->EptaPriority = (old.flags >> 1) & 0x7;
+	ht->TxPolicyIndex = policy;
+	ht->ExpireTimeSetting = old.flags & 0x1;
+	ht->expireTime = old.expireTime;
+	if (t->txpriv.use_bg_rate)
+		ht->TxRateEntry = __cpu_to_le16(
+			wsm_legacy_rate_entry(t->txpriv.use_bg_rate & 0x3f));
+	else
+		ht->TxRateEntry = entries[0];
+}
+
 static int
 xradio_tx_h_skb_pad(struct xradio_common *priv,
 		    struct wsm_tx *wsm,
@@ -997,6 +1060,9 @@ void xradio_tx(struct ieee80211_hw *dev, struct ieee80211_tx_control *control, s
 		goto drop;
 	}
 
+	if (xradio_ht40_api(hw_priv))
+		xradio_tx_h_ht40(hw_priv, &t, wsm);
+
 	rcu_read_lock();
 	sta = rcu_dereference(control->sta);
 
