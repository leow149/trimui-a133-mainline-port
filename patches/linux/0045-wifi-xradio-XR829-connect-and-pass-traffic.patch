diff --git a/drivers/net/wireless/xradio/wsm.h b/drivers/net/wireless/xradio/wsm.h
index 42b57b750..0d3abc5f1 100644
--- a/drivers/net/wireless/xradio/wsm.h
+++ b/drivers/net/wireless/xradio/wsm.h
@@ -891,6 +891,47 @@ struct wsm_tx {
 	/* [in] */ __le32 htTxParameters;
 };
 
+/*
+ * HT40 API (XR829) layout of the TX request, same size as struct wsm_tx.
+ * The driver builds a struct wsm_tx and converts it right before queueing
+ * (xradio_tx_h_ht40); only packetID is read back afterwards, at the same
+ * offset in both layouts.
+ */
+struct wsm_tx_ht40 {
+	struct wsm_hdr hdr;
+	__le32 packetID;
+	u8 queueId;
+	u8 more;
+	u8 DataOffset;
+	u8 EptaPriority;
+	__le16 TxRateEntry;
+	u8 TxPolicyIndex;
+	u8 ExpireTimeSetting;
+	__le32 expireTime;
+	__le32 reserved;
+} __packed;
+
+/* HT40 API PHY mode word (join/start) */
+#define WSM_PHY_MODE_MODEM_B		BIT(0)	/* DSSS/CCK */
+#define WSM_PHY_MODE_MODEM_A		BIT(1)	/* OFDM */
+#define WSM_PHY_MODE_MODEM_N		BIT(2)	/* HT */
+#define WSM_PHY_MODE_WIDTH_SHIFT	4	/* 0: 20 MHz, 2: 40 MHz */
+#define WSM_PHY_MODE_PRI_CH_SHIFT	6
+#define WSM_PHY_MODE_BAND_SHIFT		8
+#define WSM_PHY_MODE_PREAMBLE_SHIFT	12
+#define WSM_PHY_MODE_SGI		BIT(14)
+#define WSM_PHY_MODE_GF			BIT(15)
+
+static inline u16 wsm_phy_mode_20mhz(u8 band)
+{
+	u16 modem = WSM_PHY_MODE_MODEM_A | WSM_PHY_MODE_MODEM_N;
+
+	if (band != WSM_PHY_BAND_5G)
+		modem |= WSM_PHY_MODE_MODEM_B;
+	/* long preamble; the association mode updates it later */
+	return modem | (band << WSM_PHY_MODE_BAND_SHIFT);
+}
+
 /* = sizeof(generic hi hdr) + sizeof(wsm hdr) + sizeof(alignment) */
 #define WSM_TX_EXTRA_HEADROOM (28)
 
@@ -1905,6 +1946,20 @@ struct wsm_template_frame {
 #define WSM_RATE_ENTRY_F_SHORT_PRE	BIT(8)
 #define WSM_RATE_ENTRY_F_SGI		BIT(9)
 
+#define WSM_RATE_ENTRY_INDEX_DEFAULT	0xf	/* also: end of a rate list */
+
+/* Old rate index (legacy 0-13, HT MCS0-7 = 14-21) of a rate entry, 0xff if none */
+static inline u8 wsm_rate_entry_to_index(u16 entry)
+{
+	u8 index = (entry >> WSM_RATE_ENTRY_INDEX_SHIFT) & 0xf;
+
+	if (index == WSM_RATE_ENTRY_INDEX_DEFAULT)
+		return 0xff;
+	if ((entry >> WSM_RATE_ENTRY_MODEM_SHIFT) == WSM_RATE_ENTRY_MODEM_HT)
+		return 14 + index;
+	return index;
+}
+
