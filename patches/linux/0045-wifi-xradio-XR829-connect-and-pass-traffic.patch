+	if (xradio_ht40_api(xrwl_vifpriv_to_hwpriv(priv))) {
+		/* two rate entries instead of two rate indices */
+		__le16 *entry = (__le16 *)&arg;
+		u8 rate = arg.internalTxRate, non_erp = arg.nonErpInternalTxRate;
