+#define WSM_ASSOC_HT40_USE_BASIC_RATE_SET	BIT(1)
+#define WSM_ASSOC_HT40_USE_MPDU_START_SPACING	BIT(2)
+
+int wsm_set_association_mode(struct xradio_common *hw_priv,
+			     struct wsm_association_mode *arg, int if_id)
+{
+	struct wsm_association_mode_ht40 ht = { };
+	u8 band;
+
+	if (!xradio_ht40_api(hw_priv))
+		return wsm_write_mib(hw_priv, WSM_MIB_ID_SET_ASSOCIATION_MODE,
+				     arg, sizeof(*arg), if_id);
+
+	band = hw_priv->channel && hw_priv->channel->band == NL80211_BAND_5GHZ ?
+	       WSM_PHY_BAND_5G : WSM_PHY_BAND_2_4G;
+	if (arg->flags & (WSM_ASSOCIATION_MODE_USE_PREAMBLE_TYPE |
+			  WSM_ASSOCIATION_MODE_USE_HT_MODE))
+		ht.flags |= WSM_ASSOC_HT40_USE_PHY_MODE_CFG;
+	if (arg->flags & WSM_ASSOCIATION_MODE_USE_BASIC_RATE_SET)
+		ht.flags |= WSM_ASSOC_HT40_USE_BASIC_RATE_SET;
+	if (arg->flags & WSM_ASSOCIATION_MODE_USE_MPDU_START_SPACING)
+		ht.flags |= WSM_ASSOC_HT40_USE_MPDU_START_SPACING;
+	ht.phy_mode = __cpu_to_le16(wsm_phy_mode_20mhz(band) |
+		(arg->preambleType << WSM_PHY_MODE_PREAMBLE_SHIFT) |
+		(arg->greenfieldMode ? WSM_PHY_MODE_GF : 0));
+	ht.mpduStartSpacing = arg->mpduStartSpacing;
+	ht.basicRateSet = arg->basicRateSet;
+	return wsm_write_mib(hw_priv, WSM_MIB_ID_SET_ASSOCIATION_MODE, &ht,
+			     sizeof(ht), if_id);
+}
