+/* HT40 API (XR829) association mode: a PHY mode word instead of preamble/GF */
+struct wsm_association_mode_ht40 {
+	u8 flags;
+	u8 reserved0;
+	__le16 phy_mode;
+	u8 mpduStartSpacing;
+	u8 reserved1[3];
+	__le32 basicRateSet;
