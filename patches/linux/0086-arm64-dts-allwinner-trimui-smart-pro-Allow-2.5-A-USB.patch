From e592dd3f0e33a609fdc6b4e3b703a74b0e227d30 Mon Sep 17 00:00:00 2001
From: leow149 <leow149@lucidmail.xyz>
Date: Sun, 8 Nov 2026 12:27:26 +0100
Subject: [PATCH 86/86] arm64: dts: allwinner: trimui-smart-pro: Allow 2.5 A
 USB input

Same as the stock firmware (pmu_usbad_cur): 2.5 A from a charger. PC
ports get 500 mA (or 1.5 A for a CDP) from the driver.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JJfik1hpStPgtN7deJRwXG
Signed-off-by: leow149 <leow149@lucidmail.xyz>
---
 arch/arm64/boot/dts/allwinner/sun50i-a133-trimui-smartpro.dts | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun50i-a133-trimui-smartpro.dts b/arch/arm64/boot/dts/allwinner/sun50i-a133-trimui-smartpro.dts
index 1467b3ace..3f005ca4a 100644
--- a/arch/arm64/boot/dts/allwinner/sun50i-a133-trimui-smartpro.dts
+++ b/arch/arm64/boot/dts/allwinner/sun50i-a133-trimui-smartpro.dts
@@ -519,6 +519,8 @@ battery_power: battery-power {
 
 		usb_power: usb-power {
 			compatible = "x-powers,axp717-usb-power-supply";
+			/* Stock: 2.5 A from a charger, 500 mA from a PC. */
+			input-current-limit-microamp = <2500000>;
 		};
 
 		/*
-- 
