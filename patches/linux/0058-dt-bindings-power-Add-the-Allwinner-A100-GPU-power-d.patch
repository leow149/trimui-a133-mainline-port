From 3e237d86fb73f3a97e354c29a22a71d3aa698bad Mon Sep 17 00:00:00 2001
From: leow149 <leow149@lucidmail.xyz>
Date: Sun, 15 Nov 2026 16:31:28 +0100
Subject: [PATCH 058/106] dt-bindings: power: Add the Allwinner A100 GPU power
 domain

The A100/A133 R_PPU block controls the single GPU power domain.

Signed-off-by: leow149 <leow149@lucidmail.xyz>
---
 .../power/allwinner,sun50i-a100-gpu-ppu.yaml  | 54 +++++++++++++++++++
 1 file changed, 54 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/power/allwinner,sun50i-a100-gpu-ppu.yaml

diff --git a/Documentation/devicetree/bindings/power/allwinner,sun50i-a100-gpu-ppu.yaml b/Documentation/devicetree/bindings/power/allwinner,sun50i-a100-gpu-ppu.yaml
new file mode 100644
index 000000000..f1890883c
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/allwinner,sun50i-a100-gpu-ppu.yaml
@@ -0,0 +1,54 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/allwinner,sun50i-a100-gpu-ppu.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Allwinner A100 GPU power domain controller
+
+maintainers:
+  - leow149 <leow149@lucidmail.xyz>
+
+description:
+  The A100 and A133 R_PPU block switches the power of the GPU, a single power
+  domain. Power switches, isolation, clock gate and reset of the domain are
+  all sequenced through its registers.
+
+properties:
+  compatible:
+    const: allwinner,sun50i-a100-gpu-ppu
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    description: Bus clock
+    maxItems: 1
+
+  resets:
+    maxItems: 1
+
+  '#power-domain-cells':
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - resets
+  - '#power-domain-cells'
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/sun50i-a100-r-ccu.h>
+    #include <dt-bindings/reset/sun50i-a100-r-ccu.h>
+
+    power-controller@7001000 {
+        compatible = "allwinner,sun50i-a100-gpu-ppu";
+        reg = <0x07001000 0x40>;
+        clocks = <&r_ccu CLK_R_APB1_PPU>;
+        resets = <&r_ccu RST_R_APB1_PPU>;
+        #power-domain-cells = <0>;
+    };
