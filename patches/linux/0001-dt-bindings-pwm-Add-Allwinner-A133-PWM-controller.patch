From 13e9f00be3ff2350e4d3876cff54a0881feae51b Mon Sep 17 00:00:00 2001
From: leow149 <leow149@lucidmail.xyz>
Date: Sun, 1 Nov 2026 00:21:23 +0100
Subject: [PATCH 001/106] dt-bindings: pwm: Add Allwinner A133 PWM controller

The A133 (sun50iw10) PWM block differs from the sun4i-style PWM handled by
pwm-sun4i: per-pair clock configuration and a separate gate/bypass register.
Document it for the new pwm-sun50i-a133 driver.

Signed-off-by: leow149 <leow149@lucidmail.xyz>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../pwm/allwinner,sun50i-a133-pwm.yaml        | 63 +++++++++++++++++++
 1 file changed, 63 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/pwm/allwinner,sun50i-a133-pwm.yaml

diff --git a/Documentation/devicetree/bindings/pwm/allwinner,sun50i-a133-pwm.yaml b/Documentation/devicetree/bindings/pwm/allwinner,sun50i-a133-pwm.yaml
new file mode 100644
index 000000000..33b259afc
--- /dev/null
+++ b/Documentation/devicetree/bindings/pwm/allwinner,sun50i-a133-pwm.yaml
@@ -0,0 +1,63 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/pwm/allwinner,sun50i-a133-pwm.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Allwinner A100/A133 PWM controller
+
+description: |
+  PWM controller of the Allwinner A100/A133 (sun50iw10): 4 channels in 2
+  pairs, with a per-pair clock source (OSC24M or APB1) inside the block.
+  Not compatible with the allwinner,sun4i-a10-pwm family.
+
+maintainers:
+  - leow149 <leow149@lucidmail.xyz>
+
+allOf:
+  - $ref: pwm.yaml#
+
+properties:
+  compatible:
+    const: allwinner,sun50i-a133-pwm
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    items:
+      - description: Bus clock
+
+  clock-names:
+    items:
+      - const: bus
+
+  resets:
+    maxItems: 1
+
+  "#pwm-cells":
+    const: 3
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - resets
+  - "#pwm-cells"
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/sun50i-a100-ccu.h>
+    #include <dt-bindings/reset/sun50i-a100-ccu.h>
+
+    pwm: pwm@300a000 {
+        compatible = "allwinner,sun50i-a133-pwm";
+        reg = <0x0300a000 0x400>;
+        clocks = <&ccu CLK_BUS_PWM>;
+        clock-names = "bus";
+        resets = <&ccu RST_BUS_PWM>;
+        #pwm-cells = <3>;
+    };
