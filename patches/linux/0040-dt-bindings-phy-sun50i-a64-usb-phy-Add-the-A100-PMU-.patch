From 2c12e5c049aa92cd040755825625bda8ae595034 Mon Sep 17 00:00:00 2001
From: leow149 <leow149@lucidmail.xyz>
Date: Sun, 15 Nov 2026 16:39:30 +0100
Subject: [PATCH 040/100] dt-bindings: phy: sun50i-a64-usb-phy: Add the A100
 PMU clocks

On the A100/A133 the PMU (HCI) registers of each PHY are only accessible
with the bus clock of the matching EHCI controller running, which the PHY
driver enables as pmu0_clk/pmu1_clk. Require these two clocks for the A100
PHY only.

This changes the A100 binding: a DT without them, like the A100 DTs so far,
no longer validates. Those DTs ran the PHY with the D1 settings, without
the PHY1 SIDDQ helper and the end-of-reset pulse the A100 needs, which left
the OTG port unusable in peripheral mode; nothing that worked is lost.

Assisted-by: Claude Opus 5.5
Signed-off-by: leow149 <leow149@lucidmail.xyz>
---
 .../phy/allwinner,sun50i-a64-usb-phy.yaml     | 26 +++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/Documentation/devicetree/bindings/phy/allwinner,sun50i-a64-usb-phy.yaml b/Documentation/devicetree/bindings/phy/allwinner,sun50i-a64-usb-phy.yaml
index 580c3296a..5103eef0d 100644
--- a/Documentation/devicetree/bindings/phy/allwinner,sun50i-a64-usb-phy.yaml
+++ b/Documentation/devicetree/bindings/phy/allwinner,sun50i-a64-usb-phy.yaml
@@ -38,14 +38,20 @@ properties:
       - const: pmu1
 
   clocks:
+    minItems: 2
     items:
       - description: USB OTG PHY bus clock
       - description: USB Host 0 PHY bus clock
+      - description: USB OTG PHY PMU (HCI 0) bus clock
+      - description: USB Host 0 PHY PMU (HCI 1) bus clock
 
   clock-names:
+    minItems: 2
     items:
       - const: usb0_phy
       - const: usb1_phy
+      - const: pmu0_clk
+      - const: pmu1_clk
 
   resets:
     items:
@@ -84,6 +90,26 @@ required:
   - resets
   - reset-names
 
+if:
+  properties:
+    compatible:
+      contains:
+        const: allwinner,sun50i-a100-usb-phy
+
+then:
+  properties:
+    clocks:
+      minItems: 4
+    clock-names:
+      minItems: 4
+
+else:
+  properties:
+    clocks:
+      maxItems: 2
+    clock-names:
+      maxItems: 2
+
 additionalProperties: false
 
 examples:
