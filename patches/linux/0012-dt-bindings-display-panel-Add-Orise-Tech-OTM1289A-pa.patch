From a3c1e4bd5dd99da2680e95da04250111c0fa1cf0 Mon Sep 17 00:00:00 2001
From: leow149 <leow149@lucidmail.xyz>
Date: Sun, 15 Nov 2026 16:19:10 +0100
Subject: [PATCH 012/106] dt-bindings: display: panel: Add Orise Tech OTM1289A
 panel module

Add a binding for the 720x1280 MIPI-DSI panel module of the TrimUI Smart
Pro. The module carries either an Orise Tech OTM1289A or a pin-compatible
ER68576 controller; the driver tells them apart by their DCS ID, so a
single compatible covers both.

Signed-off-by: leow149 <leow149@lucidmail.xyz>
---
 .../display/panel/orisetech,otm1289a.yaml     | 61 +++++++++++++++++++
 1 file changed, 61 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/display/panel/orisetech,otm1289a.yaml

diff --git a/Documentation/devicetree/bindings/display/panel/orisetech,otm1289a.yaml b/Documentation/devicetree/bindings/display/panel/orisetech,otm1289a.yaml
new file mode 100644
index 000000000..31eb25f89
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/panel/orisetech,otm1289a.yaml
@@ -0,0 +1,61 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/orisetech,otm1289a.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Orise Tech OTM1289A based 720x1280 MIPI-DSI panel module
+
+maintainers:
+  - leow149 <leow149@lucidmail.xyz>
+
+description: |
+  5" 720x1280 TFT LCD module with a 4-lane MIPI-DSI video mode interface, as
+  used in the TrimUI Smart Pro handheld. The module ships either with an Orise
+  Tech OTM1289A controller or with a pin-compatible ER68576 controller. The
+  two need different initialisation sequences; the operating system tells
+  them apart by reading the controller ID over DCS (registers 0xda, 0xdb and
+  0xdc), as the vendor boot loader does, so one compatible covers both.
+
+allOf:
+  - $ref: panel-common.yaml#
+
+properties:
+  compatible:
+    const: orisetech,otm1289a
+
+  reg:
+    maxItems: 1
+    description: DSI virtual channel
+
+  backlight: true
+  port: true
+  power-supply: true
+  reset-gpios: true
+  rotation: true
+
+required:
+  - compatible
+  - reg
+  - power-supply
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    dsi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        panel@0 {
+            compatible = "orisetech,otm1289a";
+            reg = <0>;
+            reset-gpios = <&pio 3 22 GPIO_ACTIVE_LOW>;
+            rotation = <270>;
+            power-supply = <&reg_cldo1>;
+            backlight = <&backlight>;
+        };
+    };
+...
