From fd55517368c2ea94d2dfaf6b1462dcae295bf43e Mon Sep 17 00:00:00 2001
From: leow149 <leow149@lucidmail.xyz>
Date: Sun, 8 Nov 2026 00:36:10 +0100
Subject: [PATCH 085/106] usb: musb: sunxi: Preserve the session across system
 suspend

musb_suspend() clears DEVCTL (ending the session) unless the glue sets
MUSB_PRESERVE_SESSION, and it saves the context only after that, so
musb_resume() has nothing to restore. On the sunxi glue the session is
only (re)started by the mode-change work, which does not run on resume.
After s2idle the controller is therefore left with no session: the UDC
reads "not attached", the D+ pull-up is not seen by the host and the
host fails to enumerate (descriptor read errors, -71).

Set MUSB_PRESERVE_SESSION so suspend leaves DEVCTL alone and resume
restores the session. Tested on the TrimUI Smart Pro (Allwinner A133)
with the NCM gadget: 0 of 6 cycles re-enumerated before, 11 of 11 after.

Only the A100/A133 glue gets the quirk (its own platform ops), as only
that one was tested; the other sunxi SoCs keep the current behaviour.

Assisted-by: Claude Opus 5.5
Signed-off-by: leow149 <leow149@lucidmail.xyz>
---
 drivers/usb/musb/sunxi.c | 57 ++++++++++++++++++++++++++--------------
 1 file changed, 37 insertions(+), 20 deletions(-)

diff --git a/drivers/usb/musb/sunxi.c b/drivers/usb/musb/sunxi.c
index a7562f198..412923525 100644
--- a/drivers/usb/musb/sunxi.c
+++ b/drivers/usb/musb/sunxi.c
@@ -76,6 +76,7 @@ struct sunxi_musb_cfg {
 	bool has_sram;
 	bool has_reset;
 	bool no_configdata;
+	bool preserve_session;
 };
 
 /* Our read/write methods need access and do not get passed in a musb ref :| */
@@ -909,26 +910,40 @@ static void sunxi_musb_writew(void __iomem *addr, unsigned offset, u16 data)
 #define SUNXI_MUSB_DMA_QUIRK \
 	(IS_ENABLED(CONFIG_USB_SUNXI_DMA) ? MUSB_DMA_SUNXI : 0)
 
+#define SUNXI_MUSB_OPS							\
+	.init		= sunxi_musb_init,				\
+	.exit		= sunxi_musb_exit,				\
+	.enable		= sunxi_musb_enable,				\
+	.disable	= sunxi_musb_disable,				\
+	.fifo_offset	= sunxi_musb_fifo_offset,			\
+	.ep_offset	= sunxi_musb_ep_offset,				\
+	.busctl_offset	= sunxi_musb_busctl_offset,			\
+	.readb		= sunxi_musb_readb,				\
+	.writeb		= sunxi_musb_writeb,				\
+	.readw		= sunxi_musb_readw,				\
+	.writew		= sunxi_musb_writew,				\
+	.dma_init	= sunxi_musb_dma_controller_create,		\
+	.dma_exit	= sunxi_musb_dma_controller_destroy,		\
+	.set_mode	= sunxi_musb_set_mode,				\
+	.recover	= sunxi_musb_recover,				\
+	.set_vbus	= sunxi_musb_set_vbus,				\
+	.pre_root_reset_end = sunxi_musb_pre_root_reset_end,		\
+	.post_root_reset_end = sunxi_musb_post_root_reset_end
+
 static const struct musb_platform_ops sunxi_musb_ops = {
 	.quirks		= MUSB_INDEXED_EP | SUNXI_MUSB_DMA_QUIRK,
-	.init		= sunxi_musb_init,
-	.exit		= sunxi_musb_exit,
-	.enable		= sunxi_musb_enable,
-	.disable	= sunxi_musb_disable,
-	.fifo_offset	= sunxi_musb_fifo_offset,
-	.ep_offset	= sunxi_musb_ep_offset,
-	.busctl_offset	= sunxi_musb_busctl_offset,
-	.readb		= sunxi_musb_readb,
-	.writeb		= sunxi_musb_writeb,
-	.readw		= sunxi_musb_readw,
-	.writew		= sunxi_musb_writew,
-	.dma_init	= sunxi_musb_dma_controller_create,
-	.dma_exit	= sunxi_musb_dma_controller_destroy,
-	.set_mode	= sunxi_musb_set_mode,
-	.recover	= sunxi_musb_recover,
-	.set_vbus	= sunxi_musb_set_vbus,
-	.pre_root_reset_end = sunxi_musb_pre_root_reset_end,
-	.post_root_reset_end = sunxi_musb_post_root_reset_end,
+	SUNXI_MUSB_OPS,
+};
+
+/*
+ * musb_suspend() ends the session unless MUSB_PRESERVE_SESSION is set, and
+ * on this glue only the mode-change work starts a new one, which does not
+ * run on resume. Verified on A133 (gadget re-enumerates after s2idle).
+ */
+static const struct musb_platform_ops sunxi_musb_preserve_session_ops = {
+	.quirks		= MUSB_INDEXED_EP | MUSB_PRESERVE_SESSION |
+			  SUNXI_MUSB_DMA_QUIRK,
+	SUNXI_MUSB_OPS,
 };
 
 #define SUNXI_MUSB_RAM_BITS	11
@@ -1049,12 +1064,13 @@ static int sunxi_musb_probe(struct platform_device *pdev)
 		dev_err(&pdev->dev, "Invalid or missing 'dr_mode' property\n");
 		return -EINVAL;
 	}
-	pdata.platform_ops	= &sunxi_musb_ops;
-
 	cfg = of_device_get_match_data(&pdev->dev);
 	if (!cfg)
 		return -EINVAL;
 
+	pdata.platform_ops = cfg->preserve_session ?
+		&sunxi_musb_preserve_session_ops : &sunxi_musb_ops;
+
 	pdata.config = cfg->hdrc_config;
 
 	glue->dev = &pdev->dev;
@@ -1170,6 +1186,7 @@ static const struct sunxi_musb_cfg sun50i_a100_musb_cfg = {
 	.hdrc_config = &sunxi_musb_hdrc_config_a100,
 	.has_reset = true,
 	.no_configdata = true,
+	.preserve_session = true,
 };
 
 static const struct sunxi_musb_cfg suniv_f1c100s_musb_cfg = {
