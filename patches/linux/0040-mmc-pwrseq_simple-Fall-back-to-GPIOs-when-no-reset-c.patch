From e255dc7bcbccc95ec4b240ee5ff040c6fcd32438 Mon Sep 17 00:00:00 2001
From: leow149 <leow149@lucidmail.xyz>
Date: Sun, 1 Nov 2026 14:30:30 +0100
Subject: [PATCH 40/48] mmc: pwrseq_simple: Fall back to GPIOs when no reset
 controller can be made

With a single reset GPIO, pwrseq_simple asks the reset core for a reset
controller wrapping it. The reset-gpio helper only handles #gpio-cells = <2>
and returns -ENOENT for anything else (e.g. Allwinner, <3>), which made the
probe fail, although the driver can drive the GPIO itself. Treat -ENOENT as
"no reset controller" and use the GPIO path.

Signed-off-by: leow149 <leow149@lucidmail.xyz>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/mmc/core/pwrseq_simple.c | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/drivers/mmc/core/pwrseq_simple.c b/drivers/mmc/core/pwrseq_simple.c
index 4b47e6c3b..0e25fc957 100644
--- a/drivers/mmc/core/pwrseq_simple.c
+++ b/drivers/mmc/core/pwrseq_simple.c
@@ -137,7 +137,13 @@ static int mmc_pwrseq_simple_probe(struct platform_device *pdev)
 	ngpio = of_count_phandle_with_args(dev->of_node, "reset-gpios", "#gpio-cells");
 	if (ngpio == 1) {
 		pwrseq->reset_ctrl = devm_reset_control_get_optional_shared(dev, NULL);
-		if (IS_ERR(pwrseq->reset_ctrl))
+		/*
+		 * -ENOENT: the GPIO cannot be wrapped as a reset controller
+		 * (e.g. #gpio-cells = <3>), drive it directly below.
+		 */
+		if (PTR_ERR(pwrseq->reset_ctrl) == -ENOENT)
+			pwrseq->reset_ctrl = NULL;
+		else if (IS_ERR(pwrseq->reset_ctrl))
 			return dev_err_probe(dev, PTR_ERR(pwrseq->reset_ctrl),
 					     "reset control not ready\n");
 	}
