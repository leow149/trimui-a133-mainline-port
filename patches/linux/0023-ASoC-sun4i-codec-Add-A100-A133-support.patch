From 169879444e982e4bd87c5b57e391db012d405337 Mon Sep 17 00:00:00 2001
From: leow149 <leow149@lucidmail.xyz>
Date: Sun, 1 Nov 2026 01:24:51 +0100
Subject: [PATCH 23/29] ASoC: sun4i-codec: Add A100/A133 support

The A100/A133 codec has the H616 digital part (same FIFO, DMA and DAC control
registers) but a different analog part: a single (left) line out, no output
mixer, and a stereo headphone amplifier with its gain in the DAC register.
Add an analog component for it and reuse the H616 setup otherwise. Playback
only, like H616.

Signed-off-by: leow149 <leow149@lucidmail.xyz>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 sound/soc/sunxi/sun4i-codec.c | 146 ++++++++++++++++++++++++++++++++++
 1 file changed, 146 insertions(+)

diff --git a/sound/soc/sunxi/sun4i-codec.c b/sound/soc/sunxi/sun4i-codec.c
index ff56700a9..f1205f52e 100644
--- a/sound/soc/sunxi/sun4i-codec.c
+++ b/sound/soc/sunxi/sun4i-codec.c
@@ -265,6 +265,19 @@
 #define SUN50I_H616_RAMP_STEP			(4)
 #define SUN50I_H616_RDEN			(0)
 
+/* A100/A133 specific registers: H616 digital part, different analog part */
+#define SUN50I_A100_DAC_REG			(0x310)
+#define SUN50I_A100_HP_GAIN			(28)
+#define SUN50I_A100_DAC_LEN			(15)
+#define SUN50I_A100_DAC_REN			(14)
+#define SUN50I_A100_LINEOUTL_EN			(13)
+#define SUN50I_A100_LMUTE			(12)
+#define SUN50I_A100_LINEOUTL_DIFF		(6)
+#define SUN50I_A100_LINEOUT_VOL			(0)
+#define SUN50I_A100_HP_REG			(0x324)
+#define SUN50I_A100_HPPA_EN			(15)
+#define SUN50I_A100_HMIC_STS_REG		(0x32c)
+
 /* TODO H3 DAP (Digital Audio Processing) bits */
 
 #define SUN4I_DMA_MAX_BURST			(8)
@@ -2031,6 +2044,116 @@ static struct snd_soc_card *sun50i_h616_codec_create_card(struct device *dev)
 	return card;
 };
 
+/* Headphone gain: 0 dB down to -42 dB in -6 dB steps. */
+static const DECLARE_TLV_DB_SCALE(sun50i_a100_codec_hp_vol_scale, -4200, 600, 0);
+
+static const struct snd_kcontrol_new sun50i_a100_codec_codec_controls[] = {
+	SOC_SINGLE_TLV("DAC Playback Volume", SUN4I_CODEC_DAC_DPC,
+		       SUN4I_CODEC_DAC_DPC_DVOL, 0x3f, 1,
+		       sun6i_codec_dvol_scale),
+	SOC_SINGLE_TLV("Line Out Playback Volume", SUN50I_A100_DAC_REG,
+		       SUN50I_A100_LINEOUT_VOL, 0x1f, 0,
+		       sun6i_codec_lineout_vol_scale),
+	SOC_SINGLE("Line Out Playback Switch", SUN50I_A100_DAC_REG,
+		   SUN50I_A100_LMUTE, 1, 0),
+	SOC_SINGLE("Line Out Differential Switch", SUN50I_A100_DAC_REG,
+		   SUN50I_A100_LINEOUTL_DIFF, 1, 0),
+	SOC_SINGLE_TLV("Headphone Playback Volume", SUN50I_A100_DAC_REG,
+		       SUN50I_A100_HP_GAIN, 0x7, 1,
+		       sun50i_a100_codec_hp_vol_scale),
+};
+
+static const struct snd_soc_dapm_widget sun50i_a100_codec_codec_widgets[] = {
+	/* Digital parts of the DACs */
+	SND_SOC_DAPM_SUPPLY("DAC Enable", SUN4I_CODEC_DAC_DPC,
+			    SUN4I_CODEC_DAC_DPC_EN_DA, 0,
+			    NULL, 0),
+
+	/* Analog parts of the DACs */
+	SND_SOC_DAPM_DAC("Left DAC", "Codec Playback",
+			 SUN50I_A100_DAC_REG, SUN50I_A100_DAC_LEN, 0),
+	SND_SOC_DAPM_DAC("Right DAC", "Codec Playback",
+			 SUN50I_A100_DAC_REG, SUN50I_A100_DAC_REN, 0),
+
+	/* Line out: left channel only */
+	SND_SOC_DAPM_OUT_DRV("Line Out Amp", SUN50I_A100_DAC_REG,
+			     SUN50I_A100_LINEOUTL_EN, 0, NULL, 0),
+	SND_SOC_DAPM_OUTPUT("LINEOUT"),
+
+	/* Headphone */
+	SND_SOC_DAPM_OUT_DRV("Headphone Amp", SUN50I_A100_HP_REG,
+			     SUN50I_A100_HPPA_EN, 0, NULL, 0),
+	SND_SOC_DAPM_OUTPUT("HP"),
+};
+
+static const struct snd_soc_dapm_route sun50i_a100_codec_codec_routes[] = {
+	{ "Left DAC", NULL, "DAC Enable" },
+	{ "Right DAC", NULL, "DAC Enable" },
+
+	{ "Line Out Amp", NULL, "Left DAC" },
+	{ "LINEOUT", NULL, "Line Out Amp" },
+
+	{ "Headphone Amp", NULL, "Left DAC" },
+	{ "Headphone Amp", NULL, "Right DAC" },
+	{ "HP", NULL, "Headphone Amp" },
+};
+
+static const struct snd_soc_component_driver sun50i_a100_codec_codec = {
+	.controls		= sun50i_a100_codec_codec_controls,
+	.num_controls		= ARRAY_SIZE(sun50i_a100_codec_codec_controls),
+	.dapm_widgets		= sun50i_a100_codec_codec_widgets,
+	.num_dapm_widgets	= ARRAY_SIZE(sun50i_a100_codec_codec_widgets),
+	.dapm_routes		= sun50i_a100_codec_codec_routes,
+	.num_dapm_routes	= ARRAY_SIZE(sun50i_a100_codec_codec_routes),
+	.idle_bias_on		= 1,
+	.use_pmdown_time	= 1,
+	.endianness		= 1,
+};
+
+static const struct snd_kcontrol_new sun50i_a100_card_controls[] = {
+	SOC_DAPM_PIN_SWITCH("Speaker"),
+	SOC_DAPM_PIN_SWITCH("Headphone"),
+};
+
+static const struct snd_soc_dapm_widget sun50i_a100_codec_card_dapm_widgets[] = {
+	SND_SOC_DAPM_HP("Headphone", NULL),
+	SND_SOC_DAPM_SPK("Speaker", sun4i_codec_spk_event),
+};
+
+static struct snd_soc_card *sun50i_a100_codec_create_card(struct device *dev)
+{
+	struct snd_soc_card *card;
+	int ret;
+
+	card = devm_kzalloc(dev, sizeof(*card), GFP_KERNEL);
+	if (!card)
+		return ERR_PTR(-ENOMEM);
+
+	card->dai_link = sun4i_codec_create_link(dev, &card->num_links);
+	if (!card->dai_link)
+		return ERR_PTR(-ENOMEM);
+
+	card->dai_link->playback_only = true;
+	card->dai_link->capture_only = false;
+
+	card->dev		= dev;
+	card->owner		= THIS_MODULE;
+	card->name		= "A100 Audio Codec";
+	card->long_name		= "a100-audio-codec";
+	card->driver_name	= "sun4i-codec";
+	card->controls		= sun50i_a100_card_controls;
+	card->num_controls	= ARRAY_SIZE(sun50i_a100_card_controls);
+	card->dapm_widgets	= sun50i_a100_codec_card_dapm_widgets;
+	card->num_dapm_widgets	= ARRAY_SIZE(sun50i_a100_codec_card_dapm_widgets);
+	card->fully_routed	= true;
+
+	ret = snd_soc_of_parse_audio_routing(card, "allwinner,audio-routing");
+	if (ret)
+		dev_warn(dev, "failed to parse audio-routing: %d\n", ret);
+
+	return card;
+};
+
 static const struct snd_soc_dapm_widget suniv_codec_card_dapm_widgets[] = {
 	SND_SOC_DAPM_HP("Headphone", NULL),
 	SND_SOC_DAPM_LINE("Line In", NULL),
@@ -2131,6 +2254,14 @@ static const struct regmap_config sun50i_h616_codec_regmap_config = {
 	.cache_type	= REGCACHE_NONE,
 };
 
+static const struct regmap_config sun50i_a100_codec_regmap_config = {
+	.reg_bits	= 32,
+	.reg_stride	= 4,
+	.val_bits	= 32,
+	.max_register	= SUN50I_A100_HMIC_STS_REG,
+	.cache_type	= REGCACHE_NONE,
+};
+
 static const struct regmap_config suniv_codec_regmap_config = {
 	.reg_bits	= 32,
 	.reg_stride	= 4,
@@ -2241,6 +2372,17 @@ static const struct sun4i_codec_quirks sun50i_h616_codec_quirks = {
 	.dma_max_burst	= SUN4I_DMA_MAX_BURST,
 };
 
+static const struct sun4i_codec_quirks sun50i_a100_codec_quirks = {
+	.regmap_config	= &sun50i_a100_codec_regmap_config,
+	.codec		= &sun50i_a100_codec_codec,
+	.create_card	= sun50i_a100_codec_create_card,
+	.reg_dac_fifoc	= REG_FIELD(SUN50I_H616_CODEC_DAC_FIFOC, 0, 31),
+	.reg_dac_txdata	= SUN8I_H3_CODEC_DAC_TXDATA,
+	.has_reset	= true,
+	.playback_only	= true,
+	.dma_max_burst	= SUN4I_DMA_MAX_BURST,
+};
+
 static const struct sun4i_codec_quirks suniv_f1c100s_codec_quirks = {
 	.regmap_config	= &suniv_codec_regmap_config,
 	.codec		= &suniv_codec_codec,
@@ -2282,6 +2424,10 @@ static const struct of_device_id sun4i_codec_of_match[] = {
 		.compatible = "allwinner,sun50i-h616-codec",
 		.data = &sun50i_h616_codec_quirks,
 	},
+	{
+		.compatible = "allwinner,sun50i-a100-codec",
+		.data = &sun50i_a100_codec_quirks,
+	},
 	{
 		.compatible = "allwinner,suniv-f1c100s-codec",
 		.data = &suniv_f1c100s_codec_quirks,
-- 
2.56.0

