   - "#clock-cells"
@@ -151,6 +150,8 @@ allOf:
           required:
             - port@2
             - port@3
+            - port@4
+            - port@5
 
   - if:
       properties:
@@ -179,6 +180,11 @@ allOf:
             - description: TCON TV0 output clock name
