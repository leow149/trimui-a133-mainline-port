From 3107a29679979c4a1ec9ec4c032eb3d73d7221a1 Mon Sep 17 00:00:00 2001
From: leow149 <leow149@lucidmail.xyz>
Date: Sat, 7 Nov 2026 20:02:57 +0100
Subject: [PATCH 65/65] arm64: dts: allwinner: trimui-smart-pro: Suspend
 hardening

Mark vcc-pad (button MCUs and LEDs) off-in-suspend for suspend states that
honour regulator suspend configs (s2idle does not), and make the LRADC
volume keys a wakeup source.

Volume-key wake is not hardware-tested yet.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: leow149 <leow149@lucidmail.xyz>
---
 arch/arm64/boot/dts/allwinner/sun50i-a133-trimui-smartpro.dts | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun50i-a133-trimui-smartpro.dts b/arch/arm64/boot/dts/allwinner/sun50i-a133-trimui-smartpro.dts
index d6306cde9..54cecd045 100644
--- a/arch/arm64/boot/dts/allwinner/sun50i-a133-trimui-smartpro.dts
+++ b/arch/arm64/boot/dts/allwinner/sun50i-a133-trimui-smartpro.dts
@@ -104,6 +104,7 @@ reg_vcc_pad: regulator-vcc-pad {
 		regulator-max-microvolt = <5000000>;
 		gpio = <&pio 3 11 GPIO_ACTIVE_HIGH>; /* PD11 */
 		enable-active-high;
+		regulator-off-in-suspend;
 		vin-supply = <&reg_vcc5v>;
 	};
 
@@ -349,6 +350,7 @@ multi-led@16 {
 
 &lradc {
 	vref-supply = <&reg_aldo4>;
+	wakeup-source;
 	status = "okay";
 
 	button-643 {
-- 
