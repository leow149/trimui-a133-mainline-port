From 71878d46f6dd208c5de25c40892e1fadfbda7f6a Mon Sep 17 00:00:00 2001
From: leow149 <leow149@lucidmail.xyz>
Date: Sun, 1 Nov 2026 00:21:26 +0100
Subject: [PATCH 006/106] drm/sun4i: tcon-top: Register clocks at probe time

On SoCs where the DSI controller takes its module clock from the TCON TOP DSI
gate (A133), the DSI driver needs that clock in its probe, but the TCON TOP
only registered its clocks in the component bind callback, which runs later.
Add a quirk to set up the registers and clocks in probe instead, and keep
the bind-time setup on the other SoCs. The D1 DT describes the same clock
arrangement and probably needs the quirk too; that is untested.

Signed-off-by: leow149 <leow149@lucidmail.xyz>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/gpu/drm/sun4i/sun8i_tcon_top.c | 58 +++++++++++++++++++++++---
 1 file changed, 52 insertions(+), 6 deletions(-)

diff --git a/drivers/gpu/drm/sun4i/sun8i_tcon_top.c b/drivers/gpu/drm/sun4i/sun8i_tcon_top.c
index 9cbd65551..ad7b22c39 100644
--- a/drivers/gpu/drm/sun4i/sun8i_tcon_top.c
+++ b/drivers/gpu/drm/sun4i/sun8i_tcon_top.c
@@ -18,6 +18,8 @@
 struct sun8i_tcon_top_quirks {
 	bool has_tcon_tv1;
 	bool has_dsi;
+	/* Clock consumers that need the clocks in their probe (DSI) */
+	bool init_at_probe;
 };
 
 static bool sun8i_tcon_top_node_is_tcon_top(struct device_node *node)
@@ -171,10 +173,17 @@ static struct clk_hw *sun8i_tcon_top_register_gate(struct device *dev,
 				    bit, 0, lock);
 };
 
-static int sun8i_tcon_top_bind(struct device *dev, struct device *master,
-			       void *data)
+/*
+ * The TCON TOP gates are a clock provider for other display blocks, e.g. the
+ * DSI "mod" clock on A133. Such consumers need the clocks in their own
+ * probe(), before the DRM component bind runs, so on those SoCs
+ * (init_at_probe) all hardware and clock setup happens at probe time and the
+ * component bind/unbind have nothing left to do. Elsewhere it stays in
+ * bind/unbind.
+ */
+static int sun8i_tcon_top_init(struct platform_device *pdev)
 {
-	struct platform_device *pdev = to_platform_device(dev);
+	struct device *dev = &pdev->dev;
 	struct clk_hw_onecell_data *clk_data;
 	struct sun8i_tcon_top *tcon_top;
 	const struct sun8i_tcon_top_quirks *quirks;
@@ -281,8 +290,7 @@ static int sun8i_tcon_top_bind(struct device *dev, struct device *master,
 	return ret;
 }
 
-static void sun8i_tcon_top_unbind(struct device *dev, struct device *master,
-				  void *data)
+static void sun8i_tcon_top_fini(struct device *dev)
 {
 	struct sun8i_tcon_top *tcon_top = dev_get_drvdata(dev);
 	struct clk_hw_onecell_data *clk_data = tcon_top->clk_data;
@@ -297,6 +305,29 @@ static void sun8i_tcon_top_unbind(struct device *dev, struct device *master,
 	reset_control_assert(tcon_top->rst);
 }
 
+static bool sun8i_tcon_top_init_at_probe(struct device *dev)
+{
+	const struct sun8i_tcon_top_quirks *quirks = of_device_get_match_data(dev);
+
+	return quirks->init_at_probe;
+}
+
+static int sun8i_tcon_top_bind(struct device *dev, struct device *master,
+			       void *data)
+{
+	if (sun8i_tcon_top_init_at_probe(dev))
+		return 0;
+
+	return sun8i_tcon_top_init(to_platform_device(dev));
+}
+
+static void sun8i_tcon_top_unbind(struct device *dev, struct device *master,
+				  void *data)
+{
+	if (!sun8i_tcon_top_init_at_probe(dev))
+		sun8i_tcon_top_fini(dev);
+}
+
 static const struct component_ops sun8i_tcon_top_ops = {
 	.bind	= sun8i_tcon_top_bind,
 	.unbind	= sun8i_tcon_top_unbind,
@@ -304,12 +335,27 @@ static const struct component_ops sun8i_tcon_top_ops = {
 
 static int sun8i_tcon_top_probe(struct platform_device *pdev)
 {
-	return component_add(&pdev->dev, &sun8i_tcon_top_ops);
+	bool init_at_probe = sun8i_tcon_top_init_at_probe(&pdev->dev);
+	int ret;
+
+	if (init_at_probe) {
+		ret = sun8i_tcon_top_init(pdev);
+		if (ret)
+			return ret;
+	}
+
+	ret = component_add(&pdev->dev, &sun8i_tcon_top_ops);
+	if (ret && init_at_probe)
+		sun8i_tcon_top_fini(&pdev->dev);
+
+	return ret;
 }
 
 static void sun8i_tcon_top_remove(struct platform_device *pdev)
 {
 	component_del(&pdev->dev, &sun8i_tcon_top_ops);
+	if (sun8i_tcon_top_init_at_probe(&pdev->dev))
+		sun8i_tcon_top_fini(&pdev->dev);
 }
 
 static const struct sun8i_tcon_top_quirks sun8i_r40_tcon_top_quirks = {
