diff --git a/drivers/net/wireless/xradio/wsm.c b/drivers/net/wireless/xradio/wsm.c
index ea737709e..66ab0ad66 100644
--- a/drivers/net/wireless/xradio/wsm.c
+++ b/drivers/net/wireless/xradio/wsm.c
@@ -433,6 +433,40 @@ static int wsm_write_mib_confirm(struct xradio_common *hw_priv,
 
 /* ******************************************************************** */
 
+int wsm_set_template_frame(struct xradio_common *hw_priv,
+			   struct wsm_template_frame *arg, int if_id)
+{
+	int ret;
+	u8 *p;
+
+	if (xradio_ht40_api(hw_priv)) {
+		/* u16 frame type, u16 rate entry, u32 length */
+		__le32 len = arg->disable ? 0 :
+			     __cpu_to_le32(arg->skb->len);
+
+		p = skb_push(arg->skb, 8);
+		put_unaligned_le16(arg->frame_type, p);
+		put_unaligned_le16(wsm_legacy_rate_entry(arg->rate), p + 2);
+		memcpy(p + 4, &len, 4);
+		ret = wsm_write_mib(hw_priv, WSM_MIB_ID_TEMPLATE_FRAME, p,
+				    arg->skb->len, if_id);
+		skb_pull(arg->skb, 8);
+		return ret;
+	}
+
+	p = skb_push(arg->skb, 4);
+	p[0] = arg->frame_type;
+	p[1] = arg->rate;
+	if (arg->disable)
+		((u16 *) p)[1] = 0;
+	else
+		((u16 *) p)[1] = __cpu_to_le16(arg->skb->len - 4);
+	ret = wsm_write_mib(hw_priv, WSM_MIB_ID_TEMPLATE_FRAME, p,
+			    arg->skb->len, if_id);
+	skb_pull(arg->skb, 4);
+	return ret;
+}
+
 int wsm_scan(struct xradio_common *hw_priv, const struct wsm_scan *arg,
 		int if_id)
 {
@@ -453,9 +487,15 @@ int wsm_scan(struct xradio_common *hw_priv, const struct wsm_scan *arg,
 	wsm_cmd_lock(hw_priv);
 
 	WSM_PUT8(buf, arg->band);
-	WSM_PUT8(buf, arg->scanType);
-	WSM_PUT8(buf, arg->scanFlags);
-	WSM_PUT8(buf, arg->maxTransmitRate);
+	if (xradio_ht40_api(hw_priv)) {
+		/* scan type in bits 7:6, flags in 5:0, then a rate entry */
+		WSM_PUT8(buf, (arg->scanType << 6) | (arg->scanFlags & 0x3f));
+		WSM_PUT16(buf, wsm_legacy_rate_entry(arg->maxTransmitRate));
+	} else {
+		WSM_PUT8(buf, arg->scanType);
+		WSM_PUT8(buf, arg->scanFlags);
+		WSM_PUT8(buf, arg->maxTransmitRate);
+	}
 	WSM_PUT32(buf, arg->autoScanInterval);
 	WSM_PUT8(buf, arg->numOfProbeRequests);
 	WSM_PUT8(buf, arg->numOfChannels);
@@ -1336,7 +1376,19 @@ static int wsm_receive_indication(struct xradio_common *hw_priv,
 
 		rx.status = WSM_GET32(buf);
 		rx.channelNumber = WSM_GET16(buf);
-		rx.rxedRate = WSM_GET8(buf);
+		if (xradio_ht40_api(hw_priv)) {
+			u16 entry = WSM_GET16(buf);
+			u8 index = (entry >> WSM_RATE_ENTRY_INDEX_SHIFT) & 0xf;
+
+			buf->data += 3;		/* reserved */
+			rx.rxedRateEntry = entry;
+			/* old rate index: legacy 0-13, HT MCS from 14 */
+			rx.rxedRate = (entry >> WSM_RATE_ENTRY_MODEM_SHIFT) ==
+				      WSM_RATE_ENTRY_MODEM_HT ? 14 + index : index;
+		} else {
+			rx.rxedRateEntry = 0;
+			rx.rxedRate = WSM_GET8(buf);
+		}
 		rx.rcpiRssi = WSM_GET8(buf);
 		rx.flags = WSM_GET32(buf);
 
