+static inline u32 xradio_dllctrl_convert(u32 dpll)
+{
+	return ((((dpll >> 31) & 0x1) << 0) |		/* config */
+		(((dpll >> 29) & 0x3) << 1) |		/* dither */
+		(((dpll >> 12) & 0x1) << 3) |		/* frac ctrl */
+		(((dpll >> 13) & 0xffff) << 4) |	/* frac */
+		(((dpll >> 4) & 0xff) << 20));		/* divn */
+}
