-static inline int wsm_set_template_frame(struct xradio_common *hw_priv,
-					 struct wsm_template_frame *arg,
-					 int if_id)
+/* HT40 API rate entry: modem type, bandwidth, format flags, rate index */
+#define WSM_RATE_ENTRY_MODEM_SHIFT	14
+#define WSM_RATE_ENTRY_MODEM_LEGACY	0
+#define WSM_RATE_ENTRY_MODEM_HT		1
+#define WSM_RATE_ENTRY_BW_SHIFT		12
+#define WSM_RATE_ENTRY_BW_20M		0
+#define WSM_RATE_ENTRY_BW_40M		1
+#define WSM_RATE_ENTRY_INDEX_SHIFT	4
+#define WSM_RATE_ENTRY_F_SHORT_PRE	BIT(8)
+#define WSM_RATE_ENTRY_F_SGI		BIT(9)
+
+/* Rate entry for a legacy (CCK/OFDM) WSM_TRANSMIT_RATE_ index at 20 MHz */
+static inline u16 wsm_legacy_rate_entry(u8 rate)
 {
-	int ret;
-	u8 *p = skb_push(arg->skb, 4);
-	p[0] = arg->frame_type;
-	p[1] = arg->rate;
-	if (arg->disable)
-		((u16 *) p)[1] = 0;
-	else
-		((u16 *) p)[1] = __cpu_to_le16(arg->skb->len - 4);
-	ret = wsm_write_mib(hw_priv, WSM_MIB_ID_TEMPLATE_FRAME, p,
-			    arg->skb->len, if_id);
-	skb_pull(arg->skb, 4);
-	return ret;
+	if (rate == 0xFF)	/* firmware default */
+		return 0xFF;
+	return (WSM_RATE_ENTRY_MODEM_LEGACY << WSM_RATE_ENTRY_MODEM_SHIFT) |
+	       (WSM_RATE_ENTRY_BW_20M << WSM_RATE_ENTRY_BW_SHIFT) |
+	       (rate << WSM_RATE_ENTRY_INDEX_SHIFT);
 }
 
+int wsm_set_template_frame(struct xradio_common *hw_priv,
+			   struct wsm_template_frame *arg, int if_id);
