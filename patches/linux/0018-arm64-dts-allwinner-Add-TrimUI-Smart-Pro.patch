From f1dd38fc99372b30e7cb7b48899b7dc00c422bd7 Mon Sep 17 00:00:00 2001
From: leow149 <leow149@lucidmail.xyz>
Date: Sun, 1 Nov 2026 00:21:32 +0100
Subject: [PATCH 18/25] arm64: dts: allwinner: Add TrimUI Smart Pro

TrimUI Smart Pro handheld (Allwinner A133, AXP717). Working: MIPI DSI panel
and backlight, buttons and sticks, power and volume keys, battery and charger,
cpufreq, SD card and eMMC, UART console.

Signed-off-by: leow149 <leow149@lucidmail.xyz>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/allwinner/Makefile        |   1 +
 .../allwinner/sun50i-a133-trimui-smartpro.dts | 502 ++++++++++++++++++
 2 files changed, 503 insertions(+)
 create mode 100644 arch/arm64/boot/dts/allwinner/sun50i-a133-trimui-smartpro.dts

diff --git a/arch/arm64/boot/dts/allwinner/Makefile b/arch/arm64/boot/dts/allwinner/Makefile
index aa21f58a4..6132fda32 100644
--- a/arch/arm64/boot/dts/allwinner/Makefile
+++ b/arch/arm64/boot/dts/allwinner/Makefile
@@ -26,6 +26,7 @@ dtb-$(CONFIG_ARCH_SUNXI) += sun50i-h64-remix-mini-pc.dtb
 dtb-$(CONFIG_ARCH_SUNXI) += sun50i-a100-allwinner-perf1.dtb
 dtb-$(CONFIG_ARCH_SUNXI) += sun50i-a133-helperboard.dtb
 dtb-$(CONFIG_ARCH_SUNXI) += sun50i-a133-liontron-h-a133l.dtb
+dtb-$(CONFIG_ARCH_SUNXI) += sun50i-a133-trimui-smartpro.dtb
 dtb-$(CONFIG_ARCH_SUNXI) += sun50i-h5-bananapi-m2-plus.dtb
 dtb-$(CONFIG_ARCH_SUNXI) += sun50i-h5-bananapi-m2-plus-v1.2.dtb
 dtb-$(CONFIG_ARCH_SUNXI) += sun50i-h5-emlid-neutis-n5-devboard.dtb
diff --git a/arch/arm64/boot/dts/allwinner/sun50i-a133-trimui-smartpro.dts b/arch/arm64/boot/dts/allwinner/sun50i-a133-trimui-smartpro.dts
new file mode 100644
index 000000000..5112e0d94
--- /dev/null
+++ b/arch/arm64/boot/dts/allwinner/sun50i-a133-trimui-smartpro.dts
@@ -0,0 +1,502 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * TrimUI Smart Pro handheld (Allwinner A133).
+ *
+ * Values not documented elsewhere (regulator voltages, panel timings and
+ * GPIOs, PWM setup) come from the stock firmware's device tree and its boot
+ * logs.
+ *
+ * Not described yet: WiFi/BT (XR829 on mmc1), GPU.
+ */
+
+/dts-v1/;
+
+#include "sun50i-a100.dtsi"
+#include "sun50i-a100-cpu-opp.dtsi"
+
+#include <dt-bindings/clock/sun8i-de2.h>
+#include <dt-bindings/clock/sun8i-tcon-top.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/linux-event-codes.h>
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/reset/sun8i-de2.h>
+
+/ {
+	model = "TrimUI Smart Pro";
+	chassis-type = "handset";
+	compatible = "trimui,smart-pro", "allwinner,sun50i-a100";
+
+	aliases {
+		serial0 = &uart0;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		/*
+		 * TF-A BL31 runs from the start of DRAM on this board. U-Boot
+		 * only reserves it in its own copy of the DT; without this,
+		 * Linux reuses the memory and later PSCI calls hang.
+		 */
+		bl31@40000000 {
+			reg = <0x0 0x40000000 0x0 0x40000>;
+			no-map;
+		};
+	};
+
+	battery: battery {
+		compatible = "simple-battery";
+		charge-full-design-microamp-hours = <5000000>;
+		constant-charge-current-max-microamp = <1000000>;
+		voltage-max-design-microvolt = <4200000>;
+	};
+
+	reg_vcc5v: regulator-vcc5v {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc-5v";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		regulator-always-on;
+	};
+
+	/* 5 V for the stick boards: button MCUs and stick LEDs ("led_5v" on stock). */
+	reg_vcc_pad: regulator-vcc-pad {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc-pad";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		gpio = <&pio 3 11 GPIO_ACTIVE_HIGH>; /* PD11 */
+		enable-active-high;
+		vin-supply = <&reg_vcc5v>;
+	};
+
+	de: display-engine {
+		compatible = "allwinner,sun50i-a133-display-engine",
+			     "allwinner,sun50i-a64-display-engine";
+		allwinner,pipelines = <&mixer0>;
+		status = "okay";
+	};
+
+	/* PWM channel 0, 50 kHz, normal polarity. */
+	backlight: backlight {
+		compatible = "pwm-backlight";
+		pwms = <&pwm 0 20000 0>;
+		default-brightness-level = <200>;
+		power-supply = <&reg_cldo4>;
+	};
+};
+
+&cpu0 {
+	cpu-supply = <&reg_dcdc1>;
+};
+
+/* SD card slot */
+/*
+ * Volume keys on the LRADC, voltages as measured. Both pressed together
+ * reads about 471 mV and reports Volume Up.
+ */
+&lradc {
+	vref-supply = <&reg_aldo4>;
+	status = "okay";
+
+	button-643 {
+		label = "Volume Up";
+		linux,code = <KEY_VOLUMEUP>;
+		channel = <0>;
+		voltage = <643000>;
+	};
+
+	button-879 {
+		label = "Volume Down";
+		linux,code = <KEY_VOLUMEDOWN>;
+		channel = <0>;
+		voltage = <879000>;
+	};
+};
+
+&mmc0 {
+	bus-width = <4>;
+	vmmc-supply = <&reg_cldo3>;
+	status = "okay";
+};
+
+/* eMMC; the stock firmware also runs it at DDR52, not HS200/HS400. */
+&mmc2 {
+	bus-width = <8>;
+	non-removable;
+	cap-mmc-hw-reset;
+	mmc-ddr-1_8v;
+	vmmc-supply = <&reg_cldo3>;
+	status = "okay";
+};
+
+&r_i2c0 {
+	status = "okay";
+
+	axp717: pmic@34 {
+		compatible = "x-powers,axp717";
+		reg = <0x34>;
+		interrupt-controller;
+		#interrupt-cells = <1>;
+		interrupt-parent = <&r_intc>;
+		interrupts = <0 IRQ_TYPE_LEVEL_LOW>;
+
+		vin1-supply = <&reg_vcc5v>;
+		vin2-supply = <&reg_vcc5v>;
+		vin3-supply = <&reg_vcc5v>;
+		vin4-supply = <&reg_vcc5v>;
+
+		axp_adc: adc {
+			compatible = "x-powers,axp717-adc";
+			#io-channel-cells = <1>;
+		};
+
+		battery_power: battery-power {
+			compatible = "x-powers,axp717-battery-power-supply";
+			monitored-battery = <&battery>;
+		};
+
+		usb_power: usb-power {
+			compatible = "x-powers,axp717-usb-power-supply";
+		};
+
+		/*
+		 * Rails the stock boot loader leaves on are kept always-on, at
+		 * the voltages it programs: most have no consumer described
+		 * here yet, and switching any of them off has hung the board.
+		 */
+		regulators {
+			reg_dcdc1: dcdc1 {
+				regulator-always-on;
+				regulator-min-microvolt = <810000>;
+				regulator-max-microvolt = <1200000>;
+				regulator-name = "vdd-cpu";
+			};
+			reg_dcdc2: dcdc2 {
+				regulator-always-on;
+				regulator-name = "vdd-gpu-sys";
+			};
+			reg_dcdc3: dcdc3 {
+				regulator-always-on;
+				regulator-min-microvolt = <1100000>;
+				regulator-max-microvolt = <1100000>;
+				regulator-name = "vdd-dram";
+			};
+			reg_aldo1: aldo1 {
+				regulator-always-on;
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+			};
+			reg_aldo2: aldo2 {
+				regulator-always-on;
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+			};
+			reg_aldo3: aldo3 {
+				regulator-always-on;
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-name = "vcc-wifi-io";
+			};
+			reg_aldo4: aldo4 {
+				regulator-always-on;
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+			};
+			/* Off at boot on stock, switched by the WiFi/BT driver. */
+			reg_bldo1: bldo1 {
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-name = "vcc-wifi";
+			};
+			reg_bldo2: bldo2 {
+				regulator-always-on;
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+			};
+			reg_bldo3: bldo3 {
+				regulator-always-on;
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+			};
+			reg_bldo4: bldo4 {
+				regulator-always-on;
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+			};
+			/*
+			 * The panel supplies must stay always-on: with them
+			 * switchable the panel stays dark (cause unknown).
+			 */
+			reg_cldo1: cldo1 {
+				regulator-always-on;
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-name = "vcc-lcd-1";
+			};
+			reg_cldo2: cldo2 { };
+			reg_cldo3: cldo3 {
+				regulator-always-on;
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-name = "vcc-io";
+			};
+			reg_cldo4: cldo4 {
+				regulator-always-on;
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-name = "vcc-lcd-2";
+			};
+			reg_cpusldo: cpusldo {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <900000>;
+				regulator-max-microvolt = <900000>;
+			};
+		};
+	};
+};
+
+&uart0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart0_pb_pins>;
+	status = "okay";
+};
+
+/* Buttons and sticks: one microcontroller per side, each on its own UART. */
+&uart3 {
+	compatible = "allwinner,sun50i-a100-uart", "snps,dw-apb-uart";
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart3_pd_pins>;
+	status = "okay";
+
+	pad_right: gamepad {
+		compatible = "trimui,smart-pro-pad-right";
+		power-supply = <&reg_vcc_pad>;
+	};
+};
+
+&uart4 {
+	compatible = "allwinner,sun50i-a100-uart", "snps,dw-apb-uart";
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart4_pd_pins>;
+	status = "okay";
+
+	gamepad {
+		compatible = "trimui,smart-pro-pad-left";
+		power-supply = <&reg_vcc_pad>;
+		trimui,right-pad = <&pad_right>;
+	};
+};
+
+/*
+ * USB-C port in peripheral mode. Stock runs it as OTG with ID on PH8 and VBUS
+ * sensed by the AXP717; neither is described yet.
+ */
+&usb_otg {
+	dr_mode = "peripheral";
+	status = "okay";
+};
+
+&usbphy {
+	status = "okay";
+};
+
+&{/soc} {
+	/* DPSS TOP: routes mixer0 to TCON_LCD0 and gates the DSI clock. */
+	dpss_top0: dpss-top@6510000 {
+		compatible = "allwinner,sun50i-a133-tcon-top";
+		reg = <0x06510000 0x1000>;
+		/* No TCON TV on this SoC; "tcon-tv0" only satisfies the binding. */
+		clocks = <&ccu CLK_BUS_DPSS_TOP0>,
+			 <&ccu CLK_TCON_LCD>,
+			 <&ccu CLK_MIPI_DSI>;
+		clock-names = "bus", "tcon-tv0", "dsi";
+		clock-output-names = "tcon-top-tv0", "tcon-top-dsi";
+		resets = <&ccu RST_BUS_DPSS_TOP0>;
+		#clock-cells = <1>;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			dpss_top0_mixer0_in: port@0 {
+				reg = <0>;
+
+				dpss_top0_in_mixer0: endpoint {
+					remote-endpoint = <&mixer0_out_dpss_top0>;
+				};
+			};
+
+			dpss_top0_mixer0_out: port@1 {
+				reg = <1>;
+
+				dpss_top0_out_tcon_lcd0: endpoint {
+					remote-endpoint = <&tcon_lcd0_in_dpss_top0>;
+				};
+			};
+		};
+	};
+
+	/*
+	 * Display engine. As on A64, SRAM C has to be claimed for the DE,
+	 * otherwise this register space is shadowed by the SRAM.
+	 */
+	bus@6000000 {
+		compatible = "allwinner,sun50i-a100-de2",
+			     "allwinner,sun50i-a64-de2";
+		reg = <0x06000000 0x400000>;
+		allwinner,sram = <&de2_sram 1>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges = <0 0x06000000 0x400000>;
+
+		/* DE clock/reset block, same layout as H6. */
+		display_clocks: clock@0 {
+			compatible = "allwinner,sun50i-h6-de3-clk";
+			reg = <0x0 0x10000>;
+			clocks = <&ccu CLK_BUS_DE>, <&ccu CLK_DE>;
+			clock-names = "bus", "mod";
+			resets = <&ccu RST_BUS_DE>;
+			#clock-cells = <1>;
+			#reset-cells = <1>;
+		};
+
+		mixer0: mixer@100000 {
+			compatible = "allwinner,sun50i-a133-de2-mixer-0";
+			reg = <0x100000 0x100000>;
+			clocks = <&display_clocks CLK_BUS_MIXER0>,
+				 <&display_clocks CLK_MIXER0>;
+			clock-names = "bus", "mod";
+			resets = <&display_clocks RST_MIXER0>;
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				mixer0_out: port@1 {
+					reg = <1>;
+
+					mixer0_out_dpss_top0: endpoint {
+						remote-endpoint = <&dpss_top0_in_mixer0>;
+					};
+				};
+			};
+		};
+	};
+
+	tcon_lcd0: lcd-controller@6511000 {
+		compatible = "allwinner,sun50i-a133-tcon-lcd",
+			     "allwinner,sun8i-a83t-tcon-lcd";
+		reg = <0x06511000 0x1000>;
+		/*
+		 * The stock disp node lists SPI 69, 70 and 68 for TCON_LCD0,
+		 * TCON_LCD1 and DSI.
+		 */
+		interrupts = <GIC_SPI 69 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&ccu CLK_BUS_TCON_LCD>, <&ccu CLK_TCON_LCD>;
+		clock-names = "ahb", "tcon-ch0";
+		clock-output-names = "tcon-pixel-clock";
+		resets = <&ccu RST_BUS_TCON_LCD>;
+		reset-names = "lcd";
+		#clock-cells = <0>;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			tcon_lcd0_in: port@0 {
+				reg = <0>;
+
+				tcon_lcd0_in_dpss_top0: endpoint {
+					remote-endpoint = <&dpss_top0_out_tcon_lcd0>;
+				};
+			};
+
+			tcon_lcd0_out: port@1 {
+				reg = <1>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				/* endpoint 0 would be taken as a directly attached panel */
+				tcon_lcd0_out_dsi0: endpoint@1 {
+					reg = <1>;
+					remote-endpoint = <&dsi0_in_tcon_lcd0>;
+				};
+			};
+		};
+	};
+
+	dsi0: dsi@6504000 {
+		compatible = "allwinner,sun50i-a100-mipi-dsi";
+		reg = <0x06504000 0x1000>;
+		interrupts = <GIC_SPI 68 IRQ_TYPE_LEVEL_HIGH>;
+		/* "mod" goes through the DPSS TOP DSI gate, as on D1. */
+		clocks = <&ccu CLK_BUS_MIPI_DSI>, <&dpss_top0 CLK_TCON_TOP_DSI>;
+		clock-names = "bus", "mod";
+		resets = <&ccu RST_BUS_MIPI_DSI>;
+		phys = <&dphy0>;
+		phy-names = "dphy";
+		status = "okay";
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port {
+			dsi0_in_tcon_lcd0: endpoint {
+				remote-endpoint = <&tcon_lcd0_out_dsi0>;
+			};
+		};
+
+		panel@0 {
+			compatible = "orisetech,otm1289a";
+			reg = <0>;
+			reset-gpios = <&pio 3 22 GPIO_ACTIVE_LOW>; /* PD22 */
+			/* Portrait panel, top edge at the left of the landscape device. */
+			rotation = <270>;
+			power-supply = <&reg_cldo1>;
+			backlight = <&backlight>;
+		};
+	};
+
+	dphy0: phy@6505000 {
+		compatible = "allwinner,sun50i-a100-mipi-dphy";
+		reg = <0x06505000 0x1000>;
+		interrupts = <GIC_SPI 100 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&ccu CLK_BUS_MIPI_DSI>, <&ccu CLK_MIPI_DSI>;
+		clock-names = "bus", "mod";
+		resets = <&ccu RST_BUS_MIPI_DSI>;
+		#phy-cells = <0>;
+	};
+
+	pwm: pwm@300a000 {
+		compatible = "allwinner,sun50i-a133-pwm";
+		reg = <0x0300a000 0x400>;
+		clocks = <&ccu CLK_BUS_PWM>;
+		clock-names = "bus";
+		resets = <&ccu RST_BUS_PWM>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pwm0_pins>;
+		#pwm-cells = <3>;
+	};
+};
+
+&pio {
+	pwm0_pins: pwm0-pins {
+		pins = "PD23";
+		function = "pwm0";
+	};
+};
+
+&uart3_pd_pins {
+	bias-pull-up;
+};
+
+&uart4_pd_pins {
+	bias-pull-up;
+};
-- 
2.56.0

