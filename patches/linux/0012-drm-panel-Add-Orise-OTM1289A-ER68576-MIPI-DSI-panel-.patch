+
+/*
+ * ER68576 init table from vendor U-Boot. Like the OTM1289A table it ends
+ * before sleep-out/display-on, which otm1289a_init_sequence_send() adds.
+ */
+static const struct otm1289a_init_cmd er68576_init_sequence[] = {
+	OTM1289A_CMD(0x36, 0x14),
+	OTM1289A_CMD(0xe0, 0xab, 0xba),
+	OTM1289A_CMD(0xe1, 0xba, 0xab),
+	OTM1289A_CMD(0xb1, 0x10, 0x01, 0x47, 0xff),
+	OTM1289A_CMD(0xb2, 0x09, 0x0e, 0x01, 0x50, 0x50, 0x14),
+	OTM1289A_CMD(0xb3, 0x56, 0xd2, 0x00),
+	OTM1289A_CMD(0xb4, 0x7a, 0x60, 0x04),
+	OTM1289A_CMD(0xb6, 0xbe, 0x00, 0x00, 0x10, 0x00, 0x10, 0x00),
+	OTM1289A_CMD(0xb8, 0x05, 0x12, 0x29, 0x49, 0x48, 0x00, 0x00),
+	OTM1289A_CMD(0xb9, 0x7c, 0x6a, 0x5e, 0x52, 0x4f, 0x41, 0x45, 0x31,
+			   0x4c, 0x4c, 0x4c, 0x67, 0x53, 0x58, 0x4d, 0x48,
+			   0x35, 0x1d, 0x06, 0x7c, 0x6a, 0x5e, 0x52, 0x4f,
+			   0x41, 0x45, 0x31, 0x4c, 0x4c, 0x4c, 0x67, 0x53,
+			   0x58, 0x4d, 0x48, 0x35, 0x1d, 0x06),
+	OTM1289A_CMD(0xc0, 0x54, 0x32, 0x23, 0x45, 0x33, 0x33, 0x33, 0x33,
+			   0x10, 0x04, 0x90, 0x04, 0x0f, 0x00, 0x00, 0xc0),
+	OTM1289A_CMD(0xc1, 0x32, 0x94, 0x02, 0x87, 0x10, 0x04, 0x90, 0x04,
+			   0x54, 0x00),
+	OTM1289A_CMD(0xc2, 0x73, 0x09, 0x08, 0x89, 0x08, 0x11, 0x22, 0x33,
+			   0x44, 0x82, 0x18, 0x00),
+	OTM1289A_CMD(0xc3, 0x8b, 0x49, 0x13, 0x11, 0x0f, 0x0d, 0x00, 0x00,
+			   0x00, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02,
+			   0x02, 0x02, 0x05, 0x07, 0x02, 0x02),
+	OTM1289A_CMD(0xc4, 0x0a, 0x08, 0x12, 0x10, 0x0e, 0x0c, 0x00, 0x00,
+			   0x00, 0x02, 0x02, 0x02, 0x02, 0x02, 0x00, 0x02,
+			   0x02, 0x02, 0x04, 0x06, 0x02, 0x02),
