+// SPDX-License-Identifier: GPL-2.0
+/*
+ * DRM driver for the 720x1280 MIPI-DSI panel module of the TrimUI Smart Pro
+ * (Allwinner A133). The module ships with different controllers; the stock
+ * boot loader reads the controller ID and picks an init table. Tables are
+ * provided for the Orise Tech OTM1289A and the ER68576.
+ *
+ * Init tables and timings come from the stock firmware (vendor U-Boot and
+ * kernel binaries, and the vendor device tree).
+ */
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/regulator/consumer.h>
+
+#include <video/mipi_display.h>
+
+#include <drm/drm_connector.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_of.h>
+#include <drm/drm_panel.h>
+
+#define OTM1289A_HDISPLAY	720
+#define OTM1289A_VDISPLAY	1280
+
+struct otm1289a {
+	struct device *dev;
+	struct drm_panel panel;
+	struct gpio_desc *reset_gpio;
+	struct regulator *supply;
+	enum drm_panel_orientation orientation;
+	bool prepared;
+};
+
+/*
+ * Timings from the vendor device tree (lcd0 node): dclk 69 MHz,
+ * ht=880 hbp=88 hspw=4, vt=1320 vbp=9 vspw=4. Allwinner's hbp/vbp count
+ * sync + back porch, so the DRM front porches are 880-720-88 = 72 and
+ * 1320-1280-9 = 31. With these, sun6i_dsi_setup_burst() programs
+ * DRQ_SET = (72-20)*24/32 = 39, the value read back from the stock
+ * firmware.
+ */
+static const struct drm_display_mode otm1289a_mode = {
+	.clock = 69000,
+	.hdisplay = OTM1289A_HDISPLAY,
+	.hsync_start = OTM1289A_HDISPLAY + 72,
+	.hsync_end = OTM1289A_HDISPLAY + 72 + 4,
+	.htotal = 880,
+	.vdisplay = OTM1289A_VDISPLAY,
+	.vsync_start = OTM1289A_VDISPLAY + 31,
+	.vsync_end = OTM1289A_VDISPLAY + 31 + 4,
+	.vtotal = 1320,
+	.width_mm = 65,
+	.height_mm = 116,
+	.type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+};
+
+struct otm1289a_init_cmd {
+	u8 cmd;
+	u8 len;
+	u8 data[38];
+};
+
+#define OTM1289A_CMD(_cmd, ...) \
+	{ .cmd = (_cmd), .len = sizeof((u8[]) { __VA_ARGS__ }), .data = { __VA_ARGS__ } }
+
