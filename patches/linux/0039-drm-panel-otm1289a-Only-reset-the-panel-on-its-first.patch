From 0ecf45a73002a046c910d64ff8fe1681581e05b8 Mon Sep 17 00:00:00 2001
From: leow149 <leow149@lucidmail.xyz>
Date: Sun, 1 Nov 2026 11:06:24 +0100
Subject: [PATCH 039/106] drm/panel: otm1289a: Only reset the panel on its
 first power-up

On the ER68576 a second reset breaks the panel: it still answers DCS
commands and takes the whole init sequence, but stays dark, whatever the
delay after reset. Without the reset it comes back from sleep-in fine. The
stock boot loader power-cycles the panel before each reset, which is not
possible on this board: the panel rails have to stay always-on (with them
switchable the panel stayed dark from boot), so they never go off.

So power up and reset the panel only on its first prepare and keep the
supply enabled from then on (released on remove), matching what the
hardware does; later prepares only send the init sequence, which ends with
sleep-out and display-on, and disable leaves the panel in sleep mode. This
makes blanking and system suspend/resume work. Drop the unused "prepared"
flag and the empty enable and unprepare callbacks while at it.

Unbinding through sysfs is disabled: after a rebind the panel would need
a power cycle that the board cannot do.

For the same reason the driver can only be built in; unbinding the DSI
host, which removes the panel device, is not supported either.

Signed-off-by: leow149 <leow149@lucidmail.xyz>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/gpu/drm/panel/Kconfig                 |  8 +-
 .../gpu/drm/panel/panel-orisetech-otm1289a.c  | 79 +++++++++++--------
 2 files changed, 51 insertions(+), 36 deletions(-)

diff --git a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
index fab1ed5f4..03dbaeb3c 100644
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -759,13 +759,17 @@ config DRM_PANEL_ORISETECH_OTM8009A
 	  otm8009a 480x800 dsi 2dl panel.
 
 config DRM_PANEL_ORISETECH_OTM1289A
-	tristate "Orise Technology otm1289a 720x1280 dsi panel"
+	bool "Orise Technology otm1289a 720x1280 dsi panel"
 	depends on OF
-	depends on DRM_MIPI_DSI
+	depends on DRM_MIPI_DSI=y
 	help
 	  Say Y here if you want to enable support for Orise Technology
 	  otm1289a 720x1280 dsi panel, as used on the TrimUI Smart Pro.
 
+	  Built-in only: the panel is reset only once, so it cannot be
+	  brought back after the driver is unloaded or unbound, which also
+	  happens when the DSI host driver is unbound.
+
 config DRM_PANEL_OSD_OSD101T2587_53TS
 	tristate "OSD OSD101T2587-53TS DSI 1920x1200 video mode panel"
 	depends on OF
diff --git a/drivers/gpu/drm/panel/panel-orisetech-otm1289a.c b/drivers/gpu/drm/panel/panel-orisetech-otm1289a.c
index 2b3df810c..5aaf195e4 100644
--- a/drivers/gpu/drm/panel/panel-orisetech-otm1289a.c
+++ b/drivers/gpu/drm/panel/panel-orisetech-otm1289a.c
@@ -32,7 +32,7 @@ struct otm1289a {
 	struct gpio_desc *reset_gpio;
 	struct regulator *supply;
 	enum drm_panel_orientation orientation;
-	bool prepared;
+	bool powered_up;
 };
 
 /*
@@ -277,30 +277,26 @@ static int otm1289a_disable(struct drm_panel *panel)
 	return 0;
 }
 
-static int otm1289a_unprepare(struct drm_panel *panel)
-{
-	struct otm1289a *ctx = panel_to_otm1289a(panel);
-
-	if (ctx->reset_gpio) {
-		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
-		msleep(20);
-	}
-
-	regulator_disable(ctx->supply);
-
-	ctx->prepared = false;
-
-	return 0;
-}
-
-static int otm1289a_prepare(struct drm_panel *panel)
+/*
+ * The panel is powered up and reset only once, on its first prepare, and from
+ * then on only put into and taken out of sleep mode (disable/prepare).
+ *
+ * The ER68576 does not survive a second reset pulse without a power cycle in
+ * between: it still answers DCS commands and takes the whole init sequence,
+ * but stays dark, whatever the delay after the reset. The stock boot loader
+ * power-cycles the panel before every reset. That cannot be done here: on
+ * the TrimUI Smart Pro the panel rails (AXP717 CLDO1/CLDO4) have to stay on
+ * (with them switchable the panel stayed dark from boot, see the board DT),
+ * so they never actually go off. The supply is therefore kept enabled after
+ * the first power-up as well, matching what the hardware does.
+ */
+static int otm1289a_power_up(struct otm1289a *ctx)
 {
-	struct otm1289a *ctx = panel_to_otm1289a(panel);
 	int ret;
 
 	ret = regulator_enable(ctx->supply);
 	if (ret < 0) {
-		dev_err(panel->dev, "failed to enable supply: %d\n", ret);
+		dev_err(ctx->dev, "failed to enable supply: %d\n", ret);
 		return ret;
 	}
 
@@ -312,21 +308,26 @@ static int otm1289a_prepare(struct drm_panel *panel)
 		msleep(100);
 	}
 
-	ret = otm1289a_init_sequence_send(ctx);
-	if (ret) {
-		dev_err(panel->dev, "init sequence failed: %d\n", ret);
-		regulator_disable(ctx->supply);
-		return ret;
-	}
-
-	ctx->prepared = true;
-
+	ctx->powered_up = true;
 	return 0;
 }
 
-static int otm1289a_enable(struct drm_panel *panel)
+static int otm1289a_prepare(struct drm_panel *panel)
 {
-	return 0;
+	struct otm1289a *ctx = panel_to_otm1289a(panel);
+	int ret;
+
+	if (!ctx->powered_up) {
+		ret = otm1289a_power_up(ctx);
+		if (ret)
+			return ret;
+	}
+
+	ret = otm1289a_init_sequence_send(ctx);
+	if (ret)
+		dev_err(panel->dev, "init sequence failed: %d\n", ret);
+
+	return ret;
 }
 
 static int otm1289a_get_modes(struct drm_panel *panel,
@@ -363,9 +364,7 @@ static enum drm_panel_orientation otm1289a_get_orientation(struct drm_panel *pan
 
 static const struct drm_panel_funcs otm1289a_drm_funcs = {
 	.disable   = otm1289a_disable,
-	.unprepare = otm1289a_unprepare,
 	.prepare   = otm1289a_prepare,
-	.enable    = otm1289a_enable,
 	.get_modes = otm1289a_get_modes,
 	.get_orientation = otm1289a_get_orientation,
 };
@@ -403,7 +402,7 @@ static int otm1289a_probe(struct mipi_dsi_device *dsi)
 	mipi_dsi_set_drvdata(dsi, ctx);
 	ctx->dev = dev;
 
-	/* PWM backlight, controlled through the panel's prepare/unprepare. */
+	/* PWM backlight, switched by drm_panel_enable()/drm_panel_disable(). */
 	ret = drm_panel_of_backlight(&ctx->panel);
 	if (ret)
 		return ret;
@@ -431,6 +430,9 @@ static void otm1289a_remove(struct mipi_dsi_device *dsi)
 
 	mipi_dsi_detach(dsi);
 	drm_panel_remove(&ctx->panel);
+
+	if (ctx->powered_up)
+		regulator_disable(ctx->supply);
 }
 
 static const struct of_device_id orisetech_otm1289a_of_match[] = {
@@ -445,6 +447,15 @@ static struct mipi_dsi_driver orisetech_otm1289a_driver = {
 	.driver = {
 		.name = "panel-orisetech-otm1289a",
 		.of_match_table = orisetech_otm1289a_of_match,
+		/*
+		 * The panel is only reset on its first power-up (see
+		 * otm1289a_power_up()) and cannot be brought back after a
+		 * rebind without a power cycle, which the board cannot do.
+		 * For the same reason the driver is built-in only; unbinding
+		 * the DSI host (which removes the panel device) is not
+		 * supported either.
+		 */
+		.suppress_bind_attrs = true,
 	},
 };
 module_mipi_dsi_driver(orisetech_otm1289a_driver);
