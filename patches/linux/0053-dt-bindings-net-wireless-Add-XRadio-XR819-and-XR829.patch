From 445579b8ede34c90a3c7f63dd08c3c53942d230c Mon Sep 17 00:00:00 2001
From: leow149 <leow149@lucidmail.xyz>
Date: Sun, 15 Nov 2026 16:31:28 +0100
Subject: [PATCH 053/106] dt-bindings: net: wireless: Add XRadio XR819 and
 XR829

Add the XRadio vendor prefix and a binding for the WLAN function of the
XR819 and XR829 SDIO chips, as used by the xradio driver.

Signed-off-by: leow149 <leow149@lucidmail.xyz>
---
 .../bindings/net/wireless/xradio,xr819.yaml   | 61 +++++++++++++++++++
 .../devicetree/bindings/vendor-prefixes.yaml  |  2 +
 2 files changed, 63 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/net/wireless/xradio,xr819.yaml

diff --git a/Documentation/devicetree/bindings/net/wireless/xradio,xr819.yaml b/Documentation/devicetree/bindings/net/wireless/xradio,xr819.yaml
new file mode 100644
index 000000000..284222f0f
--- /dev/null
+++ b/Documentation/devicetree/bindings/net/wireless/xradio,xr819.yaml
@@ -0,0 +1,61 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/net/wireless/xradio,xr819.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: XRadio XR819 and XR829 SDIO WLAN
+
+maintainers:
+  - leow149 <leow149@lucidmail.xyz>
+
+description:
+  The XRadio XR819 (WLAN) and XR829 (WLAN and Bluetooth) chips, found on
+  Allwinner based boards. This node describes the WLAN function on the SDIO
+  bus; power and reset are handled by the MMC host (mmc-pwrseq, vmmc-supply).
+
+allOf:
+  - $ref: ieee80211.yaml#
+
+properties:
+  compatible:
+    enum:
+      - xradio,xr819
+      - xradio,xr829
+
+  reg:
+    description: SDIO function number
+    const: 1
+
+  interrupts:
+    maxItems: 1
+    description: Out-of-band host wake interrupt
+
+  interrupt-names:
+    const: host-wake
+
+  local-mac-address: true
+  mac-address: true
+
+required:
+  - compatible
+  - reg
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    mmc {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        wifi@1 {
+            compatible = "xradio,xr829";
+            reg = <1>;
+            interrupt-parent = <&r_pio>;
+            interrupts = <0 6 IRQ_TYPE_EDGE_RISING>;
+            interrupt-names = "host-wake";
+        };
+    };
diff --git a/Documentation/devicetree/bindings/vendor-prefixes.yaml b/Documentation/devicetree/bindings/vendor-prefixes.yaml
index a5e32e4bf..4933dd7e7 100644
--- a/Documentation/devicetree/bindings/vendor-prefixes.yaml
+++ b/Documentation/devicetree/bindings/vendor-prefixes.yaml
@@ -1939,6 +1939,8 @@ patternProperties:
     description: Xilinx
   "^xnano,.*":
     description: Xnano
+  "^xradio,.*":
+    description: XRadio Technology Co., Ltd.
   "^xunlong,.*":
     description: Shenzhen Xunlong Software CO.,Limited
   "^xylon,.*":
