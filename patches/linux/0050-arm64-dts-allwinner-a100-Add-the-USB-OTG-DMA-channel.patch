From d74066df3e0f21f366be5e4c3c40f892113e3634 Mon Sep 17 00:00:00 2001
From: leow149 <leow149@lucidmail.xyz>
Date: Sun, 1 Nov 2026 13:46:51 +0100
Subject: [PATCH 050/106] arm64: dts: allwinner: a100: Add the USB OTG DMA
 channels

DMA request lines 30-34 are the OTG endpoints 1-5, in both directions.

Only the TX channels are listed: the driver moves RX data by PIO, so RX
request lines would only be requested to stay unused. The binding still
allows them, as the hardware has them.

Signed-off-by: leow149 <leow149@lucidmail.xyz>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/allwinner/sun50i-a100.dtsi | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun50i-a100.dtsi b/arch/arm64/boot/dts/allwinner/sun50i-a100.dtsi
index 3d92e7bbe..6a6ec50aa 100644
--- a/arch/arm64/boot/dts/allwinner/sun50i-a100.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun50i-a100.dtsi
@@ -520,6 +520,10 @@ usb_otg: usb@5100000 {
 			phys = <&usbphy 0>;
 			phy-names = "usb";
 			extcon = <&usbphy 0>;
+			/* TX only: the driver moves RX data by PIO. */
+			dmas = <&dma 30>, <&dma 31>, <&dma 32>, <&dma 33>,
+			       <&dma 34>;
+			dma-names = "ep1tx", "ep2tx", "ep3tx", "ep4tx", "ep5tx";
 			status = "disabled";
 		};
 
