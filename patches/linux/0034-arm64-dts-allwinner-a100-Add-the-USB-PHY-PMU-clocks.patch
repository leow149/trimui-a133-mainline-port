From c4ca18a2857d73b5588a0d89656ad767cf18faa5 Mon Sep 17 00:00:00 2001
From: leow149 <leow149@lucidmail.xyz>
Date: Sun, 1 Nov 2026 11:45:09 +0100
Subject: [PATCH 34/56] arm64: dts: allwinner: a100: Add the USB PHY PMU clocks

The SIDDQ bits of PHY0 and PHY1 sit in the EHCI0/EHCI1 register blocks, which
are only writable with their bus clocks running.

Signed-off-by: leow149 <leow149@lucidmail.xyz>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/allwinner/sun50i-a100.dtsi | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/allwinner/sun50i-a100.dtsi b/arch/arm64/boot/dts/allwinner/sun50i-a100.dtsi
index 7b07bf602..586949ed5 100644
--- a/arch/arm64/boot/dts/allwinner/sun50i-a100.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun50i-a100.dtsi
@@ -533,9 +533,13 @@ usbphy: phy@5100400 {
 				    "pmu0",
 				    "pmu1";
 			clocks = <&ccu CLK_USB_PHY0>,
-				 <&ccu CLK_USB_PHY1>;
+				 <&ccu CLK_USB_PHY1>,
+				 <&ccu CLK_BUS_EHCI0>,
+				 <&ccu CLK_BUS_EHCI1>;
 			clock-names = "usb0_phy",
-				      "usb1_phy";
+				      "usb1_phy",
+				      "pmu0_clk",
+				      "pmu1_clk";
 			resets = <&ccu RST_USB_PHY0>,
 				 <&ccu RST_USB_PHY1>;
 			reset-names = "usb0_reset",
-- 
