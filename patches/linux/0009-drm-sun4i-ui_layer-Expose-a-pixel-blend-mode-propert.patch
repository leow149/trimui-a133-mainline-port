From 9b087fab9e4d98bf26024d435e03b6dca3c7cb97 Mon Sep 17 00:00:00 2001
From: leow149 <leow149@lucidmail.xyz>
Date: Sun, 1 Nov 2026 00:21:27 +0100
Subject: [PATCH 009/106] drm/sun4i: ui_layer: Expose a pixel blend mode
 property

The UI planes advertise formats with alpha but had no pixel blend mode
property, so DRM assumed premultiplied alpha, which the blender is never
set up for, and warned about it at every boot (drm_mode_config_validate).
The blender does coverage blending; expose exactly that.

This is not specific to the A133: the driver never programs
premultiplied blending on any DE2/DE3 mixer, and
validate_blend_mode_for_alpha_formats() WARNs at boot on every SoC whose
UI planes expose alpha formats, so the property is added for all of
them.

Assisted-by: Claude Opus 5.5
Signed-off-by: leow149 <leow149@lucidmail.xyz>
---
 drivers/gpu/drm/sun4i/sun8i_ui_layer.c | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/drivers/gpu/drm/sun4i/sun8i_ui_layer.c b/drivers/gpu/drm/sun4i/sun8i_ui_layer.c
index 00756ab78..36db63277 100644
--- a/drivers/gpu/drm/sun4i/sun8i_ui_layer.c
+++ b/drivers/gpu/drm/sun4i/sun8i_ui_layer.c
@@ -283,6 +283,18 @@ struct sun8i_layer *sun8i_ui_layer_init_one(struct drm_device *drm,
 		return ERR_PTR(ret);
 	}
 
+	/*
+	 * The blender is never switched to premultiplied mode, so pixel alpha
+	 * is applied as coverage. Say so instead of leaving userspace to
+	 * assume the premultiplied default.
+	 */
+	ret = drm_plane_create_blend_mode_property(&layer->plane,
+						   BIT(DRM_MODE_BLEND_COVERAGE));
+	if (ret) {
+		dev_err(drm->dev, "Couldn't add blend mode property\n");
+		return ERR_PTR(ret);
+	}
+
 	ret = drm_plane_create_zpos_property(&layer->plane, index,
 					     0, plane_cnt - 1);
 	if (ret) {
