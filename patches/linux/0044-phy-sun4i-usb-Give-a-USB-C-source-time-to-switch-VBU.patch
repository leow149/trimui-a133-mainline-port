From ac01dcd79ff1649dafe9636c31185b515acc5f64 Mon Sep 17 00:00:00 2001
From: leow149 <leow149@lucidmail.xyz>
Date: Sun, 8 Nov 2026 12:11:57 +0100
Subject: [PATCH 044/100] phy: sun4i-usb: Give a USB-C source time to switch
 VBUS on before driving it

On the TrimUI Smart Pro the ID pin is driven from the USB-C CC lines by a
circuit we have not identified. It reads low (host) with an OTG adapter,
and also with a USB-C charger on a C-to-C cable; with a C-to-A cable to a
PC it stays high (see "phy: sun4i-usb: Only drive phy0 VBUS while the ID
pin says host"). A USB-C source only switches VBUS on after tCCDebounce
plus tVBUSON (up to ~475 ms), so phy0 saw "host, no external VBUS" and
enabled the AXP717 boost at once. The board then back-fed 5.1 V into the
charger's port, and the charger, which must not switch on while VBUS is
already present, never did: the battery discharged while plugged in.

Let the board DT ask for a delay (allwinner,host-vbus-delay-ms): drive
VBUS only once the ID has said host for that long and no external VBUS
has shown up by then. Without the property nothing changes: VBUS is
driven as soon as the ID says host. phy_power_on() calls inside the delay
window reschedule the detect work, so VBUS still comes on once the delay
is over.

This is a heuristic: a source that takes longer than the delay to switch
its VBUS on still gets back-fed. A PC on a C-to-C cable (ID presumably
low, then external VBUS) was not tested and would end up in host role
without VBUS rather than as a gadget.

Tested with a 1000 ms delay: on a 140 W USB-C charger (C-to-C) the boost
stays off at boot and across an unplug/replug, VBUS comes from the
charger and the battery charges. An OTG adapter with a bus-powered hub
still gets VBUS.

Assisted-by: Claude Opus 5.5
Signed-off-by: leow149 <leow149@lucidmail.xyz>
---
 drivers/phy/allwinner/phy-sun4i-usb.c | 60 ++++++++++++++++++++-------
 1 file changed, 45 insertions(+), 15 deletions(-)

diff --git a/drivers/phy/allwinner/phy-sun4i-usb.c b/drivers/phy/allwinner/phy-sun4i-usb.c
index 24bcab055..cff40a75c 100644
--- a/drivers/phy/allwinner/phy-sun4i-usb.c
+++ b/drivers/phy/allwinner/phy-sun4i-usb.c
@@ -144,6 +144,13 @@ struct sun4i_usb_phy_data {
 	int id_det_irq;
 	int vbus_det_irq;
 	int id_det;
+	/*
+	 * Time to wait after the ID pin goes to host before phy0 drives VBUS
+	 * (allwinner,host-vbus-delay-ms), for boards that derive the ID pin
+	 * from the USB-C CC lines.
+	 */
+	u32 host_vbus_delay_ms;
+	unsigned long host_vbus_after;
 	int vbus_det;
 	struct delayed_work detect;
 };
@@ -508,10 +515,18 @@ static int sun4i_usb_phy_power_on(struct phy *_phy)
 	 * VBUS; the detect work switches it on and off as the ID changes.
 	 * Unknown states (-1, before the first scan) count as "no".
 	 */
-	if (phy->index == 0 && data->id_det_gpio &&
-	    (data->id_det != 0 ||
-	     (sun4i_usb_phy0_have_vbus_det(data) && data->vbus_det != 0)))
-		return 0;
+	if (phy->index == 0 && data->id_det_gpio) {
+		if (data->id_det != 0)
+			return 0;
+		if (sun4i_usb_phy0_have_vbus_det(data) && data->vbus_det != 0)
+			return 0;
+		if (time_before(jiffies, data->host_vbus_after)) {
+			/* The detect work retries once the delay is over. */
+			mod_delayed_work(system_percpu_wq, &data->detect,
+					 data->host_vbus_after - jiffies + 1);
+			return 0;
+		}
+	}
 
 	/* For phy0 only turn on Vbus if we don't have an ext. Vbus */
 	if (phy->index == 0 && sun4i_usb_phy0_have_vbus_det(data) &&
@@ -685,6 +700,9 @@ static void sun4i_usb_phy0_id_vbus_det_scan(struct work_struct *work)
 		sun4i_usb_phy0_set_id_detect(phy0, id_det);
 		data->id_det = id_det;
 		id_notify = true;
+		if (id_det == 0)
+			data->host_vbus_after = jiffies +
+				msecs_to_jiffies(data->host_vbus_delay_ms);
 
 		/* Leaving host role: stop driving VBUS before anything else. */
 		if (id_det != 0 && phy->regulator_on) {
@@ -719,19 +737,21 @@ static void sun4i_usb_phy0_id_vbus_det_scan(struct work_struct *work)
 		/* Re-route PHY0 if necessary */
 		if (data->cfg->phy0_dual_route)
 			sun4i_usb_phy0_reroute(data, id_det);
-
-		/*
-		 * Entering host role: drive VBUS if the HCI asked for it. Take
-		 * phy0->mutex like the PHY core does around ->power_on(), so
-		 * this cannot race with the HCI's phy_power_on()/off().
-		 */
-		mutex_lock(&phy0->mutex);
-		if (data->phy0_init && id_det == 0 && phy->power_wanted &&
-		    !phy->regulator_on)
-			sun4i_usb_phy_power_on(phy0);
-		mutex_unlock(&phy0->mutex);
 	}
 
+	/*
+	 * Host role: drive VBUS if the HCI asked for it. power_on checks the
+	 * ID, external VBUS and the host_vbus_delay_ms window, and reschedules
+	 * this work if the window is still open. Take phy0->mutex like the PHY
+	 * core does around ->power_on(), so this cannot race with the HCI's
+	 * phy_power_on()/phy_power_off() on regulator_on.
+	 */
+	mutex_lock(&phy0->mutex);
+	if (data->phy0_init && data->id_det == 0 && phy->power_wanted &&
+	    !phy->regulator_on)
+		sun4i_usb_phy_power_on(phy0);
+	mutex_unlock(&phy0->mutex);
+
 	if (vbus_notify)
 		extcon_set_state_sync(data->extcon, EXTCON_USB, vbus_det);
 
@@ -812,6 +832,7 @@ static int sun4i_usb_phy_probe(struct platform_device *pdev)
 
 	spin_lock_init(&data->reg_lock);
 	INIT_DELAYED_WORK(&data->detect, sun4i_usb_phy0_id_vbus_det_scan);
+	data->host_vbus_after = jiffies;
 	dev_set_drvdata(dev, data);
 	data->cfg = of_device_get_match_data(dev);
 	if (!data->cfg)
@@ -821,6 +842,15 @@ static int sun4i_usb_phy_probe(struct platform_device *pdev)
 	if (IS_ERR(data->base))
 		return PTR_ERR(data->base);
 
+	/*
+	 * Where the ID pin follows the USB-C CC lines, it also says host for
+	 * a USB-C power source, which only switches its VBUS on after
+	 * tCCDebounce plus tVBUSON (up to ~475 ms). Such boards set a delay so
+	 * that phy0 does not back-feed the source in the meantime.
+	 */
+	device_property_read_u32(dev, "allwinner,host-vbus-delay-ms",
+				 &data->host_vbus_delay_ms);
+
 	data->id_det_gpio = devm_gpiod_get_optional(dev, "usb0_id_det",
 						    GPIOD_IN);
 	if (IS_ERR(data->id_det_gpio)) {
