From 73367ea2074d44546b7e7952699730713d99c6f9 Mon Sep 17 00:00:00 2001
From: leow149 <leow149@lucidmail.xyz>
Date: Sun, 1 Nov 2026 13:46:51 +0100
Subject: [PATCH 39/48] arm64: dts: allwinner: a100: Add the USB OTG DMA
 channels

DMA request lines 30-34 are the OTG endpoints 1-5, in both directions.

Signed-off-by: leow149 <leow149@lucidmail.xyz>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/allwinner/sun50i-a100.dtsi | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun50i-a100.dtsi b/arch/arm64/boot/dts/allwinner/sun50i-a100.dtsi
index 586949ed5..f71fb6693 100644
--- a/arch/arm64/boot/dts/allwinner/sun50i-a100.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun50i-a100.dtsi
@@ -520,6 +520,12 @@ usb_otg: usb@5100000 {
 			phys = <&usbphy 0>;
 			phy-names = "usb";
 			extcon = <&usbphy 0>;
+			dmas = <&dma 30>, <&dma 30>, <&dma 31>, <&dma 31>,
+			       <&dma 32>, <&dma 32>, <&dma 33>, <&dma 33>,
+			       <&dma 34>, <&dma 34>;
+			dma-names = "ep1rx", "ep1tx", "ep2rx", "ep2tx",
+				    "ep3rx", "ep3tx", "ep4rx", "ep4tx",
+				    "ep5rx", "ep5tx";
 			status = "disabled";
 		};
 
-- 
