From db8241d83cfeded822f8b2fba22bcd7a3c4ebd47 Mon Sep 17 00:00:00 2001
From: leow149 <leow149@lucidmail.xyz>
Date: Sun, 8 Nov 2026 12:58:37 +0100
Subject: [PATCH 035/100] dt-bindings: leds: sun50i-a100-ledc: Allow a per-LED
 channel order

A chain can mix LEDs with different channel orders (the TrimUI Smart Pro
has an RGB logo LED in front of GRB stick rings): allow led@0..2 subnodes
giving the colour of each channel.

Assisted-by: Claude Opus 5.5
Signed-off-by: leow149 <leow149@lucidmail.xyz>
---
 .../leds/allwinner,sun50i-a100-ledc.yaml      | 24 +++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/Documentation/devicetree/bindings/leds/allwinner,sun50i-a100-ledc.yaml b/Documentation/devicetree/bindings/leds/allwinner,sun50i-a100-ledc.yaml
index 0b73fe5b6..c53991838 100644
--- a/Documentation/devicetree/bindings/leds/allwinner,sun50i-a100-ledc.yaml
+++ b/Documentation/devicetree/bindings/leds/allwinner,sun50i-a100-ledc.yaml
@@ -97,6 +97,30 @@ patternProperties:
         maximum: 1023
         description: Index of the LED in the series (must be contiguous)
 
+      "#address-cells":
+        const: 1
+
+      "#size-cells":
+        const: 0
+
+    patternProperties:
+      "^led@[0-2]$":
+        type: object
+        $ref: common.yaml#
+        unevaluatedProperties: false
+        description:
+          Optional, for a chain that mixes LED types with different channel
+          orders. Gives the colour of channel N (in the order of
+          allwinner,pixel-format) of this LED. Without these subnodes the
+          channels are red, green and blue in that order.
+        properties:
+          reg:
+            maximum: 2
+
+        required:
+          - reg
+          - color
+
     required:
       - reg
 
