From 771971bfba8e3b06538439fe0fe1b97d8fb76e99 Mon Sep 17 00:00:00 2001
From: leow149 <leow149@lucidmail.xyz>
Date: Sun, 8 Nov 2026 12:58:37 +0100
Subject: [PATCH 90/94] dt-bindings: input: Add TrimUI Smart Pro gamepad

The Smart Pro reads its buttons and sticks from two small MCUs, one per side, each on its own UART. Describe them as serdev children; the left half points at the right one so both feed one input device.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JJfik1hpStPgtN7deJRwXG
Signed-off-by: leow149 <leow149@lucidmail.xyz>
---
 .../bindings/input/trimui,smart-pro-pad.yaml  | 74 +++++++++++++++++++
 1 file changed, 74 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/input/trimui,smart-pro-pad.yaml

diff --git a/Documentation/devicetree/bindings/input/trimui,smart-pro-pad.yaml b/Documentation/devicetree/bindings/input/trimui,smart-pro-pad.yaml
new file mode 100644
index 000000000..af13d6419
--- /dev/null
+++ b/Documentation/devicetree/bindings/input/trimui,smart-pro-pad.yaml
@@ -0,0 +1,74 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/input/trimui,smart-pro-pad.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: TrimUI Smart Pro gamepad
+
+maintainers:
+  - leow149 <leow149@lucidmail.xyz>
+
+description:
+  The buttons and analog sticks of the TrimUI Smart Pro handheld are scanned
+  by two small microcontrollers, one on each side of the device. Each one
+  streams its state over its own UART (19200 8N1, receive only) and is
+  described as a child node of that UART. Both halves are reported through a
+  single input device, which is owned by the left half and fed from both.
+
+properties:
+  compatible:
+    enum:
+      - trimui,smart-pro-pad-left
+      - trimui,smart-pro-pad-right
+
+  power-supply:
+    description: Regulator powering the microcontroller.
+
+  trimui,right-pad:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      Phandle to the node of the right half. The left half links to it and
+      registers the combined input device.
+
+required:
+  - compatible
+  - power-supply
+
+allOf:
+  - $ref: /schemas/serial/serial-peripheral-props.yaml#
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: trimui,smart-pro-pad-left
+    then:
+      required:
+        - trimui,right-pad
+    else:
+      properties:
+        trimui,right-pad: false
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    reg_vcc_pad: regulator-vcc-pad {
+        compatible = "regulator-fixed";
+        regulator-name = "vcc-pad";
+    };
+
+    serial0 {
+        pad_right: mcu {
+            compatible = "trimui,smart-pro-pad-right";
+            power-supply = <&reg_vcc_pad>;
+        };
+    };
+
+    serial1 {
+        mcu {
+            compatible = "trimui,smart-pro-pad-left";
+            power-supply = <&reg_vcc_pad>;
+            trimui,right-pad = <&pad_right>;
+        };
+    };
-- 
