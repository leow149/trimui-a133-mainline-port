From 957d9f165fd44bc356acb38d12cacb8efe5dce5c Mon Sep 17 00:00:00 2001
From: leow149 <leow149@lucidmail.xyz>
Date: Sun, 1 Nov 2026 00:21:28 +0100
Subject: [PATCH 10/39] drm/sun4i: dsi: Decode DCS long read responses

Some panels answer even a one-byte DCS read with a long read response. The
driver returned byte 1 of the header (the word count) as data. Check the RX
flag like the vendor driver, and decode short (1/2 byte) and long responses.

Signed-off-by: leow149 <leow149@lucidmail.xyz>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/gpu/drm/sun4i/sun6i_mipi_dsi.c | 35 ++++++++++++++++----------
 1 file changed, 22 insertions(+), 13 deletions(-)

diff --git a/drivers/gpu/drm/sun4i/sun6i_mipi_dsi.c b/drivers/gpu/drm/sun4i/sun6i_mipi_dsi.c
index d504ae583..64bd36830 100644
--- a/drivers/gpu/drm/sun4i/sun6i_mipi_dsi.c
+++ b/drivers/gpu/drm/sun4i/sun6i_mipi_dsi.c
@@ -927,7 +927,7 @@ static int sun6i_dsi_dcs_write_long(struct sun6i_dsi *dsi,
 static int sun6i_dsi_dcs_read(struct sun6i_dsi *dsi,
 			      const struct mipi_dsi_msg *msg)
 {
-	u32 val;
+	u32 val, ctl;
 	int ret;
 	u8 byte0;
 
@@ -944,23 +944,32 @@ static int sun6i_dsi_dcs_read(struct sun6i_dsi *dsi,
 		return ret;
 	}
 
-	/*
-	 * TODO: There's some bits (reg 0x200, bits 24/25) that
-	 * apparently can be used to check whether the data have been
-	 * received, but I couldn't get it to work reliably.
-	 */
-	regmap_read(dsi->regs, SUN6I_DSI_CMD_CTL_REG, &val);
-	if (val & SUN6I_DSI_CMD_CTL_RX_OVERFLOW)
+	regmap_read(dsi->regs, SUN6I_DSI_CMD_CTL_REG, &ctl);
+	if (!(ctl & SUN6I_DSI_CMD_CTL_RX_FLAG) ||
+	    (ctl & SUN6I_DSI_CMD_CTL_RX_OVERFLOW))
 		return -EIO;
 
 	regmap_read(dsi->regs, SUN6I_DSI_CMD_RX_REG(0), &val);
 	byte0 = val & 0xff;
-	if (byte0 == MIPI_DSI_RX_ACKNOWLEDGE_AND_ERROR_REPORT)
+	switch (byte0) {
+	case MIPI_DSI_RX_DCS_SHORT_READ_RESPONSE_1BYTE:
+	case MIPI_DSI_RX_DCS_SHORT_READ_RESPONSE_2BYTE:
+		((u8 *)msg->rx_buf)[0] = val >> 8;
+		return 1;
+	case MIPI_DSI_RX_DCS_LONG_READ_RESPONSE:
+		/*
+		 * Some panels answer even a one-byte read with a long
+		 * packet: word count in bytes 1-2, payload from RX(1) on.
+		 */
+		if (!((val >> 8) & 0xffff))
+			return -EIO;
+		regmap_read(dsi->regs, SUN6I_DSI_CMD_RX_REG(1), &val);
+		((u8 *)msg->rx_buf)[0] = val & 0xff;
+		return 1;
+	default:
+		/* includes MIPI_DSI_RX_ACKNOWLEDGE_AND_ERROR_REPORT */
 		return -EIO;
-
-	((u8 *)msg->rx_buf)[0] = (val >> 8);
-
-	return 1;
+	}
 }
 
 static int sun6i_dsi_attach(struct mipi_dsi_host *host,
