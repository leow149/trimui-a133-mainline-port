From f144125e8ee28fa227cc2092e070c0b538d15ffb Mon Sep 17 00:00:00 2001
From: leow149 <leow149@lucidmail.xyz>
Date: Mon, 2 Nov 2026 01:05:59 +0100
Subject: [PATCH 51/60] arm64: dts: allwinner: trimui-smart-pro: Run the GPU at
 696 MHz

The stock firmware runs the GE8300 at 700 MHz with vdd-gpu-sys at 0.9 V;
mainline left it at the 432 MHz boot rate of pll-gpu, with the rail at
1.0 V. Use the closest PLL rate to stock.

Signed-off-by: leow149 <leow149@lucidmail.xyz>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../boot/dts/allwinner/sun50i-a133-trimui-smartpro.dts      | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun50i-a133-trimui-smartpro.dts b/arch/arm64/boot/dts/allwinner/sun50i-a133-trimui-smartpro.dts
index de812388b..3538be1a1 100644
--- a/arch/arm64/boot/dts/allwinner/sun50i-a133-trimui-smartpro.dts
+++ b/arch/arm64/boot/dts/allwinner/sun50i-a133-trimui-smartpro.dts
@@ -366,6 +366,12 @@ button-879 {
 };
 
 &gpu {
+	/*
+	 * The stock firmware runs the GPU at 700 MHz with vdd-gpu-sys at
+	 * 0.9 V; the PLL steps in 24 MHz.
+	 */
+	assigned-clocks = <&ccu CLK_GPU>;
+	assigned-clock-rates = <696000000>;
 	status = "okay";
 };
 
-- 
2.56.0

