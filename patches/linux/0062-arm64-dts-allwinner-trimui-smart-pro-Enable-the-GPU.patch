From 6d261a79f30c8ec3448be3f560fac92dc5aee152 Mon Sep 17 00:00:00 2001
From: leow149 <leow149@lucidmail.xyz>
Date: Sun, 1 Nov 2026 19:17:49 +0100
Subject: [PATCH 062/106] arm64: dts: allwinner: trimui-smart-pro: Enable the
 GPU

Enable the GPU node. Its clocks and power domain are already described in
the SoC dtsi.

Assisted-by: Claude Opus 5.5
Signed-off-by: leow149 <leow149@lucidmail.xyz>
---
 arch/arm64/boot/dts/allwinner/sun50i-a133-trimui-smartpro.dts | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun50i-a133-trimui-smartpro.dts b/arch/arm64/boot/dts/allwinner/sun50i-a133-trimui-smartpro.dts
index 6bb7aff3e..b453ab752 100644
--- a/arch/arm64/boot/dts/allwinner/sun50i-a133-trimui-smartpro.dts
+++ b/arch/arm64/boot/dts/allwinner/sun50i-a133-trimui-smartpro.dts
@@ -365,6 +365,10 @@ button-879 {
 	};
 };
 
+&gpu {
+	status = "okay";
+};
+
 &mmc0 {
 	bus-width = <4>;
 	vmmc-supply = <&reg_cldo3>;
