From 3388170fb1af59bd97d2339f9ad097d7ef042161 Mon Sep 17 00:00:00 2001
From: leow149 <leow149@lucidmail.xyz>
Date: Sun, 1 Nov 2026 11:06:24 +0100
Subject: [PATCH 30/35] drm/panel: otm1289a: Only reset the panel on its first
 power-up

On the ER68576 a second reset breaks the panel: it still answers DCS
commands and takes the whole init sequence, but stays dark, whatever the
delay after reset. Without the reset it comes back from sleep-in fine. So
reset it only on its first power-up and leave it in sleep mode when it is
turned off; this makes blanking and system suspend/resume work.

Signed-off-by: leow149 <leow149@lucidmail.xyz>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/gpu/drm/panel/panel-orisetech-otm1289a.c | 15 +++++++++------
 1 file changed, 9 insertions(+), 6 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-orisetech-otm1289a.c b/drivers/gpu/drm/panel/panel-orisetech-otm1289a.c
index 2b3df810c..a7f13c4dc 100644
--- a/drivers/gpu/drm/panel/panel-orisetech-otm1289a.c
+++ b/drivers/gpu/drm/panel/panel-orisetech-otm1289a.c
@@ -33,6 +33,7 @@ struct otm1289a {
 	struct regulator *supply;
 	enum drm_panel_orientation orientation;
 	bool prepared;
+	bool reset_done;
 };
 
 /*
@@ -277,15 +278,16 @@ static int otm1289a_disable(struct drm_panel *panel)
 	return 0;
 }
 
+/*
+ * Only reset the panel on its first power-up. Seen on the ER68576: after a
+ * second reset it still answers DCS commands and takes the whole init
+ * sequence, but stays dark (with any delay after reset). Without the reset it
+ * comes back from sleep-in fine, so it is left in sleep mode instead.
+ */
 static int otm1289a_unprepare(struct drm_panel *panel)
 {
 	struct otm1289a *ctx = panel_to_otm1289a(panel);
 
-	if (ctx->reset_gpio) {
-		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
-		msleep(20);
-	}
-
 	regulator_disable(ctx->supply);
 
 	ctx->prepared = false;
@@ -304,12 +306,13 @@ static int otm1289a_prepare(struct drm_panel *panel)
 		return ret;
 	}
 
-	if (ctx->reset_gpio) {
+	if (ctx->reset_gpio && !ctx->reset_done) {
 		gpiod_set_value_cansleep(ctx->reset_gpio, 0);
 		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
 		msleep(20);
 		gpiod_set_value_cansleep(ctx->reset_gpio, 0);
 		msleep(100);
+		ctx->reset_done = true;
 	}
 
 	ret = otm1289a_init_sequence_send(ctx);
-- 
