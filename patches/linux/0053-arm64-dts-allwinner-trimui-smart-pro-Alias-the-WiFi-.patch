From ef6b56bada095dd767bd7333a571a89b0857018b Mon Sep 17 00:00:00 2001
From: leow149 <leow149@lucidmail.xyz>
Date: Mon, 2 Nov 2026 01:44:53 +0100
Subject: [PATCH 53/56] arm64: dts: allwinner: trimui-smart-pro: Alias the WiFi
 as ethernet0

So that the bootloader can give the XR829 a stable MAC address derived
from the SID, instead of the random one it uses without.

Signed-off-by: leow149 <leow149@lucidmail.xyz>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/allwinner/sun50i-a133-trimui-smartpro.dts | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/allwinner/sun50i-a133-trimui-smartpro.dts b/arch/arm64/boot/dts/allwinner/sun50i-a133-trimui-smartpro.dts
index 3538be1a1..4fdb5b3a3 100644
--- a/arch/arm64/boot/dts/allwinner/sun50i-a133-trimui-smartpro.dts
+++ b/arch/arm64/boot/dts/allwinner/sun50i-a133-trimui-smartpro.dts
@@ -27,6 +27,7 @@ / {
 	compatible = "trimui,smart-pro", "allwinner,sun50i-a100";
 
 	aliases {
+		ethernet0 = &wifi;
 		serial0 = &uart0;
 	};
 
@@ -391,7 +392,7 @@ &mmc1 {
 	vqmmc-supply = <&reg_aldo3>;
 	status = "okay";
 
-	wifi@1 {
+	wifi: wifi@1 {
 		reg = <1>;
 		compatible = "xradio,xr829";
 		interrupt-parent = <&r_pio>;
-- 
2.56.0

