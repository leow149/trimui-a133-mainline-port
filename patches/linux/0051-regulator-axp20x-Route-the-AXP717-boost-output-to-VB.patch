From 364425768a8c440a3eff0c5bde2307bc411d6cfd Mon Sep 17 00:00:00 2001
From: leow149 <leow149@lucidmail.xyz>
Date: Sun, 22 Nov 2026 20:13:11 +0100
Subject: [PATCH 051/100] regulator: axp20x: Route the AXP717 boost output to
 VBUS

Setting only the AXP717 boost enable (MODULE_EN_CONTROL_2 bit 4) runs the
converter, but its output does not reach the VBUS pin: a bus-powered
device on an OTG port stays dead. The vendor AXP2202 (AXP717-compatible)
driver's drivevbus regulator also sets bit 0 of register 0x13, before the
boost enable, clears it first on disable, and reports enabled only when
both bits are set.

Give the boost regulator ops that do the same, through a new
AXP_DESC_OPS() variant of AXP_DESC().

Tested on the TrimUI Smart Pro (A133 + AXP717) with the boost as USB0
VBUS: a bus-powered USB hub with a USB stick and an Ethernet adapter stays
enumerated with only the TrimUI powering it (stick read 32.7 MB/s). With
only bit 4 set, the hub dropped off.

Other AXP717 boards: only the Anbernic RG35XX 2024 describes the boost,
without consumers. Enable now routes the boost to VBUS, which is the
only use of the AXP717 boost (it has no other output). A boost that
firmware left running without the route is switched off at probe
(axp717_boost_init_hw()), so is_enabled() matches the hardware and an
unused boost does not stay on; before this change the core would have
switched it off at late init anyway.

Assisted-by: Claude Opus 5.5
Signed-off-by: leow149 <leow149@lucidmail.xyz>
---
 drivers/regulator/axp20x-regulator.c | 108 +++++++++++++++++++++++++--
 1 file changed, 102 insertions(+), 6 deletions(-)

diff --git a/drivers/regulator/axp20x-regulator.c b/drivers/regulator/axp20x-regulator.c
index da891415e..b722e6508 100644
--- a/drivers/regulator/axp20x-regulator.c
+++ b/drivers/regulator/axp20x-regulator.c
@@ -371,8 +371,8 @@
 		.ops		= &axp20x_ops,					\
 	}
 
-#define AXP_DESC(_family, _id, _match, _supply, _min, _max, _step, _vreg,	\
-		 _vmask, _ereg, _emask)						\
+#define AXP_DESC_OPS(_family, _id, _match, _supply, _min, _max, _step,	\
+		     _vreg, _vmask, _ereg, _emask, _ops)			\
 	[_family##_##_id] = {							\
 		.name		= (_match),					\
 		.supply_name	= (_supply),					\
@@ -388,9 +388,14 @@
 		.vsel_mask	= (_vmask),					\
 		.enable_reg	= (_ereg),					\
 		.enable_mask	= (_emask),					\
-		.ops		= &axp20x_ops,					\
+		.ops		= (_ops),					\
 	}
 
+#define AXP_DESC(_family, _id, _match, _supply, _min, _max, _step, _vreg,	\
+		 _vmask, _ereg, _emask)						\
+	AXP_DESC_OPS(_family, _id, _match, _supply, _min, _max, _step,	\
+		     _vreg, _vmask, _ereg, _emask, &axp20x_ops)
+
 #define AXP_DESC_SW(_family, _id, _match, _supply, _ereg, _emask)		\
 	[_family##_##_id] = {							\
 		.name		= (_match),					\
@@ -590,6 +595,93 @@ static const struct regulator_ops axp20x_ops = {
 	.set_ramp_delay		= axp20x_set_ramp_delay,
 };
 
+/*
+ * AXP717 boost as USB OTG VBUS: besides the boost enable (MODULE_EN_CONTROL_2
+ * bit 4), the output only reaches the VBUS pin with bit 0 of register 0x13
+ * set. The vendor (AXP2202) driver's drivevbus regulator writes both, 0x13
+ * first, and treats the regulator as on only when both are set.
+ */
+#define AXP717_VBUS_OTG_EN	BIT(0)
+#define AXP717_BOOST_EN		BIT(4)
+
+static int axp717_boost_enable(struct regulator_dev *rdev)
+{
+	int ret;
+
+	ret = regmap_set_bits(rdev->regmap, AXP717_VBUS_OTG_CONTROL,
+			      AXP717_VBUS_OTG_EN);
+	if (ret)
+		return ret;
+
+	ret = regulator_enable_regmap(rdev);
+	if (ret)
+		regmap_clear_bits(rdev->regmap, AXP717_VBUS_OTG_CONTROL,
+				  AXP717_VBUS_OTG_EN);
+	return ret;
+}
+
+static int axp717_boost_disable(struct regulator_dev *rdev)
+{
+	int ret;
+
+	ret = regmap_clear_bits(rdev->regmap, AXP717_VBUS_OTG_CONTROL,
+				AXP717_VBUS_OTG_EN);
+	if (ret)
+		return ret;
+
+	return regulator_disable_regmap(rdev);
+}
+
+static int axp717_boost_is_enabled(struct regulator_dev *rdev)
+{
+	unsigned int val;
+	int ret;
+
+	ret = regmap_read(rdev->regmap, AXP717_VBUS_OTG_CONTROL, &val);
+	if (ret)
+		return ret;
+	if (!(val & AXP717_VBUS_OTG_EN))
+		return 0;
+
+	return regulator_is_enabled_regmap(rdev);
+}
+
+/*
+ * Called at probe. Firmware may leave the boost running with its output not
+ * routed to VBUS. That state feeds nothing, and with is_enabled() requiring
+ * both bits the regulator core would see the boost as off and never switch
+ * it off: do that here, so the hardware matches what is_enabled() reports.
+ * Boards that want the boost on (always-on, or a consumer) get it enabled
+ * again, now routed, by the core. Without a consumer the core would have
+ * switched it off at late init anyway.
+ */
+static int axp717_boost_init_hw(struct regmap *regmap)
+{
+	unsigned int otg, en;
+	int ret;
+
+	ret = regmap_read(regmap, AXP717_VBUS_OTG_CONTROL, &otg);
+	if (ret)
+		return ret;
+	ret = regmap_read(regmap, AXP717_MODULE_EN_CONTROL_2, &en);
+	if (ret)
+		return ret;
+
+	if ((en & AXP717_BOOST_EN) && !(otg & AXP717_VBUS_OTG_EN))
+		return regmap_clear_bits(regmap, AXP717_MODULE_EN_CONTROL_2,
+					 AXP717_BOOST_EN);
+	return 0;
+}
+
+static const struct regulator_ops axp717_boost_ops = {
+	.set_voltage_sel	= regulator_set_voltage_sel_regmap,
+	.get_voltage_sel	= regulator_get_voltage_sel_regmap,
+	.list_voltage		= regulator_list_voltage_linear,
+	.enable			= axp717_boost_enable,
+	.disable		= axp717_boost_disable,
+	.is_enabled		= axp717_boost_is_enabled,
+};
+
 static const struct regulator_ops axp20x_ops_sw = {
 	.enable			= regulator_enable_regmap,
 	.disable		= regulator_disable_regmap,
@@ -841,9 +933,10 @@ static const struct regulator_desc axp717_regulators[] = {
 	AXP_DESC(AXP717, CPUSLDO, "cpusldo", "vin1", 500, 1400, 50,
 		 AXP717_CPUSLDO_CONTROL, AXP717_LDO_V_OUT_MASK,
 		 AXP717_LDO1_OUTPUT_CONTROL, BIT(4)),
-	AXP_DESC(AXP717, BOOST, "boost", "vin1", 4550, 5510, 64,
-		 AXP717_BOOST_CONTROL, AXP717_BOOST_V_OUT_MASK,
-		 AXP717_MODULE_EN_CONTROL_2, BIT(4)),
+	AXP_DESC_OPS(AXP717, BOOST, "boost", "vin1", 4550, 5510, 64,
+		     AXP717_BOOST_CONTROL, AXP717_BOOST_V_OUT_MASK,
+		     AXP717_MODULE_EN_CONTROL_2, AXP717_BOOST_EN,
+		     &axp717_boost_ops),
 };
 
 /* DCDC ranges shared with AXP813 */
@@ -1588,6 +1681,9 @@ static int axp20x_regulator_probe(struct platform_device *pdev)
 	case AXP717_ID:
 		regulators = axp717_regulators;
 		nregulators = AXP717_REG_ID_MAX;
+		ret = axp717_boost_init_hw(axp20x->regmap);
+		if (ret)
+			return ret;
 		break;
 	case AXP803_ID:
 		regulators = axp803_regulators;
