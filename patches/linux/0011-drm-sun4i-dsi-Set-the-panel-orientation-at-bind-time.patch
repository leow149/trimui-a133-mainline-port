From 6be5348df3b7dd434e9eef0128b208be6c3e8ccb Mon Sep 17 00:00:00 2001
From: leow149 <leow149@lucidmail.xyz>
Date: Sun, 1 Nov 2026 00:21:28 +0100
Subject: [PATCH 11/34] drm/sun4i: dsi: Set the panel orientation at bind time

The orientation property has to exist before the connector is registered,
but the panel has usually not attached to the DSI host yet when the DSI binds.
Fall back to reading the orientation from the panel's DT node.

Signed-off-by: leow149 <leow149@lucidmail.xyz>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/gpu/drm/sun4i/sun6i_mipi_dsi.c | 28 ++++++++++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/drivers/gpu/drm/sun4i/sun6i_mipi_dsi.c b/drivers/gpu/drm/sun4i/sun6i_mipi_dsi.c
index 64bd36830..387ad6351 100644
--- a/drivers/gpu/drm/sun4i/sun6i_mipi_dsi.c
+++ b/drivers/gpu/drm/sun4i/sun6i_mipi_dsi.c
@@ -22,6 +22,7 @@
 #include <drm/drm_atomic_helper.h>
 #include <drm/drm_encoder.h>
 #include <drm/drm_mipi_dsi.h>
+#include <drm/drm_of.h>
 #include <drm/drm_panel.h>
 #include <drm/drm_print.h>
 #include <drm/drm_probe_helper.h>
@@ -1094,6 +1095,33 @@ static int sun6i_dsi_bind(struct device *dev, struct device *master,
 
 	drm_connector_attach_encoder(&dsi->connector, &dsi->encoder);
 
+	/*
+	 * The orientation property must exist before the connector is
+	 * registered. component_add() runs right after the DSI host is
+	 * registered, so the panel has often not attached yet here; fall back
+	 * to its DT node in that case.
+	 */
+	if (dsi->panel) {
+		drm_connector_set_orientation_from_panel(&dsi->connector,
+							 dsi->panel);
+	} else {
+		enum drm_panel_orientation orientation;
+		struct device_node *np;
+
+		for_each_available_child_of_node(dsi->dev->of_node, np) {
+			if (of_node_name_eq(np, "port") ||
+			    of_node_name_eq(np, "ports"))
+				continue;
+			if (!drm_of_get_panel_orientation(np, &orientation) &&
+			    orientation != DRM_MODE_PANEL_ORIENTATION_UNKNOWN) {
+				drm_connector_set_panel_orientation(&dsi->connector,
+								    orientation);
+				of_node_put(np);
+				break;
+			}
+		}
+	}
+
 	dsi->drm = drm;
 
 	return 0;
-- 
