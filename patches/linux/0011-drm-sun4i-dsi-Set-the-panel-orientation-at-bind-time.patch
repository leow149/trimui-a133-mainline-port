From 77d2d79918db2090ed6daf4507703db2f05c1807 Mon Sep 17 00:00:00 2001
From: leow149 <leow149@lucidmail.xyz>
Date: Sun, 1 Nov 2026 00:21:28 +0100
Subject: [PATCH 011/106] drm/sun4i: dsi: Set the panel orientation at bind
 time

The orientation property has to exist before the connector is registered,
but the panel has usually not attached to the DSI host yet when the DSI
binds. Fall back to reading the orientation from the panel's DT node.

There is no generic helper for this: sun6i_dsi_attach() only accepts the
panel once the DRM device is registered, while the property has to exist
before. drm_bridge_connector would handle it, but this driver does not
use bridges.

Assisted-by: Claude Opus 5.5
Signed-off-by: leow149 <leow149@lucidmail.xyz>
---
 drivers/gpu/drm/sun4i/sun6i_mipi_dsi.c | 28 ++++++++++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/drivers/gpu/drm/sun4i/sun6i_mipi_dsi.c b/drivers/gpu/drm/sun4i/sun6i_mipi_dsi.c
index fab08193b..38586de92 100644
--- a/drivers/gpu/drm/sun4i/sun6i_mipi_dsi.c
+++ b/drivers/gpu/drm/sun4i/sun6i_mipi_dsi.c
@@ -22,6 +22,7 @@
 #include <drm/drm_atomic_helper.h>
 #include <drm/drm_encoder.h>
 #include <drm/drm_mipi_dsi.h>
+#include <drm/drm_of.h>
 #include <drm/drm_panel.h>
 #include <drm/drm_print.h>
 #include <drm/drm_probe_helper.h>
@@ -1114,6 +1115,33 @@ static int sun6i_dsi_bind(struct device *dev, struct device *master,
 
 	drm_connector_attach_encoder(&dsi->connector, &dsi->encoder);
 
+	/*
+	 * The orientation property must exist before the connector is
+	 * registered, but sun6i_dsi_attach() only accepts the panel once the
+	 * DRM device is registered, so it is never attached yet here. There
+	 * is no generic helper for this case (drm_bridge_connector would
+	 * handle it, but this driver does not use bridges), so read the
+	 * orientation from the panel's DT node, the DSI child that is not a
+	 * port, as of_drm_find_panel() would find it.
+	 */
+	if (dsi->panel) {
+		drm_connector_set_orientation_from_panel(&dsi->connector,
+							 dsi->panel);
+	} else {
+		enum drm_panel_orientation orientation;
+
+		for_each_available_child_of_node_scoped(dsi->dev->of_node, np) {
+			if (of_node_name_eq(np, "port") ||
+			    of_node_name_eq(np, "ports"))
+				continue;
+			if (!drm_of_get_panel_orientation(np, &orientation)) {
+				drm_connector_set_panel_orientation(&dsi->connector,
+								    orientation);
+				break;
+			}
+		}
+	}
+
 	dsi->drm = drm;
 
 	return 0;
