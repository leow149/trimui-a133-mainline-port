From ac6631048cd24933daa32d819ac4d0126b9e7ea2 Mon Sep 17 00:00:00 2001
From: leow149 <leow149@lucidmail.xyz>
Date: Sun, 1 Nov 2026 00:21:23 +0100
Subject: [PATCH 001/106] dt-bindings: pwm: Add the Allwinner A100 PWM
 controller

Add a binding for the PWM controller of the Allwinner A100/A133
(sun50iw10): 4 channels in 2 pairs, with the register layout of the D1/T113
PWM rather than the one of the allwinner,sun4i-a10-pwm family. Besides the
bus clock it takes the 24 MHz oscillator ("hosc"), the clock source the
channels use. The compatible follows the A100 naming of the other blocks of
this SoC.

Assisted-by: Claude Opus 5.5
Signed-off-by: leow149 <leow149@lucidmail.xyz>
---
 .../pwm/allwinner,sun50i-a100-pwm.yaml        | 65 +++++++++++++++++++
 1 file changed, 65 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/pwm/allwinner,sun50i-a100-pwm.yaml

diff --git a/Documentation/devicetree/bindings/pwm/allwinner,sun50i-a100-pwm.yaml b/Documentation/devicetree/bindings/pwm/allwinner,sun50i-a100-pwm.yaml
new file mode 100644
index 000000000..e7e544ae9
--- /dev/null
+++ b/Documentation/devicetree/bindings/pwm/allwinner,sun50i-a100-pwm.yaml
@@ -0,0 +1,65 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/pwm/allwinner,sun50i-a100-pwm.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Allwinner A100 PWM controller
+
+description: |
+  PWM controller of the Allwinner A100/A133 (sun50iw10): 4 channels in 2
+  pairs, with a per-pair clock source (OSC24M or APB1) inside the block.
+  Not compatible with the allwinner,sun4i-a10-pwm family.
+
+maintainers:
+  - leow149 <leow149@lucidmail.xyz>
+
+allOf:
+  - $ref: pwm.yaml#
+
+properties:
+  compatible:
+    const: allwinner,sun50i-a100-pwm
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    items:
+      - description: Bus clock
+      - description: 24 MHz oscillator, the PWM clock source
+
+  clock-names:
+    items:
+      - const: bus
+      - const: hosc
+
+  resets:
+    maxItems: 1
+
+  "#pwm-cells":
+    const: 3
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - resets
+  - "#pwm-cells"
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/sun50i-a100-ccu.h>
+    #include <dt-bindings/reset/sun50i-a100-ccu.h>
+
+    pwm: pwm@300a000 {
+        compatible = "allwinner,sun50i-a100-pwm";
+        reg = <0x0300a000 0x400>;
+        clocks = <&ccu CLK_BUS_PWM>, <&dcxo24M>;
+        clock-names = "bus", "hosc";
+        resets = <&ccu RST_BUS_PWM>;
+        #pwm-cells = <3>;
+    };
