From 5268b031861dbd8696aecbb317c91b78b3895ddf Mon Sep 17 00:00:00 2001
From: leow149 <leow149@lucidmail.xyz>
Date: Sun, 1 Nov 2026 19:17:49 +0100
Subject: [PATCH 47/48] arm64: dts: allwinner: a100: Add the GPU and its power
 domain

PowerVR GE8300 (Rogue, BVNC 22.102.54.38) at 0x01800000 behind the R_PPU
power domain.

Signed-off-by: leow149 <leow149@lucidmail.xyz>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../arm64/boot/dts/allwinner/sun50i-a100.dtsi | 20 +++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun50i-a100.dtsi b/arch/arm64/boot/dts/allwinner/sun50i-a100.dtsi
index f71fb6693..28c85d30c 100644
--- a/arch/arm64/boot/dts/allwinner/sun50i-a100.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun50i-a100.dtsi
@@ -163,6 +163,18 @@ dma: dma-controller@3002000 {
 			#dma-cells = <1>;
 		};
 
+		gpu: gpu@1800000 {
+			compatible = "allwinner,sun50i-a100-gpu", "img,img-ge8300",
+				     "img,img-rogue";
+			reg = <0x01800000 0x80000>;
+			interrupts = <GIC_SPI 97 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&ccu CLK_GPU>, <&ccu CLK_BUS_GPU>;
+			clock-names = "core", "sys";
+			resets = <&ccu RST_BUS_GPU>;
+			power-domains = <&gpu_ppu>;
+			status = "disabled";
+		};
+
 		gic: interrupt-controller@3021000 {
 			compatible = "arm,gic-400";
 			reg = <0x03021000 0x1000>, <0x03022000 0x2000>,
@@ -639,6 +651,14 @@ r_intc: interrupt-controller@7010320 {
 			interrupts = <GIC_SPI 103 IRQ_TYPE_LEVEL_HIGH>;
 		};
 
+		gpu_ppu: power-controller@7001000 {
+			compatible = "allwinner,sun50i-a100-gpu-ppu";
+			reg = <0x07001000 0x40>;
+			clocks = <&r_ccu CLK_R_APB1_PPU>;
+			resets = <&r_ccu RST_R_APB1_PPU>;
+			#power-domain-cells = <0>;
+		};
+
 		r_pio: pinctrl@7022000 {
 			compatible = "allwinner,sun50i-a100-r-pinctrl";
 			reg = <0x07022000 0x400>;
-- 
2.56.0

