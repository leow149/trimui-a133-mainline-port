From 11872d389f061a3a668c76a0e099c61ca4d37f87 Mon Sep 17 00:00:00 2001
From: leow149 <leow149@lucidmail.xyz>
Date: Sun, 15 Nov 2026 16:31:29 +0100
Subject: [PATCH 025/106] dt-bindings: rtc: sun6i: Add the Allwinner A100 RTC

The A100 RTC is compatible with the R329 one, except that it has no
internal SPI clock, so there is no AHB clock input.

Signed-off-by: leow149 <leow149@lucidmail.xyz>
---
 .../bindings/rtc/allwinner,sun6i-a31-rtc.yaml | 30 +++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/Documentation/devicetree/bindings/rtc/allwinner,sun6i-a31-rtc.yaml b/Documentation/devicetree/bindings/rtc/allwinner,sun6i-a31-rtc.yaml
index f2b91186e..0ff9e9530 100644
--- a/Documentation/devicetree/bindings/rtc/allwinner,sun6i-a31-rtc.yaml
+++ b/Documentation/devicetree/bindings/rtc/allwinner,sun6i-a31-rtc.yaml
@@ -32,6 +32,7 @@ properties:
       - items:
           - enum:
               - allwinner,sun20i-d1-rtc
+              - allwinner,sun50i-a100-rtc
               - allwinner,sun55i-a523-rtc
               - allwinner,sun60i-a733-rtc
           - const: allwinner,sun50i-r329-rtc
@@ -129,11 +130,40 @@ allOf:
         - clocks
         - clock-names
 
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: allwinner,sun50i-a100-rtc
+
+    then:
+      properties:
+        clocks:
+          minItems: 2
+          items:
+            - description: Bus clock for register access
+            - description: 24 MHz oscillator
+            - description: External 32768 Hz oscillator
+
+        clock-names:
+          minItems: 2
+          items:
+            - const: bus
+            - const: hosc
+            - const: ext-osc32k
+
+      required:
+        - clocks
+        - clock-names
+
   - if:
       properties:
         compatible:
           contains:
             const: allwinner,sun50i-r329-rtc
+          not:
+            contains:
+              const: allwinner,sun50i-a100-rtc
 
     then:
       properties:
