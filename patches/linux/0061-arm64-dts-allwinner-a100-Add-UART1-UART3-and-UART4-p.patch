From 4dceefa13c860ed107b8c86cb15cb67197a3b997 Mon Sep 17 00:00:00 2001
From: leow149 <leow149@lucidmail.xyz>
Date: Sun, 22 Nov 2026 20:15:33 +0100
Subject: [PATCH 061/100] arm64: dts: allwinner: a100: Add UART1, UART3 and
 UART4 pins

Pin groups for UART1 on PG6-PG9 (with RTS/CTS), UART3 on PD14/PD15 and
UART4 on PD18/PD19.

Assisted-by: Claude Opus 5.5
Signed-off-by: leow149 <leow149@lucidmail.xyz>
---
 arch/arm64/boot/dts/allwinner/sun50i-a100.dtsi | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun50i-a100.dtsi b/arch/arm64/boot/dts/allwinner/sun50i-a100.dtsi
index 9298216b7..2948fc380 100644
--- a/arch/arm64/boot/dts/allwinner/sun50i-a100.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun50i-a100.dtsi
@@ -268,6 +268,22 @@ uart0_pb_pins: uart0-pb-pins {
 				pins = "PB9", "PB10";
 				function = "uart0";
 			};
+
+			/omit-if-no-ref/
+			uart1_pg_pins: uart1-pg-pins {
+				pins = "PG6", "PG7", "PG8", "PG9";
+				function = "uart1";
+			};
+
+			uart3_pd_pins: uart3-pd-pins {
+				pins = "PD14", "PD15";
+				function = "uart3";
+			};
+
+			uart4_pd_pins: uart4-pd-pins {
+				pins = "PD18", "PD19";
+				function = "uart4";
+			};
 		};
 
 		mmc0: mmc@4020000 {
