diff --git a/drivers/pwm/pwm-sun50i-a133.c b/drivers/pwm/pwm-sun50i-a133.c
new file mode 100644
index 000000000..57f7733e0
--- /dev/null
+++ b/drivers/pwm/pwm-sun50i-a133.c
@@ -0,0 +1,312 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Driver for the Allwinner A100/A133 (sun50iw10) PWM controller
+ *
+ * Register layout from the A133 User Manual (chapter 10.11, base 0x0300a000):
+ * 4 channels in 2 pairs, with per-pair clock source and dead-zone control,
+ * group sync, capture, and period/duty registers that are loaded at the end
+ * of the running period. It is the layout of the D1/T113 PWM, not the one of
+ * drivers/pwm/pwm-sun4i.c (nor of the H616 PWM).
+ *
+ * Only plain PWM output (cycle mode) is supported, clocked from OSC24M (the
+ * reset default of the per-pair clock source). The CCU only provides a bus
+ * clock gate and a reset for the block.
+ *
+ * Limitations:
+ * - The period and duty registers take effect at the end of the running
+ *   period. A new prescaler takes effect immediately, so a change of the
+ *   prescaler can make one period glitch.
+ * - When disabled, the output goes to its inactive level at once.
+ */
+
+#include <linux/bitops.h>
+#include <linux/clk.h>
+#include <linux/io.h>
+#include <linux/math64.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pwm.h>
+#include <linux/reset.h>
+
+#define PWM_A133_OSC24M_RATE		24000000
+
+#define PWM_A133_PCCR_REG(ch)		(0x0020 + 4 * ((ch) / 2))
+#define PWM_A133_PCCR_CLK_SRC_OSC24M	(0 << 7)
+#define PWM_A133_PCCR_CLK_SRC_MASK	GENMASK(8, 7)
+
+#define PWM_A133_PCGR_REG		0x0040
+#define PWM_A133_PCGR_BYPASS(ch)	BIT(16 + (ch))
+#define PWM_A133_PCGR_GATING(ch)	BIT(ch)
+
+#define PWM_A133_PER_REG		0x0080
+#define PWM_A133_PER_EN(ch)		BIT(ch)
+
+#define PWM_A133_CH_STRIDE		0x0020
+#define PWM_A133_PCR_REG(ch)		(0x0100 + PWM_A133_CH_STRIDE * (ch))
+#define PWM_A133_PPR_REG(ch)		(0x0104 + PWM_A133_CH_STRIDE * (ch))
+
+#define PWM_A133_PCR_MODE_CYCLE		(0 << 9)
+#define PWM_A133_PCR_ACT_STA_HIGH	BIT(8)
+#define PWM_A133_PCR_PRESCAL_K_MASK	GENMASK(7, 0)
+
+#define PWM_A133_PPR_ENTIRE_CYCLE_SHIFT	16
+#define PWM_A133_PPR_ENTIRE_CYCLE_MASK		GENMASK(31, 16)
+#define PWM_A133_PPR_ACT_CYCLE_MASK		GENMASK(15, 0)
+
+#define PWM_A133_PRESCALE_K_MAX	256
+#define PWM_A133_CYCLE_MAX	65536
+
+struct pwm_a133 {
+	void __iomem *base;
+	struct clk *bus_clk;
+	struct reset_control *rst;
+	/*
+	 * Serialises the read-modify-write of the registers shared by all
+	 * channels (PCGR, PER) or by a pair (PCCR) across channels: the PWM
+	 * core only serialises calls for one channel.
+	 */
+	struct mutex lock;
+};
+
+static struct pwm_a133 *to_pwm_a133(struct pwm_chip *chip)
+{
+	return pwmchip_get_drvdata(chip);
+}
+
+static u32 pwm_a133_readl(struct pwm_a133 *pc, u32 offset)
+{
+	return readl(pc->base + offset);
+}
+
+static void pwm_a133_writel(struct pwm_a133 *pc, u32 offset, u32 val)
+{
+	writel(val, pc->base + offset);
+}
+
+/* Round down, as the PWM core expects; -EINVAL if the period is too short. */
+static int pwm_a133_calc(u64 period_ns, u64 duty_ns, u32 *entire_cycle,
+			 u32 *act_cycle, u32 *prescale_k)
+{
+	u64 period_cycles, duty_cycles, prescale;
+
+	period_cycles = mul_u64_u32_div(period_ns, PWM_A133_OSC24M_RATE,
+					NSEC_PER_SEC);
+	duty_cycles = mul_u64_u32_div(duty_ns, PWM_A133_OSC24M_RATE,
+				      NSEC_PER_SEC);
+
+	/* The smallest prescaler that fits the period, for the best resolution. */
+	prescale = max_t(u64, DIV_ROUND_UP_ULL(period_cycles, PWM_A133_CYCLE_MAX), 1);
+	if (prescale > PWM_A133_PRESCALE_K_MAX) {
+		prescale = PWM_A133_PRESCALE_K_MAX;
+		period_cycles = PWM_A133_CYCLE_MAX * prescale;
+	}
+
+	period_cycles = div64_u64(period_cycles, prescale);
+	duty_cycles = div64_u64(duty_cycles, prescale);
+	if (!period_cycles)
+		return -EINVAL;
+	duty_cycles = min(duty_cycles, period_cycles);
+
+	/*
+	 * The duty field is 16 bits wide: with the longest period (65536
+	 * cycles), 100% duty can only be approximated by 65535 cycles.
+	 */
+	duty_cycles = min_t(u64, duty_cycles, PWM_A133_CYCLE_MAX - 1);
+
+	*prescale_k = prescale - 1;
+	*entire_cycle = period_cycles - 1;
+	*act_cycle = duty_cycles;
+
+	return 0;
+}
+
+static int pwm_a133_apply(struct pwm_chip *chip, struct pwm_device *pwm,
+			  const struct pwm_state *state)
+{
+	struct pwm_a133 *pc = to_pwm_a133(chip);
+	unsigned int ch = pwm->hwpwm;
+	u32 entire_cycle, act_cycle, prescale_k, val, pcgr;
+	int ret = 0;
+
+	mutex_lock(&pc->lock);
+
+	if (!state->enabled) {
+		val = pwm_a133_readl(pc, PWM_A133_PER_REG);
+		pwm_a133_writel(pc, PWM_A133_PER_REG, val & ~PWM_A133_PER_EN(ch));
+
+		val = pwm_a133_readl(pc, PWM_A133_PCGR_REG);
+		pwm_a133_writel(pc, PWM_A133_PCGR_REG,
+				val & ~PWM_A133_PCGR_GATING(ch));
+		goto out;
+	}
+
+	ret = pwm_a133_calc(state->period, state->duty_cycle, &entire_cycle,
+			    &act_cycle, &prescale_k);
+	if (ret)
+		goto out;
+
+	/*
+	 * Only set up the clock when the channel is off: the period and duty
+	 * of a running channel are updated without stopping its clock, so
+	 * the output does not glitch (they are loaded at the end of the
+	 * running period).
+	 */
+	pcgr = pwm_a133_readl(pc, PWM_A133_PCGR_REG);
+	if (!(pcgr & PWM_A133_PCGR_GATING(ch))) {
+		/* Clock source: OSC24M for the pair this channel belongs to. */
+		val = pwm_a133_readl(pc, PWM_A133_PCCR_REG(ch));
+		val &= ~PWM_A133_PCCR_CLK_SRC_MASK;
+		val |= PWM_A133_PCCR_CLK_SRC_OSC24M;
+		pwm_a133_writel(pc, PWM_A133_PCCR_REG(ch), val);
+	}
+
+	val = PWM_A133_PCR_MODE_CYCLE | (prescale_k & PWM_A133_PCR_PRESCAL_K_MASK);
+	if (state->polarity == PWM_POLARITY_NORMAL)
+		val |= PWM_A133_PCR_ACT_STA_HIGH;
+	pwm_a133_writel(pc, PWM_A133_PCR_REG(ch), val);
+
+	val = (entire_cycle << PWM_A133_PPR_ENTIRE_CYCLE_SHIFT) & PWM_A133_PPR_ENTIRE_CYCLE_MASK;
+	val |= act_cycle & PWM_A133_PPR_ACT_CYCLE_MASK;
+	pwm_a133_writel(pc, PWM_A133_PPR_REG(ch), val);
+
+	if ((pcgr & (PWM_A133_PCGR_GATING(ch) | PWM_A133_PCGR_BYPASS(ch))) !=
+	    PWM_A133_PCGR_GATING(ch)) {
+		pcgr &= ~PWM_A133_PCGR_BYPASS(ch);
+		pcgr |= PWM_A133_PCGR_GATING(ch);
+		pwm_a133_writel(pc, PWM_A133_PCGR_REG, pcgr);
+	}
+
+	val = pwm_a133_readl(pc, PWM_A133_PER_REG);
+	if (!(val & PWM_A133_PER_EN(ch)))
+		pwm_a133_writel(pc, PWM_A133_PER_REG, val | PWM_A133_PER_EN(ch));
+
+out:
+	mutex_unlock(&pc->lock);
+	return ret;
+}
+
+static int pwm_a133_get_state(struct pwm_chip *chip, struct pwm_device *pwm,
+			      struct pwm_state *state)
+{
+	struct pwm_a133 *pc = to_pwm_a133(chip);
+	unsigned int ch = pwm->hwpwm;
+	u32 per, pcr, ppr;
+	u32 entire_cycle, act_cycle, prescale;
+
+	per = pwm_a133_readl(pc, PWM_A133_PER_REG) &
+	      pwm_a133_readl(pc, PWM_A133_PCGR_REG);
+	pcr = pwm_a133_readl(pc, PWM_A133_PCR_REG(ch));
+	ppr = pwm_a133_readl(pc, PWM_A133_PPR_REG(ch));
+
+	/* PER and PCGR use the same bit per channel. */
+	state->enabled = !!(per & PWM_A133_PER_EN(ch));
+	state->polarity = (pcr & PWM_A133_PCR_ACT_STA_HIGH) ?
+			   PWM_POLARITY_NORMAL : PWM_POLARITY_INVERSED;
+
+	prescale = (pcr & PWM_A133_PCR_PRESCAL_K_MASK) + 1;
+	entire_cycle = ((ppr & PWM_A133_PPR_ENTIRE_CYCLE_MASK) >>
+			PWM_A133_PPR_ENTIRE_CYCLE_SHIFT) + 1;
+	act_cycle = ppr & PWM_A133_PPR_ACT_CYCLE_MASK;
+
+	/* Round up, so that applying the result gives the same settings. */
+	state->period = DIV_ROUND_UP_ULL((u64)entire_cycle * prescale * NSEC_PER_SEC,
+					 PWM_A133_OSC24M_RATE);
+	state->duty_cycle = DIV_ROUND_UP_ULL((u64)act_cycle * prescale * NSEC_PER_SEC,
+					     PWM_A133_OSC24M_RATE);
+
+	return 0;
+}
+
+static const struct pwm_ops pwm_a133_ops = {
+	.apply = pwm_a133_apply,
+	.get_state = pwm_a133_get_state,
+};
+
+struct pwm_a133_data {
+	unsigned int npwm;
+};
+
+static const struct pwm_a133_data sun50i_a133_pwm_data = {
+	.npwm = 4,
+};
+
+static const struct of_device_id pwm_a133_dt_ids[] = {
+	{ .compatible = "allwinner,sun50i-a133-pwm", .data = &sun50i_a133_pwm_data },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, pwm_a133_dt_ids);
+
+static int pwm_a133_probe(struct platform_device *pdev)
+{
+	const struct pwm_a133_data *data;
+	struct pwm_chip *chip;
+	struct pwm_a133 *pc;
+	int ret;
+
+	data = of_device_get_match_data(&pdev->dev);
+	if (!data)
+		return -ENODEV;
+
+	chip = devm_pwmchip_alloc(&pdev->dev, data->npwm, sizeof(*pc));
+	if (IS_ERR(chip))
+		return PTR_ERR(chip);
+	pc = to_pwm_a133(chip);
+
+	mutex_init(&pc->lock);
+
+	pc->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(pc->base))
+		return PTR_ERR(pc->base);
+
+	pc->bus_clk = devm_clk_get_enabled(&pdev->dev, "bus");
+	if (IS_ERR(pc->bus_clk))
+		return dev_err_probe(&pdev->dev, PTR_ERR(pc->bus_clk),
+				     "get bus clock failed\n");
+
+	pc->rst = devm_reset_control_get_exclusive(&pdev->dev, NULL);
+	if (IS_ERR(pc->rst))
+		return dev_err_probe(&pdev->dev, PTR_ERR(pc->rst),
+				     "get reset failed\n");
+
+	ret = reset_control_deassert(pc->rst);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+				     "cannot deassert reset control\n");
+
+	chip->ops = &pwm_a133_ops;
+
+	ret = pwmchip_add(chip);
+	if (ret < 0) {
+		dev_err(&pdev->dev, "failed to add PWM chip: %d\n", ret);
+		reset_control_assert(pc->rst);
+		return ret;
+	}
+
+	platform_set_drvdata(pdev, chip);
+
+	return 0;
+}
+
+static void pwm_a133_remove(struct platform_device *pdev)
+{
+	struct pwm_chip *chip = platform_get_drvdata(pdev);
+	struct pwm_a133 *pc = to_pwm_a133(chip);
+
+	pwmchip_remove(chip);
+	reset_control_assert(pc->rst);
+}
+
+static struct platform_driver pwm_a133_driver = {
+	.driver = {
+		.name = "sun50i-a133-pwm",
+		.of_match_table = pwm_a133_dt_ids,
+	},
+	.probe = pwm_a133_probe,
+	.remove = pwm_a133_remove,
+};
+module_platform_driver(pwm_a133_driver);
+
+MODULE_DESCRIPTION("Allwinner A100/A133 PWM driver");
+MODULE_LICENSE("GPL");
