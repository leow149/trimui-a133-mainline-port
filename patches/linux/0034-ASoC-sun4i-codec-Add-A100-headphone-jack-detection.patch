From 2780bc986837862488477aed03a555da16adb891 Mon Sep 17 00:00:00 2001
From: leow149 <leow149@lucidmail.xyz>
Date: Sun, 1 Nov 2026 10:42:38 +0100
Subject: [PATCH 034/106] ASoC: sun4i-codec: Add A100 headphone jack detection

The A100/A133 codec detects the headphone jack itself (HMIC block): with
JACKDETEN set it raises plug-in and removal interrupts on the codec
interrupt line. There is no state bit, so the state follows the events.
Report the jack on the card and mute the speaker pin while headphones are
plugged in, as both share the headphone output on the boards seen so far.

The interrupt is requested at probe (disabled until the card has created
the jack, so rebinding the card does not hit -EBUSY) with
platform_get_irq_optional(). The jack starts out unplugged (speaker on);
a jack that is already plugged in is reported by the plug-in event the
detector raises once enabled.

Assisted-by: Claude Opus 5.5
Signed-off-by: leow149 <leow149@lucidmail.xyz>
---
 sound/soc/sunxi/sun4i-codec.c | 128 ++++++++++++++++++++++++++++++++++
 1 file changed, 128 insertions(+)

diff --git a/sound/soc/sunxi/sun4i-codec.c b/sound/soc/sunxi/sun4i-codec.c
index f1205f52e..62e5cf6fc 100644
--- a/sound/soc/sunxi/sun4i-codec.c
+++ b/sound/soc/sunxi/sun4i-codec.c
@@ -16,7 +16,9 @@
 #include <linux/platform_device.h>
 #include <linux/delay.h>
 #include <linux/slab.h>
+#include <linux/bitfield.h>
 #include <linux/clk.h>
+#include <linux/interrupt.h>
 #include <linux/regmap.h>
 #include <linux/reset.h>
 #include <linux/gpio/consumer.h>
@@ -274,9 +276,18 @@
 #define SUN50I_A100_LMUTE			(12)
 #define SUN50I_A100_LINEOUTL_DIFF		(6)
 #define SUN50I_A100_LINEOUT_VOL			(0)
+#define SUN50I_A100_MICBIAS_REG			(0x318)
+#define SUN50I_A100_JACKDETEN			BIT(23)
 #define SUN50I_A100_HP_REG			(0x324)
 #define SUN50I_A100_HPPA_EN			(15)
+#define SUN50I_A100_HMIC_CTRL_REG		(0x328)
+#define SUN50I_A100_HMIC_N			GENMASK(9, 6)
+#define SUN50I_A100_JACK_OUT_IRQ_EN		BIT(2)
+#define SUN50I_A100_JACK_IN_IRQ_EN		BIT(1)
 #define SUN50I_A100_HMIC_STS_REG		(0x32c)
+#define SUN50I_A100_MDATA_DISCARD		GENMASK(14, 13)
+#define SUN50I_A100_JACK_DET_OIRQ		BIT(4)
+#define SUN50I_A100_JACK_DET_IIRQ		BIT(3)
 
 /* TODO H3 DAP (Digital Audio Processing) bits */
 
@@ -346,6 +357,8 @@ struct sun4i_codec {
 	struct reset_control *rst;
 	struct gpio_desc *gpio_pa;
 	struct gpio_desc *gpio_hp;
+	int jack_irq;			/* codec jack detection, if > 0 */
+	bool jack_irq_enabled;
 
 	/* ADC_FIFOC register is at different offset on different SoCs */
 	struct regmap_field *reg_adc_fifoc;
@@ -1604,6 +1617,84 @@ static struct snd_soc_jack_pin sun4i_headphone_jack_pins[] = {
 	{ .pin = "Headphone", .mask = SND_JACK_HEADPHONE },
 };
 
+/* Speaker and headphones share one output: plugging in mutes the speaker. */
+static struct snd_soc_jack_pin sun50i_a100_headphone_jack_pins[] = {
+	{ .pin = "Headphone", .mask = SND_JACK_HEADPHONE },
+	{ .pin = "Speaker", .mask = SND_JACK_HEADPHONE, .invert = 1 },
+};
+
+static irqreturn_t sun50i_a100_codec_jack_irq(int irq, void *dev_id)
+{
+	struct sun4i_codec *scodec = dev_id;
+	unsigned int sts;
+
+	regmap_read(scodec->regmap, SUN50I_A100_HMIC_STS_REG, &sts);
+	regmap_write(scodec->regmap, SUN50I_A100_HMIC_STS_REG,
+		     sts & (SUN50I_A100_MDATA_DISCARD |
+			    SUN50I_A100_JACK_DET_OIRQ |
+			    SUN50I_A100_JACK_DET_IIRQ));
+
+	/* There is no state bit, only plug-in and removal events. */
+	if (sts & SUN50I_A100_JACK_DET_IIRQ)
+		snd_soc_jack_report(&sun4i_headphone_jack, SND_JACK_HEADPHONE,
+				    SND_JACK_HEADPHONE);
+	if (sts & SUN50I_A100_JACK_DET_OIRQ)
+		snd_soc_jack_report(&sun4i_headphone_jack, 0,
+				    SND_JACK_HEADPHONE);
+
+	return IRQ_HANDLED;
+}
+
+static int sun50i_a100_codec_jack_init(struct snd_soc_card *card,
+				       struct sun4i_codec *scodec)
+{
+	int ret;
+
+	ret = snd_soc_card_jack_new_pins(card, "Headphone Jack",
+					 SND_JACK_HEADPHONE,
+					 &sun4i_headphone_jack,
+					 sun50i_a100_headphone_jack_pins,
+					 ARRAY_SIZE(sun50i_a100_headphone_jack_pins));
+	if (ret)
+		return ret;
+
+	/* 375 ms plug debounce, interrupts on plug-in and removal */
+	regmap_update_bits(scodec->regmap, SUN50I_A100_HMIC_CTRL_REG,
+			   SUN50I_A100_HMIC_N | SUN50I_A100_JACK_OUT_IRQ_EN |
+			   SUN50I_A100_JACK_IN_IRQ_EN,
+			   FIELD_PREP(SUN50I_A100_HMIC_N, 2) |
+			   SUN50I_A100_JACK_OUT_IRQ_EN |
+			   SUN50I_A100_JACK_IN_IRQ_EN);
+	regmap_write(scodec->regmap, SUN50I_A100_HMIC_STS_REG,
+		     SUN50I_A100_MDATA_DISCARD | SUN50I_A100_JACK_DET_OIRQ |
+		     SUN50I_A100_JACK_DET_IIRQ);
+	/*
+	 * There is no jack state bit: the jack starts out reported as
+	 * unplugged (speaker on), and a jack already plugged in at this point
+	 * is reported by the plug-in event the detector raises once enabled.
+	 */
+	regmap_set_bits(scodec->regmap, SUN50I_A100_MICBIAS_REG,
+			SUN50I_A100_JACKDETEN);
+
+	/* Requested at probe (the card may be bound more than once). */
+	if (!scodec->jack_irq_enabled) {
+		enable_irq(scodec->jack_irq);
+		scodec->jack_irq_enabled = true;
+	}
+
+	return 0;
+}
+
+static void sun50i_a100_codec_jack_exit(struct sun4i_codec *scodec)
+{
+	if (scodec->jack_irq_enabled) {
+		disable_irq(scodec->jack_irq);
+		scodec->jack_irq_enabled = false;
+	}
+	regmap_clear_bits(scodec->regmap, SUN50I_A100_MICBIAS_REG,
+			  SUN50I_A100_JACKDETEN);
+}
+
 static struct snd_soc_jack_gpio sun4i_headphone_jack_gpio = {
 	.name = "hp-det",
 	.report = SND_JACK_HEADPHONE,
@@ -1616,6 +1707,14 @@ static int sun4i_codec_machine_init(struct snd_soc_pcm_runtime *rtd)
 	struct sun4i_codec *scodec = snd_soc_card_get_drvdata(card);
 	int ret;
 
+	if (scodec->jack_irq > 0) {
+		ret = sun50i_a100_codec_jack_init(card, scodec);
+		if (ret) {
+			dev_err(rtd->dev, "Jack detection setup failed: %d\n", ret);
+			return ret;
+		}
+	}
+
 	if (scodec->gpio_hp) {
 		ret = snd_soc_card_jack_new_pins(card, "Headphone Jack",
 						 SND_JACK_HEADPHONE,
@@ -1641,6 +1740,14 @@ static int sun4i_codec_machine_init(struct snd_soc_pcm_runtime *rtd)
 	return 0;
 }
 
+static void sun4i_codec_machine_exit(struct snd_soc_pcm_runtime *rtd)
+{
+	struct sun4i_codec *scodec = snd_soc_card_get_drvdata(rtd->card);
+
+	if (scodec->jack_irq > 0)
+		sun50i_a100_codec_jack_exit(scodec);
+}
+
 static struct snd_soc_dai_link *sun4i_codec_create_link(struct device *dev,
 							int *num_links)
 {
@@ -1667,6 +1774,7 @@ static struct snd_soc_dai_link *sun4i_codec_create_link(struct device *dev,
 	link->platforms->name	= dev_name(dev);
 	link->dai_fmt		= SND_SOC_DAIFMT_I2S;
 	link->init		= sun4i_codec_machine_init;
+	link->exit		= sun4i_codec_machine_exit;
 
 	*num_links = 1;
 
@@ -2279,6 +2387,7 @@ struct sun4i_codec_quirks {
 	unsigned int reg_adc_rxdata;	/* RX FIFO offset for DMA config */
 	bool has_reset;
 	bool playback_only;
+	bool has_jack_detect;	/* jack detection in the codec (HMIC block) */
 	u32 dma_max_burst;
 };
 
@@ -2380,6 +2489,7 @@ static const struct sun4i_codec_quirks sun50i_a100_codec_quirks = {
 	.reg_dac_txdata	= SUN8I_H3_CODEC_DAC_TXDATA,
 	.has_reset	= true,
 	.playback_only	= true,
+	.has_jack_detect = true,
 	.dma_max_burst	= SUN4I_DMA_MAX_BURST,
 };
 
@@ -2492,6 +2602,24 @@ static int sun4i_codec_probe(struct platform_device *pdev)
 				     "Failed to get pa gpio\n");
 
 
+	if (quirks->has_jack_detect) {
+		ret = platform_get_irq_optional(pdev, 0);
+		if (ret > 0) {
+			scodec->jack_irq = ret;
+			/* Enabled once the card has created the jack. */
+			ret = devm_request_threaded_irq(&pdev->dev,
+							scodec->jack_irq, NULL,
+							sun50i_a100_codec_jack_irq,
+							IRQF_ONESHOT | IRQF_NO_AUTOEN,
+							"sun4i-codec-jack", scodec);
+			if (ret)
+				return dev_err_probe(&pdev->dev, ret,
+						     "Failed to request the jack IRQ\n");
+		} else if (ret != -ENXIO) {
+			return ret;
+		}
+	}
+
 	scodec->gpio_hp = devm_gpiod_get_optional(&pdev->dev, "hp-det", GPIOD_IN);
 	if (IS_ERR(scodec->gpio_hp))
 		return dev_err_probe(&pdev->dev, PTR_ERR(scodec->gpio_hp),
