From c288b4fa873322769332c50a9ba8f2ff8c1bdb0f Mon Sep 17 00:00:00 2001
From: leow149 <leow149@lucidmail.xyz>
Date: Mon, 2 Nov 2026 07:46:46 +0100
Subject: [PATCH 56/60] arm64: dts: allwinner: a100: Add the video engine

Add the VE SRAM section and the video engine. It isn't behind the IOMMU
here (the driver for it does not support the A100 yet), so the decoder
buffers come from CMA.

Tested on the A133 TrimUI Smart Pro with GStreamer v4l2codecs, 720p:
H.264 and H.265 bit-exact to the software decoders (231 and 300 fps),
MPEG-2 within IDCT rounding (> 69 dB PSNR).

Signed-off-by: leow149 <leow149@lucidmail.xyz>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../arm64/boot/dts/allwinner/sun50i-a100.dtsi | 27 +++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun50i-a100.dtsi b/arch/arm64/boot/dts/allwinner/sun50i-a100.dtsi
index 28c85d30c..7e3030269 100644
--- a/arch/arm64/boot/dts/allwinner/sun50i-a100.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun50i-a100.dtsi
@@ -140,6 +140,21 @@ sram_a2: sram@100000 {
 				#size-cells = <1>;
 				ranges = <0 0x0100000 0x14000>;
 			};
+
+			/* VE SRAM, SYS_CFG +0x00 bit 0 as on H616 */
+			sram@1a00000 {
+				compatible = "mmio-sram";
+				reg = <0x01a00000 0x200000>;
+				#address-cells = <1>;
+				#size-cells = <1>;
+				ranges = <0 0x01a00000 0x200000>;
+
+				ve_sram: sram-section@0 {
+					compatible = "allwinner,sun50i-a100-ve-sram",
+						     "allwinner,sun50i-h616-ve-sram";
+					reg = <0x000000 0x200000>;
+				};
+			};
 		};
 
 		ccu: clock@3001000 {
@@ -175,6 +190,18 @@ gpu: gpu@1800000 {
 			status = "disabled";
 		};
 
+		video-codec@1c0e000 {
+			compatible = "allwinner,sun50i-a100-video-engine",
+				     "allwinner,sun50i-h6-video-engine";
+			reg = <0x01c0e000 0x2000>;
+			clocks = <&ccu CLK_BUS_VE>, <&ccu CLK_VE>,
+				 <&ccu CLK_MBUS_VE>;
+			clock-names = "ahb", "mod", "ram";
+			resets = <&ccu RST_BUS_VE>;
+			interrupts = <GIC_SPI 94 IRQ_TYPE_LEVEL_HIGH>;
+			allwinner,sram = <&ve_sram 1>;
+		};
+
 		gic: interrupt-controller@3021000 {
 			compatible = "arm,gic-400";
 			reg = <0x03021000 0x1000>, <0x03022000 0x2000>,
-- 
2.56.0

