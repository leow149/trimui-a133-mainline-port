From a54b904594fe07eb16c99184e29960cc10c2ef17 Mon Sep 17 00:00:00 2001
From: leow149 <leow149@lucidmail.xyz>
Date: Sun, 1 Nov 2026 00:36:22 +0100
Subject: [PATCH 20/25] arm64: dts: allwinner: a100: Add the RTC

Describe the RTC and make it the provider of the 32k and internal oscillator
clocks instead of fixed-clock placeholders, as on H616. Its bus clock is gated
by default, so it was not even readable before.

Signed-off-by: leow149 <leow149@lucidmail.xyz>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../arm64/boot/dts/allwinner/sun50i-a100.dtsi | 34 ++++++++-----------
 1 file changed, 15 insertions(+), 19 deletions(-)

diff --git a/arch/arm64/boot/dts/allwinner/sun50i-a100.dtsi b/arch/arm64/boot/dts/allwinner/sun50i-a100.dtsi
index 2c21b533a..690cd31a2 100644
--- a/arch/arm64/boot/dts/allwinner/sun50i-a100.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun50i-a100.dtsi
@@ -6,6 +6,7 @@
 #include <dt-bindings/interrupt-controller/arm-gic.h>
 #include <dt-bindings/clock/sun50i-a100-ccu.h>
 #include <dt-bindings/clock/sun50i-a100-r-ccu.h>
+#include <dt-bindings/clock/sun6i-rtc.h>
 #include <dt-bindings/reset/sun50i-a100-ccu.h>
 #include <dt-bindings/reset/sun50i-a100-r-ccu.h>
 #include <dt-bindings/thermal/thermal.h>
@@ -77,21 +78,6 @@ dcxo24M: dcxo24M-clk {
 		#clock-cells = <0>;
 	};
 
-	iosc: internal-osc-clk {
-		compatible = "fixed-clock";
-		clock-frequency = <16000000>;
-		clock-accuracy = <300000000>;
-		clock-output-names = "iosc";
-		#clock-cells = <0>;
-	};
-
-	osc32k: osc32k-clk {
-		compatible = "fixed-clock";
-		clock-frequency = <32768>;
-		clock-output-names = "osc32k";
-		#clock-cells = <0>;
-	};
-
 	timer {
 		compatible = "arm,armv8-timer";
 		interrupts = <GIC_PPI 13
@@ -159,7 +145,7 @@ sram_a2: sram@100000 {
 		ccu: clock@3001000 {
 			compatible = "allwinner,sun50i-a100-ccu";
 			reg = <0x03001000 0x1000>;
-			clocks = <&dcxo24M>, <&osc32k>, <&iosc>;
+			clocks = <&dcxo24M>, <&rtc CLK_OSC32K>, <&rtc CLK_IOSC>;
 			clock-names = "hosc", "losc", "iosc";
 			#clock-cells = <1>;
 			#reset-cells = <1>;
@@ -221,7 +207,7 @@ pio: pinctrl@300b000 {
 				     <GIC_SPI 58 IRQ_TYPE_LEVEL_HIGH>,
 				     <GIC_SPI 59 IRQ_TYPE_LEVEL_HIGH>,
 				     <GIC_SPI 60 IRQ_TYPE_LEVEL_HIGH>;
-			clocks = <&ccu CLK_APB1>, <&dcxo24M>, <&osc32k>;
+			clocks = <&ccu CLK_APB1>, <&dcxo24M>, <&rtc CLK_OSC32K>;
 			clock-names = "apb", "hosc", "losc";
 			gpio-controller;
 			#gpio-cells = <3>;
@@ -595,10 +581,20 @@ ohci1: usb@5200400 {
 			status = "disabled";
 		};
 
+		rtc: rtc@7000000 {
+			compatible = "allwinner,sun50i-a100-rtc",
+				     "allwinner,sun50i-r329-rtc";
+			reg = <0x07000000 0x400>;
+			interrupts = <GIC_SPI 108 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&r_ccu CLK_R_AHB_BUS_RTC>, <&dcxo24M>;
+			clock-names = "bus", "hosc";
+			#clock-cells = <1>;
+		};
+
 		r_ccu: clock@7010000 {
 			compatible = "allwinner,sun50i-a100-r-ccu";
 			reg = <0x07010000 0x300>;
-			clocks = <&dcxo24M>, <&osc32k>, <&iosc>,
+			clocks = <&dcxo24M>, <&rtc CLK_OSC32K>, <&rtc CLK_IOSC>,
 				 <&ccu CLK_PLL_PERIPH0>;
 			clock-names = "hosc", "losc", "iosc", "pll-periph";
 			#clock-cells = <1>;
@@ -618,7 +614,7 @@ r_pio: pinctrl@7022000 {
 			compatible = "allwinner,sun50i-a100-r-pinctrl";
 			reg = <0x07022000 0x400>;
 			interrupts = <GIC_SPI 111 IRQ_TYPE_LEVEL_HIGH>;
-			clocks = <&r_ccu CLK_R_APB1>, <&dcxo24M>, <&osc32k>;
+			clocks = <&r_ccu CLK_R_APB1>, <&dcxo24M>, <&rtc CLK_OSC32K>;
 			clock-names = "apb", "hosc", "losc";
 			gpio-controller;
 			#gpio-cells = <3>;
-- 
2.56.0

