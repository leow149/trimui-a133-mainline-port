From d2579a02d76d66074c10d9730d9c3a8f5a8189d8 Mon Sep 17 00:00:00 2001
From: leow149 <leow149@lucidmail.xyz>
Date: Mon, 2 Nov 2026 00:23:17 +0100
Subject: [PATCH 1/4] pvr: Support the v1 simple internal parameter format

The GE8300 (Series 8XE) uses version 1 of the simple internal parameter
format, but the macrotile setup and the ISP tile count alignment asserted
version 2. Like the vendor driver, use a single macrotile covering the
whole render target, and only align to 2x2 tile groups on version 2.

Signed-off-by: leow149 <leow149@lucidmail.xyz>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/imagination/include/hwdef/rogue_hw_utils.h |  7 +++----
 src/imagination/vulkan/pvr_arch_job_render.c   | 14 +++++++++++++-
 2 files changed, 16 insertions(+), 5 deletions(-)

diff --git a/src/imagination/include/hwdef/rogue_hw_utils.h b/src/imagination/include/hwdef/rogue_hw_utils.h
index a859059..892587e 100644
--- a/src/imagination/include/hwdef/rogue_hw_utils.h
+++ b/src/imagination/include/hwdef/rogue_hw_utils.h
@@ -154,10 +154,9 @@ rogue_get_isp_num_tiles_xy(const struct pvr_device_info *dev_info,
    *x_out = DIV_ROUND_UP(width * scale_x, tile_samples_x);
    *y_out = DIV_ROUND_UP(height * scale_y, tile_samples_y);
 
-   if (PVR_HAS_FEATURE(dev_info, simple_internal_parameter_format)) {
-      assert(PVR_GET_FEATURE_VALUE(dev_info,
-                                   simple_parameter_format_version,
-                                   0U) == 2U);
+   if (PVR_HAS_FEATURE(dev_info, simple_internal_parameter_format) &&
+       PVR_GET_FEATURE_VALUE(dev_info, simple_parameter_format_version, 0U) ==
+          2U) {
       /* Align to a 2x2 tile block. */
       *x_out = ALIGN_POT(*x_out, 2);
       *y_out = ALIGN_POT(*y_out, 2);
diff --git a/src/imagination/vulkan/pvr_arch_job_render.c b/src/imagination/vulkan/pvr_arch_job_render.c
index f1cc515..0b7f172 100644
--- a/src/imagination/vulkan/pvr_arch_job_render.c
+++ b/src/imagination/vulkan/pvr_arch_job_render.c
@@ -126,7 +126,19 @@ void pvr_arch_rt_mtile_info_init(const struct pvr_device_info *dev_info,
 
    rogue_get_num_macrotiles_xy(dev_info, &info->mtiles_x, &info->mtiles_y);
 
-   if (PVR_HAS_FEATURE(dev_info, simple_internal_parameter_format)) {
+   if (PVR_HAS_FEATURE(dev_info, simple_internal_parameter_format) &&
+       PVR_GET_FEATURE_VALUE(dev_info, simple_parameter_format_version, 0) ==
+          1) {
+      /* A single macrotile covering the whole render target. */
+      info->mtile_x1 = info->num_tiles_x;
+      info->mtile_y1 = info->num_tiles_y;
+      info->mtile_x2 = 0;
+      info->mtile_y2 = 0;
+      info->mtile_x3 = 0;
+      info->mtile_y3 = 0;
+      info->x_tile_max = info->num_tiles_x - 1;
+      info->y_tile_max = info->num_tiles_y - 1;
+   } else if (PVR_HAS_FEATURE(dev_info, simple_internal_parameter_format)) {
       assert(PVR_GET_FEATURE_VALUE(dev_info,
                                    simple_parameter_format_version,
                                    0) == 2);
-- 
