+/* Bounds the memory held by the cache: entries are only freed with the
+ * device, and the end of tile programs depend on render target addresses.
+ */
+#define PVR_PROG_CACHE_MAX_ENTRIES 256U
+
+struct pvr_prog_cache_key {
+   uint32_t size;
+   const void *data;
+};
+
+static uint32_t pvr_prog_cache_key_hash(const void *key)
+{
+   const struct pvr_prog_cache_key *k = key;
+
+   return _mesa_hash_data(k->data, k->size);
+}
+
+static bool pvr_prog_cache_key_equal(const void *a, const void *b)
+{
+   const struct pvr_prog_cache_key *ka = a;
+   const struct pvr_prog_cache_key *kb = b;
+
+   return ka->size == kb->size && !memcmp(ka->data, kb->data, ka->size);
+}
+
+uint32_t pvr_eot_cache_key(const struct pvr_eot_props *props,
+                           uint32_t kind,
+                           uint32_t key[static PVR_EOT_CACHE_KEY_MAX_DWORDS])
+{
+   uint32_t n = 0;
+
+   assert(!props->shared_words);
+   assert(props->emit_count <= PVR_MAX_COLOR_ATTACHMENTS);
+
+   key[n++] = kind;
+   key[n++] = props->emit_count;
+   key[n++] = props->num_output_regs;
+   key[n++] = props->msaa_samples;
+   for (unsigned u = 0; u < props->emit_count * ROGUE_NUM_PBESTATE_STATE_WORDS;
+        ++u) {
+      key[n++] = props->state_words[u];
+   }
+   for (unsigned u = 0; u < props->emit_count; ++u) {
+      key[n++] = props->tile_buffer_addrs[u];
+      key[n++] = props->tile_buffer_addrs[u] >> 32;
+   }
+
+   return n * sizeof(*key);
+}
+
+void pvr_device_prog_cache_init(struct pvr_device *device)
+{
+   simple_mtx_init(&device->prog_cache.mtx, mtx_plain);
+   device->prog_cache.load_ops = NULL;
+   device->prog_cache.eots = NULL;
+   device->prog_cache.render_targets = NULL;
+}
+
+void pvr_device_prog_cache_finish(struct pvr_device *device)
+{
+   simple_mtx_destroy(&device->prog_cache.mtx);
+
+   if (device->prog_cache.load_ops) {
+      hash_table_foreach (device->prog_cache.load_ops, entry) {
+         struct pvr_load_op_progs *progs = entry->data;
+
+         pvr_bo_suballoc_free(progs->pds_tex_state_prog.pvr_bo);
+         pvr_bo_suballoc_free(progs->pds_frag_prog.pvr_bo);
+         pvr_bo_suballoc_free(progs->usc_frag_prog_bo);
+         vk_free(&device->vk.alloc, progs);
+         vk_free(&device->vk.alloc, (void *)entry->key);
+      }
+      _mesa_hash_table_destroy(device->prog_cache.load_ops, NULL);
+   }
+
+   if (device->prog_cache.eots) {
+      hash_table_foreach (device->prog_cache.eots, entry) {
+         struct pvr_eot_prog *prog = entry->data;
+
+         pvr_bo_suballoc_free(prog->usc_bo);
+         vk_free(&device->vk.alloc, prog);
+         vk_free(&device->vk.alloc, (void *)entry->key);
+      }
+      _mesa_hash_table_destroy(device->prog_cache.eots, NULL);
+   }
+
+   if (device->prog_cache.render_targets) {
+      hash_table_foreach (device->prog_cache.render_targets, entry) {
+         struct pvr_cached_render_targets *rts = entry->data;
+
+         pvr_render_targets_fini(rts->render_targets, rts->count);
+         vk_free(&device->vk.alloc, rts->render_targets);
+         vk_free(&device->vk.alloc, rts);
+         vk_free(&device->vk.alloc, (void *)entry->key);
+      }
+      _mesa_hash_table_destroy(device->prog_cache.render_targets, NULL);
+   }
+}
+
+const void *pvr_device_prog_cache_lookup(struct hash_table *table,
+                                         const void *key,
+                                         uint32_t key_size)
+{
+   const struct pvr_prog_cache_key k = { .size = key_size, .data = key };
+   struct hash_entry *entry;
+
+   if (!table)
+      return NULL;
+
+   entry = _mesa_hash_table_search(table, &k);
+
+   return entry ? entry->data : NULL;
+}
+
+bool pvr_device_prog_cache_insert(struct pvr_device *device,
+                                  struct hash_table **table,
+                                  const void *key,
+                                  uint32_t key_size,
+                                  const void *progs,
+                                  size_t progs_size)
+{
+   struct pvr_prog_cache_key *k;
+   void *data;
+
+   if (!*table) {
+      *table = _mesa_hash_table_create(NULL,
+                                       pvr_prog_cache_key_hash,
+                                       pvr_prog_cache_key_equal);
+      if (!*table)
+         return false;
+   }
+
+   if ((*table)->entries >= PVR_PROG_CACHE_MAX_ENTRIES)
+      return false;
+
+   k = vk_alloc(&device->vk.alloc,
+                sizeof(*k) + key_size,
+                8,
+                VK_SYSTEM_ALLOCATION_SCOPE_DEVICE);
+   data = vk_alloc(&device->vk.alloc,
+                   progs_size,
+                   8,
+                   VK_SYSTEM_ALLOCATION_SCOPE_DEVICE);
+   if (!k || !data) {
+      vk_free(&device->vk.alloc, k);
+      vk_free(&device->vk.alloc, data);
+      return false;
+   }
+
+   /* The key data is stored right after the key. */
+   k->size = key_size;
+   k->data = memcpy(k + 1, key, key_size);
+   memcpy(data, progs, progs_size);
+
+   if (!_mesa_hash_table_insert(*table, k, data)) {
+      vk_free(&device->vk.alloc, k);
+      vk_free(&device->vk.alloc, data);
+      return false;
+   }
+
+   return true;
+}
