+/* Builds the cache key of a load op from what its programs are generated
+ * from: the clears/loads state and the render target resources it uses.
+ */
+static uint32_t pvr_load_op_cache_key(const struct pvr_load_op *load_op,
+                                      uint32_t *key)
+{
+   const struct usc_mrt_setup *mrt_setup =
+      load_op->clears_loads_state.mrt_setup;
+   const int32_t depth_idx = load_op->clears_loads_state.depth_clear_to_reg;
+   uint32_t rt_mask = load_op->clears_loads_state.rt_clear_mask |
+                      load_op->clears_loads_state.rt_load_mask;
+   uint32_t n = 0;
+
+   key[n++] = load_op->clears_loads_state.rt_clear_mask;
+   key[n++] = load_op->clears_loads_state.rt_load_mask;
+   key[n++] = load_op->clears_loads_state.rt_2d_view_3d_mask;
+   key[n++] = load_op->clears_loads_state.unresolved_msaa_mask;
+   key[n++] = depth_idx;
+
+   if (depth_idx != PVR_NO_DEPTH_CLEAR_TO_REG)
+      rt_mask |= BITFIELD_BIT(depth_idx);
+
+   u_foreach_bit (rt_idx, rt_mask) {
+      const struct usc_mrt_resource *res = &mrt_setup->mrt_resources[rt_idx];
+      const bool reg = res->type == USC_MRT_RESOURCE_TYPE_OUTPUT_REG;
+
+      key[n++] = rt_idx;
+      key[n++] = load_op->clears_loads_state.dest_vk_format[rt_idx];
+      key[n++] = res->type;
+      key[n++] = res->intermediate_size;
+      key[n++] = reg ? res->reg.output_reg : res->mem.tile_buffer;
+      key[n++] = reg ? res->reg.offset : res->mem.offset_dw;
+   }
+
+   return n * sizeof(*key);
+}
+
+#define PVR_LOAD_OP_CACHE_KEY_MAX_DWORDS (5U + 6U * 32U)
+
+static void pvr_load_op_progs_get(struct pvr_load_op *load_op,
+                                  struct pvr_load_op_progs *progs)
+{
+   *progs = (struct pvr_load_op_progs){
+      .usc_frag_prog_bo = load_op->usc_frag_prog_bo,
+      .pds_frag_prog = load_op->pds_frag_prog,
+      .pds_tex_state_prog = load_op->pds_tex_state_prog,
+      .temps_count = load_op->temps_count,
+      .num_tile_buffers = load_op->num_tile_buffers,
+      .const_shareds_count = load_op->const_shareds_count,
+      .shareds_count = load_op->shareds_count,
+   };
+}
+
+static void pvr_load_op_progs_set(struct pvr_load_op *load_op,
+                                  const struct pvr_load_op_progs *progs)
+{
+   load_op->usc_frag_prog_bo = progs->usc_frag_prog_bo;
+   load_op->pds_frag_prog = progs->pds_frag_prog;
+   load_op->pds_tex_state_prog = progs->pds_tex_state_prog;
+   load_op->temps_count = progs->temps_count;
+   load_op->num_tile_buffers = progs->num_tile_buffers;
+   load_op->const_shareds_count = progs->const_shareds_count;
+   load_op->shareds_count = progs->shareds_count;
+   load_op->progs_cached = true;
+}
+
+/* With dynamic rendering the load ops are set up again for every render, so
+ * take their programs from the device's cache instead of generating them
+ * each time.
+ */
+static VkResult pvr_load_op_shader_get(struct pvr_device *device,
+                                       const VkAllocationCallbacks *alloc,
+                                       struct pvr_load_op *load_op)
+{
+   uint32_t key[PVR_LOAD_OP_CACHE_KEY_MAX_DWORDS];
+   const struct pvr_load_op_progs *cached;
+   struct pvr_load_op_progs progs;
+   uint32_t key_size;
+   VkResult result;
+
+   assert(util_bitcount(load_op->clears_loads_state.rt_clear_mask |
+                        load_op->clears_loads_state.rt_load_mask) + 1U <=
+          32U);
+   key_size = pvr_load_op_cache_key(load_op, key);
+
+   simple_mtx_lock(&device->prog_cache.mtx);
+
+   cached = pvr_device_prog_cache_lookup(device->prog_cache.load_ops,
+                                         key,
+                                         key_size);
+   if (cached) {
+      pvr_load_op_progs_set(load_op, cached);
+      simple_mtx_unlock(&device->prog_cache.mtx);
+      return VK_SUCCESS;
+   }
+
+   result = pvr_arch_load_op_shader_generate(device, alloc, load_op);
+   if (result == VK_SUCCESS) {
+      pvr_load_op_progs_get(load_op, &progs);
+      if (pvr_device_prog_cache_insert(device,
+                                       &device->prog_cache.load_ops,
+                                       key,
+                                       key_size,
+                                       &progs,
+                                       sizeof(progs))) {
+         load_op->progs_cached = true;
+      }
+   }
+
+   simple_mtx_unlock(&device->prog_cache.mtx);
+
+   return result;
+}
+
 static VkResult pvr_mrt_load_op_init(struct pvr_device *device,
                                      const VkAllocationCallbacks *alloc,
                                      const struct pvr_render_pass_info *rp_info,
@@ -345,7 +459,7 @@ static VkResult pvr_mrt_load_op_init(struct pvr_device *device,
 
    load_op->clears_loads_state.mrt_setup = &dr_info->hw_render.init_setup;
 
-   result = pvr_arch_load_op_shader_generate(device, alloc, load_op);
+   result = pvr_load_op_shader_get(device, alloc, load_op);
    if (result != VK_SUCCESS) {
       vk_free2(&device->vk.alloc, alloc, load_op);
       return result;
@@ -362,6 +476,9 @@ static VkResult pvr_mrt_load_op_init(struct pvr_device *device,
 
 static void pvr_load_op_fini(struct pvr_load_op *load_op)
 {
+   if (load_op->progs_cached)
+      return;
+
    pvr_bo_suballoc_free(load_op->pds_tex_state_prog.pvr_bo);
    pvr_bo_suballoc_free(load_op->pds_frag_prog.pvr_bo);
    pvr_bo_suballoc_free(load_op->usc_frag_prog_bo);
