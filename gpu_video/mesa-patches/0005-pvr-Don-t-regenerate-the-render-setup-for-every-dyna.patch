+   rstate->render_targets_cached = false;
+
+   /* Dynamic renders of the same size share their render targets (and with
+    * them the RT datasets, which are expensive to create), as the renders of
+    * a framebuffer do.
+    */
+   if (cache_render_targets) {
+      struct pvr_render_target *cached =
+         pvr_render_targets_cache_get(device, rstate, render_targets_count);
+
+      if (cached) {
+         rstate->render_targets = cached;
+         rstate->render_targets_cached = true;
+      }
+   }
+
+   if (!rstate->render_targets_cached &&
+       !pvr_render_targets_init(rstate->render_targets, render_targets_count)) {
       result = vk_error(device, VK_ERROR_OUT_OF_HOST_MEMORY);
       goto err_free_render_targets;
    }
@@ -195,10 +272,11 @@ err_release_scratch_buffer:
    pvr_spm_scratch_buffer_release(device, rstate->scratch_buffer);
 
 err_finish_render_targets:
-   pvr_render_targets_fini(rstate->render_targets, render_targets_count);
+   if (!rstate->render_targets_cached)
+      pvr_render_targets_fini(rstate->render_targets, render_targets_count);
 
 err_free_render_targets:
-   vk_free2(&device->vk.alloc, pAllocator, rstate->render_targets);
+   vk_free2(&device->vk.alloc, pAllocator, rstate->mem);
 
    return result;
 }
