+/* Returns the device's render targets for renders of rstate's size, creating
+ * them when needed, or NULL when the cache is full.
+ */
+static struct pvr_render_target *
+pvr_render_targets_cache_get(struct pvr_device *device,
+                             const struct pvr_render_state *rstate,
+                             uint32_t render_targets_count)
+{
+   const uint32_t key[] = { rstate->width, rstate->height, rstate->layers };
+   const struct pvr_cached_render_targets *cached;
+   struct pvr_cached_render_targets rts = {
+      .count = render_targets_count,
+   };
+
+   simple_mtx_lock(&device->prog_cache.mtx);
+
+   cached = pvr_device_prog_cache_lookup(device->prog_cache.render_targets,
+                                         key,
+                                         sizeof(key));
+   if (cached) {
+      simple_mtx_unlock(&device->prog_cache.mtx);
+      return cached->render_targets;
+   }
+
+   rts.render_targets = vk_zalloc(&device->vk.alloc,
+                                  sizeof(*rts.render_targets) *
+                                     render_targets_count,
+                                  8,
+                                  VK_SYSTEM_ALLOCATION_SCOPE_DEVICE);
+   if (!rts.render_targets)
+      goto err_unlock;
+
+   if (!pvr_render_targets_init(rts.render_targets, render_targets_count))
+      goto err_free_render_targets;
+
+   if (!pvr_device_prog_cache_insert(device,
+                                     &device->prog_cache.render_targets,
+                                     key,
+                                     sizeof(key),
+                                     &rts,
+                                     sizeof(rts))) {
+      pvr_render_targets_fini(rts.render_targets, render_targets_count);
+      goto err_free_render_targets;
+   }
+
+   simple_mtx_unlock(&device->prog_cache.mtx);
+
+   return rts.render_targets;
+
+err_free_render_targets:
+   vk_free(&device->vk.alloc, rts.render_targets);
+
+err_unlock:
+   simple_mtx_unlock(&device->prog_cache.mtx);
+
+   return NULL;
+}
