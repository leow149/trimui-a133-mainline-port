+/* Programs of a load op, see pvr_load_op. */
+struct pvr_load_op_progs {
+   struct pvr_suballoc_bo *usc_frag_prog_bo;
+   struct pvr_pds_upload pds_frag_prog;
+   struct pvr_pds_upload pds_tex_state_prog;
+   uint32_t temps_count;
+   uint32_t num_tile_buffers;
+   uint32_t const_shareds_count;
+   uint32_t shareds_count;
+};
+
+/* Render targets (RT datasets) shared by the dynamic renders of a size, like
+ * the renders of a framebuffer share them.
+ */
+struct pvr_cached_render_targets {
+   struct pvr_render_target *render_targets;
+   uint32_t count;
+};
+
+/* End of tile USC program. */
+struct pvr_eot_prog {
+   struct pvr_suballoc_bo *usc_bo;
+   uint32_t temps_count;
+};
