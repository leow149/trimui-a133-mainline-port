diff --git a/drivers/media/platform/verisilicon/hantro_g2_vp9_dec.c b/drivers/media/platform/verisilicon/hantro_g2_vp9_dec.c
index 56c79e339..2504f061e 100644
--- a/drivers/media/platform/verisilicon/hantro_g2_vp9_dec.c
+++ b/drivers/media/platform/verisilicon/hantro_g2_vp9_dec.c
@@ -4,6 +4,8 @@
  *
  * Copyright (C) 2021 Collabora Ltd.
  */
+#include <linux/delay.h>
+#include <linux/io.h>
 #include "media/videobuf2-core.h"
 #include "media/videobuf2-dma-contig.h"
 #include "media/videobuf2-v4l2.h"
@@ -906,7 +908,19 @@ int hantro_g2_vp9_dec_run(struct hantro_ctx *ctx)
 
 	hantro_end_prepare_run(ctx);
 
+	{ void __iomem *v = ioremap(0x1c00000, 0x10000);
+	  u32 old = readl(v + 0xe000); int m, w;
+	  for (w = 0; w < 1024; w++) if (readl(v + 0xe000 + w*4)) dev_info(ctx->dev->dev, "DBG ve[%03x]=%08x\n", w*4, readl(v + 0xe000 + w*4));
+	  for (m = 0; m < 8; m++) {
+		writel((old & ~7) | m, v + 0xe000); udelay(50);
+		dev_info(ctx->dev->dev, "DBG vemode %d -> %08x g2[0]=%08x g2[4]=%08x\n", m, readl(v + 0xe000), readl(v), readl(v + 4)); }
+	  writel(old, v + 0xe000);
+	  iounmap(v); }
+	{ int i; for (i = 0; i < 0x20; i += 4)
+		dev_info(ctx->dev->dev, "DBG pre  r%02d: %08x %08x %08x %08x\n", i, vdpu_read(ctx->dev, i*4), vdpu_read(ctx->dev, i*4+4), vdpu_read(ctx->dev, i*4+8), vdpu_read(ctx->dev, i*4+12)); }
 	vdpu_write(ctx->dev, G2_REG_INTERRUPT_DEC_E, G2_REG_INTERRUPT);
+	udelay(100);
+	dev_info(ctx->dev->dev, "DBG post start int=%08x\n", vdpu_read(ctx->dev, G2_REG_INTERRUPT));
 
 	return 0;
 }
