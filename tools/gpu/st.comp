#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba8) uniform writeonly image2D img;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2DArray arr;
layout(set = 0, binding = 2) uniform U { vec4 v[64]; } u;
void main()
{
	ivec2 p = ivec2(gl_GlobalInvocationID.xy);
	imageStore(img, p, u.v[p.x & 63] + u.v[3]);
	imageStore(arr, ivec3(p, 1), vec4(0.0, 1.0, 0.0, 1.0));
}
