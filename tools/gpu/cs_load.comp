#version 450
// diagnostic: imageLoad of the CPU-... (image is zero/unwritten): just checks load executes; writes loaded+id into SSBO
layout(local_size_x = 16, local_size_y = 8) in;
layout(set = 0, binding = 3, r32ui) uniform uimage2D uImage;
layout(set = 0, binding = 4, std430) buffer SSBO { uint words[]; };
layout(set = 0, binding = 0, std140) uniform UBO { uvec2 resolution; uint word_stride; };
void main()
{
	uvec2 p = gl_GlobalInvocationID.xy;
	if (all(lessThan(p, resolution))) {
		imageAtomicExchange(uImage, ivec2(p), p.y * 256u + p.x + 1u);
		memoryBarrierImage();
		words[p.y * resolution.x + p.x] = imageLoad(uImage, ivec2(p)).x;
	}
}
