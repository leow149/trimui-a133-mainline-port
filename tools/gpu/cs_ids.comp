#version 450
// diagnostic: every invocation writes its linear id+1 to the SSBO and a coordinate-coded colour to the image
layout(local_size_x = 16, local_size_y = 8) in;
layout(set = 0, binding = 3, rgba8) writeonly uniform image2D uImage;
layout(set = 0, binding = 4, std430) buffer SSBO { uint words[]; };
layout(set = 0, binding = 0, std140) uniform UBO { uvec2 resolution; uint word_stride; };
void main()
{
	uvec2 p = gl_GlobalInvocationID.xy;
	if (all(lessThan(p, resolution))) {
		words[p.y * resolution.x + p.x] = p.y * resolution.x + p.x + 1u;
		imageStore(uImage, ivec2(p), vec4(float(p.x & 255u) / 255.0, float(p.y & 255u) / 255.0, 0.5, 1.0));
	}
}
